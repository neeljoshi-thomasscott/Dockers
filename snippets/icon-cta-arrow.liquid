{% doc %}
  CTA Arrow Icon

  Small thin right-pointing arrow used as the default icon in collection
  banner CTA pills when no custom icon is picked.

  @param {string} [class] - CSS classes
  @param {number} [size] - Icon width/height in px (default: 16)

  @example
  {% render 'icon-cta-arrow', class: 'h-4 w-4' %}
{% enddoc %}

{%- assign icon_size = size | default: 16 -%}
<svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 12 12" fill="none" aria-hidden="true">
  <path d="M8.0875 6.5H2V5.5H8.0875L5.2875 2.7L6 2L10 6L6 10L5.2875 9.3L8.0875 6.5Z" fill="currentColor"/>
</svg>
