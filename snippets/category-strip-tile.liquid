{% doc %}
  Renders a single category strip tile.

  @param {object} block - The `tile` block object
{% enddoc %}

{%- liquid
  assign tile_link = block.settings.link
  assign tile_label = block.settings.label
-%}

<div class="category-strip__tile flex-1 min-w-0" {{ block.shopify_attributes }}>
  {%- if tile_link != blank -%}
    <a href="{{ tile_link }}" class="category-strip__card block h-full">
  {%- else -%}
    <div class="category-strip__card h-full">
  {%- endif -%}

    <div class="category-strip__image h-category-strip-image-height-mobile lg:h-category-strip-image-height-desktop overflow-hidden">
      {%- if block.settings.image == blank and request.design_mode -%}
        <div class="flex h-full w-full items-center justify-center border border-dashed border-border bg-background-alt text-meta text-muted">
          Select an image
        </div>
      {%- else -%}
        {%- render 'image',
          image: block.settings.image,
          mobile_image: block.settings.mobile_image,
          class_name: 'h-full w-full object-cover',
          lazy: true,
          alt: tile_label,
          width: 540,
          height: 810
        -%}
      {%- endif -%}
    </div>
    <div class="category-strip__label-bar h-category-strip-label-height-mobile lg:h-category-strip-label-height-desktop bg-ink flex pt-category-strip-label-pad-top-mobile pb-category-strip-label-pad-bottom-mobile px-page-gutter-mobile lg:items-center lg:pt-4 lg:pb-8 lg:px-page-gutter-desktop">
      <span class="category-strip__label block w-full truncate text-left text-label lg:text-card-label font-primary text-surface">{{ tile_label | escape }}</span>
    </div>

  {%- if tile_link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>
