{% doc %}
  Collection Banner Slide

  Renders a single collection-banner slide: the media (desktop/mobile
  image) plus the optional CTA pill. When cta_link is set the whole image
  links there too (hidden from assistive tech; the CTA is the real link). Shared by the legacy 0/1-block
  paths and the multi-slide carousel path in collection-banner.liquid
  so all three render identical markup.

  @param {image} image - Desktop image object
  @param {image} [mobile_image] - Mobile image object, falls back to image
  @param {string} [alt] - Alt text
  @param {string} [cta_position] - One of: top-left, top-right, middle-left, middle-right, bottom-left, bottom-right
  @param {string} [cta_label] - CTA label text
  @param {string} [cta_link] - CTA URL
  @param {image} [cta_icon] - Optional custom CTA icon; falls back to icon-cta-arrow when blank
  @param {boolean} [lazy] - Passed through to the image snippet (default: true)

  @example
  {% render 'collection-banner-slide', image: section.settings.image, alt: banner_alt, cta_position: section.settings.cta_position, cta_label: section.settings.cta_label, cta_link: section.settings.cta_link, cta_icon: section.settings.cta_icon, lazy: banner_lazy %}
{% enddoc %}

{%- liquid
  assign slide_lazy = true
  if lazy == false
    assign slide_lazy = false
  endif
  assign position_classes = ''
  case cta_position
    when 'top-left'
      assign position_classes = 'top-banner-inset-vertical left-banner-inset'
    when 'top-right'
      assign position_classes = 'top-banner-inset-vertical right-banner-inset'
    when 'middle-left'
      assign position_classes = 'top-1/2 -translate-y-1/2 left-banner-inset'
    when 'middle-right'
      assign position_classes = 'top-1/2 -translate-y-1/2 right-banner-inset'
    when 'bottom-left'
      assign position_classes = 'bottom-banner-inset-vertical left-banner-inset'
    when 'bottom-right'
      assign position_classes = 'bottom-banner-inset-vertical right-banner-inset'
  endcase
-%}
{%- if cta_link != blank -%}
  <a href="{{ cta_link }}" class="collection-banner__media absolute inset-0 block" tabindex="-1" aria-hidden="true">
{%- else -%}
  <div class="collection-banner__media absolute inset-0">
{%- endif -%}
  {%- if image == blank and request.design_mode -%}
    <div class="flex h-full w-full items-center justify-center border border-dashed border-border bg-background-alt text-meta text-muted">
      Select an image
    </div>
  {%- else -%}
    {%- render 'image',
      image: image,
      mobile_image: mobile_image,
      class_name: 'h-full w-full object-cover',
      lazy: slide_lazy,
      alt: alt,
      quality: 85,
      srcset_widths: '1440,2160,3000',
      mobile_srcset_widths: '750,1200,1500',
      width: 1440,
      height: 800
    -%}
  {%- endif -%}
{%- if cta_link != blank -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}

{%- if cta_label != blank or cta_link != blank -%}
  {%- assign cta_classes = 'collection-banner__cta absolute inline-flex items-center bg-ink text-surface gap-cta-gap px-cta-pad-x py-cta-pad-y ' | append: position_classes -%}
  {%- if cta_link != blank -%}
    <a href="{{ cta_link }}" class="{{ cta_classes }}">
  {%- else -%}
    <div class="{{ cta_classes }}">
  {%- endif -%}
    <span class="collection-banner__cta-icon">
      {%- if cta_icon != blank -%}
        <img src="{{ cta_icon | image_url: width: 24 }}" alt="" width="12" height="12" loading="lazy" class="h-2.5 w-2.5 md:h-3 md:w-3">
      {%- else -%}
        {%- render 'icon-cta-arrow', class: 'h-2.5 w-2.5 md:h-3 md:w-3' -%}
      {%- endif -%}
    </span>
    <span class="collection-banner__cta-label font-secondary text-sm font-normal leading-5 tracking-[0.02em] text-surface uppercase md:text-base md:leading-6">{{ cta_label | escape }}</span>
  {%- if cta_link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
{%- endif -%}
