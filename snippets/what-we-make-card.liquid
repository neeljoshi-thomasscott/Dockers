{% doc %}
  Renders a single What We Make card: image, title and body.

  @param {block} block - What We Make Card block

  @example
  {% render 'what-we-make-card', block: block %}
{% enddoc %}

{%- liquid
  assign what_we_make_card_image = block.settings.what_we_make_image
  assign what_we_make_card_title = block.settings.what_we_make_title
  assign what_we_make_card_body = block.settings.what_we_make_body
  assign what_we_make_card_mob_pos = block.settings.what_we_make_mob_pos

  capture what_we_make_card_position_class
    render 'object-position-class', position: what_we_make_card_mob_pos
  endcapture
  assign what_we_make_card_media_class = 'about-what-we-make__media block h-about-what-we-make-media-height-mobile w-full object-cover ' | append: what_we_make_card_position_class | append: ' md:aspect-about-what-we-make-media md:h-auto md:object-center'
-%}

{%- if what_we_make_card_image != blank or what_we_make_card_title != blank or what_we_make_card_body != blank -%}
  <li
    class="about-what-we-make__card flex flex-col gap-about-what-we-make-card-gap-mobile md:w-about-what-we-make-card-width-desktop md:min-w-0 md:gap-about-what-we-make-card-gap-desktop"
    {{ block.shopify_attributes }}
  >
    {%- if what_we_make_card_image != blank -%}
      {%- render 'image',
        image: what_we_make_card_image,
        alt: block.settings.what_we_make_img_alt,
        class_name: what_we_make_card_media_class,
        responsive_widths: '0:720,768:1080'
      -%}
    {%- endif -%}

    {%- if what_we_make_card_title != blank -%}
      <h3 class="about-what-we-make__title break-words font-primary text-about-what-we-make-title font-bold text-ink">
        {{ what_we_make_card_title | escape }}
      </h3>
    {%- endif -%}

    {%- if what_we_make_card_body != blank -%}
      <p class="about-what-we-make__body break-words font-primary text-about-what-we-make-body font-normal text-about-body-ink/80 md:text-ink-80">
        {{ what_we_make_card_body | escape | newline_to_br }}
      </p>
    {%- endif -%}
  </li>
{%- endif -%}
