{% doc %}
  Mega Menu Editor Notice

  Theme-editor-only list of Nav Tab and Nav Banner blocks that will not show up
  in the mega menu (a title that matches no menu tab or category, a block aimed
  at Home, a duplicate Nav Tab, or a banner without an image), so mistakes are
  caught instead of failing silently. Follows the same rules as
  mega-menu-tab-state: the first Nav Tab block for a tab wins.
  Render only when request.design_mode is true.

  @param {string} main_menu - Handle of the top-level link_list (header_main_menu setting)
  @param {block[]} blocks - section.blocks, filtered internally by type

  @example
  {% render 'mega-menu-editor-notice', main_menu: section.settings.header_main_menu, blocks: section.blocks %}
{% enddoc %}

{%- liquid
  assign notice_nav_tab_blocks = blocks | where: 'type', 'nav-tab'
  assign notice_banner_blocks = blocks | where: 'type', 'nav-banner'

  assign notice_tab_keys = '|'
  for notice_tab_link in linklists[main_menu].links
    assign notice_tab_link_key = notice_tab_link.title | strip | downcase
    assign notice_tab_keys = notice_tab_keys | append: notice_tab_link_key | append: '|'
  endfor

  capture notice_items
    assign notice_seen_tab_keys = '|'
    for notice_block in notice_nav_tab_blocks
      assign notice_block_tab = notice_block.settings.tab_title | strip
      assign notice_block_tab_key = notice_block_tab | downcase
      assign notice_block_tab_needle = '|' | append: notice_block_tab_key | append: '|'

      if notice_block_tab_key == 'home'
        echo '<li>'
        echo 'mega_menu.editor_tab_home' | t: tab: notice_block_tab
        echo '</li>'
      elsif notice_tab_keys contains notice_block_tab_needle
        if notice_seen_tab_keys contains notice_block_tab_needle
          echo '<li>'
          echo 'mega_menu.editor_tab_duplicate' | t: tab: notice_block_tab
          echo '</li>'
        endif
      else
        echo '<li>'
        echo 'mega_menu.editor_tab_unmatched' | t: tab: notice_block_tab
        echo '</li>'
      endif

      assign notice_seen_tab_keys = notice_seen_tab_keys | append: notice_block_tab_key | append: '|'
    endfor

    for notice_block in notice_banner_blocks
      assign notice_banner_tab = notice_block.settings.banner_tab | strip
      assign notice_banner_tab_key = notice_banner_tab | downcase
      assign notice_banner_tab_needle = '|' | append: notice_banner_tab_key | append: '|'
      assign notice_banner_category = notice_block.settings.banner_cat | strip
      assign notice_banner_category_key = notice_banner_category | downcase

      assign notice_banner_target = notice_banner_tab
      if notice_banner_category != blank
        assign notice_banner_target = notice_banner_target | append: ' › ' | append: notice_banner_category
      endif
      assign notice_banner_position = forloop.index

      if notice_banner_tab == blank
        echo '<li>'
        echo 'mega_menu.editor_banner_no_tab' | t: position: notice_banner_position, target: notice_banner_target
        echo '</li>'
      elsif notice_banner_tab_key == 'home'
        echo '<li>'
        echo 'mega_menu.editor_banner_home' | t: position: notice_banner_position, target: notice_banner_target
        echo '</li>'
      elsif notice_tab_keys contains notice_banner_tab_needle
        if notice_banner_category != blank
          assign notice_category_keys = '|'
          for notice_tab_block in notice_nav_tab_blocks
            assign notice_tab_block_key = notice_tab_block.settings.tab_title | strip | downcase
            if notice_tab_block_key == notice_banner_tab_key
              for notice_category_link in linklists[notice_tab_block.settings.tab_cat_menu].links
                assign notice_category_link_key = notice_category_link.title | strip | downcase
                assign notice_category_keys = notice_category_keys | append: notice_category_link_key | append: '|'
              endfor
              break
            endif
          endfor

          assign notice_banner_category_needle = '|' | append: notice_banner_category_key | append: '|'
          unless notice_category_keys contains notice_banner_category_needle
            echo '<li>'
            echo 'mega_menu.editor_banner_cat_unmatched' | t: position: notice_banner_position, target: notice_banner_target, tab: notice_banner_tab, category: notice_banner_category
            echo '</li>'
          endunless
        endif
      else
        echo '<li>'
        echo 'mega_menu.editor_banner_tab_unmatched' | t: position: notice_banner_position, target: notice_banner_target, tab: notice_banner_tab
        echo '</li>'
      endif

      if notice_block.settings.banner_img == blank
        echo '<li>'
        echo 'mega_menu.editor_banner_no_image' | t: position: notice_banner_position, target: notice_banner_target
        echo '</li>'
      endif
    endfor
  endcapture
-%}

{%- if notice_items != blank -%}
  <div class="mega-menu-editor-notice fixed bottom-4 left-4 z-50 max-w-md border border-warning bg-surface p-4 font-primary text-sm text-ink shadow-sticky" role="status">
    <p class="mb-2 font-medium">{{ 'mega_menu.editor_notice_title' | t }}</p>
    <ul class="list-disc space-y-1 pl-5">
      {{ notice_items }}
    </ul>
  </div>
{%- endif -%}
