{% doc %}
  Mobile Header

  Renders the mobile header with logo and action icons.
  Visible on mobile only (lg:hidden).

  On a PDP with product media, the header overlays the hero image transparently at the
  top of the page and switches to the normal solid appearance once the
  page scrolls (see assets/header-scroll.js, which toggles `is-scrolled`
  on the parent #main-header). Everywhere else this renders exactly as
  it always has.

  @param {boolean} [overlay_header] - Render the transparent overlay variant (white logo/icons until scrolled); resolved once in sections/header.liquid (default: false)
{% enddoc %}

{%- liquid
  assign overlay_header = overlay_header | default: false

  assign icon_color_classes = 'text-foreground'
  if overlay_header
    assign icon_color_classes = 'text-white group-[.is-scrolled]:text-foreground'
  endif
-%}

<div class="menu-mobile lg:hidden flex items-center justify-between h-header-height-mobile">
  <a
    href="{{ routes.root_url }}"
    class="py-4 pl-header-edge-pad pr-header-logo-gap"
    aria-label="{{ shop.name | escape }} - Home"
  >
    {%- if overlay_header and settings.logo_white != blank -%}
      <img
        src="{{ settings.logo_white | image_url: width: 218 }}"
        alt="{{ shop.name | escape }}"
        width="109"
        height="32"
        loading="eager"
        class="block group-[.is-scrolled]:hidden"
      >
      <img
        src="{{ settings.logo | image_url: width: 218 }}"
        alt="{{ shop.name | escape }}"
        width="109"
        height="32"
        loading="eager"
        class="hidden group-[.is-scrolled]:block"
      >
    {%- elsif settings.logo != blank -%}
      <img
        src="{{ settings.logo | image_url: width: 218 }}"
        alt="{{ shop.name | escape }}"
        width="109"
        height="32"
        loading="eager"
      >
    {%- else -%}
      <span class="font-primary text-lg font-normal tracking-tight">{{ shop.name | escape }}</span>
    {%- endif -%}
  </a>

  <div class="flex items-center gap-header-icon-gap pr-header-edge-pad">
    <button
      type="button"
      class="w-header-icon-tap h-header-icon-tap flex items-center justify-center {{ icon_color_classes }}"
      aria-label="Search"
      data-search-drawer-trigger
    >
      {% render 'icon-search', size: 20 %}
    </button>

    <a
      href="{{ routes.account_url }}"
      class="w-header-icon-tap h-header-icon-tap flex items-center justify-center {{ icon_color_classes }}"
      aria-label="Account"
    >
      {% render 'icon-account', size: 20 %}
    </a>
{% comment %} flits support removed thrid party wishlist code from here {% endcomment %}
    {% comment %} <button
      type="button"
      class="w-header-icon-tap h-header-icon-tap flex items-center justify-center {{ icon_color_classes }}"
      aria-label="Wishlist"
    >
      {% render 'icon-wishlist', size: 20 %}
    </button> {% endcomment %}
{% comment %} till here {% endcomment %}
    <a
      href="{{ routes.cart_url }}"
      class="relative w-header-icon-tap h-header-icon-tap flex items-center justify-center {{ icon_color_classes }}"
      aria-label="Cart"
    >
      {% render 'icon-cart', size: 20 %}
      <cart-count
        class="absolute left-1/2 top-1/2 -mt-4 h-4 min-w-4 items-center justify-center rounded-full bg-black px-1 text-[10px] font-medium leading-none text-white ring-1 ring-white {% if cart.item_count > 0 %}flex{% else %}hidden{% endif %}"
        aria-hidden="true"
      >
        {{- cart.item_count | at_most: 99 -}}
      </cart-count>
    </a>

    <button
      type="button"
      class="w-header-icon-tap h-header-icon-tap flex items-center justify-center {{ icon_color_classes }}"
      aria-label="{{ 'accessibility.menu' | t }}"
      aria-expanded="false"
      aria-controls="mega-menu-drawer"
      data-mega-menu-open
    >
      <span class="block group-[.is-menu-open]:hidden">
        {% render 'icon-hamburger', size: 20 %}
      </span>
      <span class="hidden group-[.is-menu-open]:block">
        {% render 'icon-close', size: 20 %}
      </span>
    </button>
  </div>
</div>
