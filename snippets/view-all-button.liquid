{% doc %}
  View All Button

  Renders a fixed-size "View All" style button centered inside a full-width
  bar. When `url` is provided, renders as a link (`<a>`); otherwise renders
  a non-interactive `<div>` with identical visual classes. Two color
  variants match the button to light or dark section backgrounds.

  @param {string} label - Button's visible text
  @param {string} [url] - Link destination. When blank, renders a `<div>` instead of `<a>`
  @param {string} [variant] - "light" = dark button for light sections (default), "dark" = white button for dark sections

  @example
  {% render 'view-all-button', label: 'View All', url: collection.url, variant: 'light' %}
{% enddoc %}

{%- liquid
  assign variant = variant | default: 'light'
  assign button_classes = 'inline-flex w-full lg:w-view-all-width h-12 items-center justify-center py-3 px-5 font-plex-mono text-card-label uppercase'
  assign bar_classes = 'flex w-full items-center justify-center px-10'

  if variant == 'dark'
    assign button_classes = button_classes | append: ' bg-surface text-ink'
    assign bar_classes = bar_classes | append: ' pt-5 pb-shop-category-view-all-pad-bottom-mobile lg:pb-shop-category-view-all-pad-bottom-desktop'
  else
    assign button_classes = button_classes | append: ' bg-ink text-surface'
    assign bar_classes = bar_classes | append: ' pt-5 pb-8'
  endif
-%}

<div class="{{ bar_classes }}">
  {%- if url != blank -%}
    <a href="{{ url }}" class="{{ button_classes }}">{{ label | escape }}</a>
  {%- else -%}
    <div class="{{ button_classes }}">{{ label | escape }}</div>
  {%- endif -%}
</div>
