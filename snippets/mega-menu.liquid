{% doc %}
  Mega Menu

  Desktop hover-flyout + mobile drill-down drawer for the header's top-level
  navigation. `main_menu` supplies the tabs, `info_menu` supplies the shared
  Group 3 links, `nav-tab` blocks supply each tab's Group 1/Group 2 menus, and
  `nav-banner` blocks supply the banners of each tab and category. Blocks are
  matched to menu link titles case- and whitespace-insensitively.

  @param {string} main_menu - Handle of the top-level link_list (header_main_menu setting)
  @param {string} info_menu - Handle of the shared Group 3 link_list (header_info_menu setting), may be blank
  @param {block[]} blocks - section.blocks, filtered internally by type
{% enddoc %}

{%- liquid
  assign nav_tab_blocks = blocks | where: 'type', 'nav-tab'
  assign banner_blocks = blocks | where: 'type', 'nav-banner'
  assign info_links = linklists[info_menu].links

  capture tab_state_list
    render 'mega-menu-tab-state', main_menu: main_menu, info_menu: info_menu, blocks: blocks
  endcapture
  assign tab_states = tab_state_list | strip | split: ','

  assign tab_block_index_list = ''
  assign tab_has_content_list = ''
  assign initial_tab_index = nil
  assign initial_tab_fallback_index = nil
  for tab_link in linklists[main_menu].links
    assign tab_state = tab_states[forloop.index0] | split: ':'
    assign tab_block_index_list = tab_block_index_list | append: tab_state[0] | append: ','
    assign tab_has_content_list = tab_has_content_list | append: tab_state[1] | append: ','

    if tab_state[1] == 'true'
      if initial_tab_fallback_index == nil
        assign initial_tab_fallback_index = forloop.index0
      endif
      if tab_link.current
        assign initial_tab_index = forloop.index0
      endif
    endif
  endfor
  if initial_tab_index == nil
    assign initial_tab_index = initial_tab_fallback_index
  endif

  assign tab_block_indexes = tab_block_index_list | split: ','
  assign tab_has_content_flags = tab_has_content_list | split: ','
-%}

<mega-menu>
  <div
    class="mega-menu__scrim fixed inset-x-0 bottom-0 top-[var(--mega-menu-header-bottom,0px)] z-40 hidden lg:block bg-black/0 opacity-0 pointer-events-none transition-opacity duration-200"
    data-mega-menu-scrim
  ></div>

  <div class="hidden lg:block" data-mega-menu-desktop>
    {%- if linklists[main_menu].links.size > 0 -%}
      {%- for tab_link in linklists[main_menu].links -%}
        {%- liquid
          assign tab_index = forloop.index0
          assign tab_block_index = tab_block_indexes[tab_index] | plus: 0
          assign tab_block = nil
          if tab_block_index >= 0
            assign tab_block = nav_tab_blocks[tab_block_index]
          endif
          assign tab_has_content = false
          if tab_has_content_flags[tab_index] == 'true'
            assign tab_has_content = true
          endif
        -%}

        {%- if tab_has_content -%}
          {%- liquid
            assign featured_links = linklists[tab_block.settings.tab_feat_menu].links
            assign category_links = linklists[tab_block.settings.tab_cat_menu].links

            capture tab_banners_markup
              render 'mega-menu-banners', banner_blocks: banner_blocks, tab_title: tab_link.title
            endcapture

            assign tab_has_own_content = false
            if tab_block != nil or tab_banners_markup != blank
              assign tab_has_own_content = true
            endif
          -%}

          <div
            class="mega-menu__panel absolute left-0 top-full z-50 grid grid-cols-[auto_auto] h-[calc(100vh-var(--mega-menu-header-bottom,0px))] bg-surface border-t border-ink/50"
            data-mega-menu-panel="{{ tab_index }}"
            {% if tab_has_own_content %}
              data-mega-menu-has-own-content
            {% endif %}
            hidden
          >
            <div class="mega-menu__nav-links w-megamenu-col-width shrink-0 flex flex-col justify-between h-full min-h-0 overflow-y-auto overscroll-contain p-6 border-r border-ink/50">
              <div class="flex flex-col">
                {%- if featured_links.size > 0 -%}
                  <div class="flex flex-col">
                    {%- for link in featured_links -%}
                      <a
                        href="{{ link.url }}"
                        class="group/link flex items-center gap-2 py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] uppercase text-ink"
                      >
                        {{ link.title | escape }}
                        <span class="opacity-0 transition-opacity duration-150 group-hover/link:opacity-100 group-focus-visible/link:opacity-100">
                          {% render 'icon-chevron-right', size: 14 %}
                        </span>
                      </a>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if category_links.size > 0 -%}
                  <div class="flex flex-col{% if featured_links.size > 0 %} mt-12{% endif %}">
                    {%- for category_link in category_links -%}
                      {%- liquid
                        assign category_index = forloop.index0
                        assign link_color_class = 'text-ink'
                        assign category_link_key = category_link.title | strip | downcase
                        if category_link_key == 'sale'
                          assign link_color_class = 'text-sale'
                        endif
                      -%}
                      {%- comment -%}
                        Every Group 2 link is a hover trigger (dims siblings, shows chevron)
                        regardless of whether it has sub-links. Links with sub-links or their own
                        banners swap the content column to their category view; links with
                        neither (Sale included) close the content column, narrowing the panel to
                        the nav-links column only (see _onGroup2Enter in mega-menu.js).
                      {%- endcomment -%}
                      <a
                        href="{{ category_link.url }}"
                        class="group/link flex items-center gap-2 py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] {{ link_color_class }} transition-opacity"
                        data-mega-menu-group2-trigger="{{ tab_index }}-{{ category_index }}"
                      >
                        {{ category_link.title | escape }}
                        <span class="opacity-0 transition-opacity duration-150 group-hover/link:opacity-100 group-focus-visible/link:opacity-100">
                          {% render 'icon-chevron-right', size: 14 %}
                        </span>
                      </a>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>

              {%- if info_links.size > 0 -%}
                <div class="flex flex-col">
                  {%- for link in info_links -%}
                    <a
                      href="{{ link.url }}"
                      class="group/link flex items-center gap-2 py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] text-ink"
                      data-mega-menu-leaf-trigger="{{ tab_index }}"
                    >
                      {{ link.title | escape }}
                      <span class="opacity-0 transition-opacity duration-150 group-hover/link:opacity-100 group-focus-visible/link:opacity-100">
                        {% render 'icon-chevron-right', size: 14 %}
                      </span>
                    </a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

            {%- comment -%}
              When visible, this column's own width/height never change — only what's rendered
              inside it toggles (default promos / a category's content). Hiding it entirely
              (leaf hover, or a Group 2 link with no sub-links) narrows the panel down to the
              nav-links column, since the grid has nothing left to size this track against.
            {%- endcomment -%}
            <div
              class="mega-menu__content w-megamenu-col-width shrink-0 h-full min-h-0 overflow-y-auto overscroll-contain"
              data-mega-menu-content-wrapper="{{ tab_index }}"
              {% unless tab_has_own_content %}
                {%- comment -%}
                  No nav-tab block or banners for this tab yet — nothing of its own to show,
                  so start collapsed (narrow panel, info links only) instead of an empty
                  reserved column.
                {%- endcomment -%}
                hidden
              {% endunless %}
            >
              <div class="mega-menu__promo flex flex-col" data-mega-menu-promo-default="{{ tab_index }}">
                {{ tab_banners_markup }}
              </div>

              {%- for category_link in category_links -%}
                {%- liquid
                  assign category_index = forloop.index0
                  capture category_banners_markup
                    render 'mega-menu-banners', banner_blocks: banner_blocks, tab_title: tab_link.title, category_title: category_link.title
                  endcapture
                -%}
                {%- if category_link.links.size > 0 or category_banners_markup != blank -%}
                  <div
                    class="mega-menu__category flex flex-col"
                    data-mega-menu-category="{{ tab_index }}-{{ category_index }}"
                    hidden
                  >
                    {%- if category_link.links.size > 0 -%}
                      <div class="flex flex-col shrink-0 p-6">
                        {%- for sub_link in category_link.links -%}
                          <a href="{{ sub_link.url }}" class="py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] text-ink">
                            {{ sub_link.title | escape }}
                          </a>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}

                    {%- if category_banners_markup != blank -%}
                      {{ category_banners_markup }}
                    {%- else -%}
                      {{ tab_banners_markup }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div
    class="mega-menu__drawer fixed inset-x-0 bottom-0 top-[var(--mega-menu-header-bottom,0px)] z-[999] lg:hidden flex flex-col bg-surface -translate-y-full transition-transform duration-300"
    id="mega-menu-drawer"
    data-mega-menu-drawer
    {% if initial_tab_index != nil %}
      data-mega-menu-initial-tab="{{ initial_tab_index }}"
    {% endif %}
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'accessibility.menu' | t }}"
    hidden
  >
    {%- if linklists[main_menu].links.size > 0 -%}
      <div class="flex items-center gap-6 px-5" data-mega-menu-tab-row>
        {%- for tab_link in linklists[main_menu].links -%}
          {%- assign tab_link_key = tab_link.title | strip | downcase -%}
          {%- if tab_link_key != 'home' -%}
            {%- liquid
              assign tab_index = forloop.index0
              assign tab_block_index = tab_block_indexes[tab_index] | plus: 0
              assign tab_block = nil
              if tab_block_index >= 0
                assign tab_block = nav_tab_blocks[tab_block_index]
              endif
              assign tab_has_content = false
              if tab_has_content_flags[tab_index] == 'true'
                assign tab_has_content = true
              endif

              comment
                The active mobile tab is the one whose panel is showing, not the one matching
                the current page — the drawer opens on `initial_tab_index` and JS re-applies
                these classes on every tab click (see _setActiveMobileTab in mega-menu.js).
              endcomment
              assign tab_state_classes = 'font-medium opacity-60'
              if tab_index == initial_tab_index
                assign tab_state_classes = 'font-bold'
              endif
            -%}
            {%- if tab_has_content -%}
              <button
                type="button"
                class="font-primary text-base {{ tab_state_classes }} leading-6 tracking-[-0.2px] text-foreground py-3"
                data-mega-menu-tab="{{ tab_index }}"
                data-mega-menu-trigger="{{ tab_index }}"
              >
                {{ tab_link.title | escape }}
              </button>
            {%- else -%}
              <a
                href="{{ tab_link.url }}"
                class="font-primary text-base {{ tab_state_classes }} leading-6 tracking-[-0.2px] text-foreground py-3"
                data-mega-menu-tab="{{ tab_index }}"
              >
                {{ tab_link.title | escape }}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="flex-1 overflow-y-auto">
        {%- for tab_link in linklists[main_menu].links -%}
          {%- assign tab_link_key = tab_link.title | strip | downcase -%}
          {%- if tab_link_key != 'home' -%}
            {%- liquid
              assign tab_index = forloop.index0
              assign tab_block_index = tab_block_indexes[tab_index] | plus: 0
              assign tab_block = nil
              if tab_block_index >= 0
                assign tab_block = nav_tab_blocks[tab_block_index]
              endif
              assign tab_has_content = false
              if tab_has_content_flags[tab_index] == 'true'
                assign tab_has_content = true
              endif
            -%}

            {%- if tab_has_content -%}
              {%- liquid
                assign featured_links = linklists[tab_block.settings.tab_feat_menu].links
                assign category_links = linklists[tab_block.settings.tab_cat_menu].links

                capture tab_banners_markup
                  render 'mega-menu-banners', banner_blocks: banner_blocks, tab_title: tab_link.title
                endcapture
              -%}

              <div class="mega-menu__mobile-panel" data-mega-menu-panel="{{ tab_index }}" hidden>
                <div data-mega-menu-toplevel>
                  {%- if featured_links.size > 0 -%}
                    <div class="flex flex-col px-5 pt-2 pb-2">
                      {%- for link in featured_links -%}
                        <a href="{{ link.url }}" class="py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] uppercase text-ink">
                          {{ link.title | escape }}
                        </a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if category_links.size > 0 -%}
                    <div class="flex flex-col px-5 pt-2 pb-6">
                      {%- for category_link in category_links -%}
                        {%- liquid
                          assign category_index = forloop.index0
                          assign link_color_class = 'text-ink'
                          assign category_link_key = category_link.title | strip | downcase
                          if category_link_key == 'sale'
                            assign link_color_class = 'text-sale'
                          endif

                          capture category_banners_markup
                            render 'mega-menu-banners', banner_blocks: banner_blocks, tab_title: tab_link.title, category_title: category_link.title
                          endcapture
                        -%}
                        {%- if category_link.links.size > 0 or category_banners_markup != blank -%}
                          <button
                            type="button"
                            class="flex items-center gap-2 py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] {{ link_color_class }}"
                            data-mega-menu-cat-trigger="{{ tab_index }}-{{ category_index }}"
                          >
                            {{ category_link.title | escape }}
                            {% render 'icon-chevron-right', size: 14 %}
                          </button>
                        {%- else -%}
                          <a href="{{ category_link.url }}" class="py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] {{ link_color_class }}">
                            {{ category_link.title | escape }}
                          </a>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if tab_banners_markup != blank -%}
                    <div class="flex flex-col">
                      {{ tab_banners_markup }}
                    </div>
                  {%- endif -%}

                  {%- if info_links.size > 0 -%}
                    <div class="flex flex-col px-5 pt-5 pb-12">
                      {%- for link in info_links -%}
                        <a href="{{ link.url }}" class="py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] text-ink">
                          {{ link.title | escape }}
                        </a>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>

                {%- for category_link in category_links -%}
                  {%- liquid
                    assign category_index = forloop.index0
                    capture category_banners_markup
                      render 'mega-menu-banners', banner_blocks: banner_blocks, tab_title: tab_link.title, category_title: category_link.title
                    endcapture
                  -%}
                  {%- if category_link.links.size > 0 or category_banners_markup != blank -%}
                    {%- liquid
                      if category_banners_markup == blank
                        assign category_banners_markup = tab_banners_markup
                      endif
                    -%}
                    <div class="mega-menu__mobile-drill" data-mega-menu-drill="{{ tab_index }}-{{ category_index }}" hidden>
                      <button type="button" class="flex items-center gap-2 px-4 py-[14px] font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] text-ink" data-mega-menu-back>
                        {% render 'icon-chevron-left', size: 16 %}
                        {{ 'general.back' | t }}
                      </button>

                      <div class="flex flex-col px-5 pt-5 pb-12">
                        {%- if category_link.links.size > 0 -%}
                          {%- for sub_link in category_link.links -%}
                            <a href="{{ sub_link.url }}" class="py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] text-ink">
                              {{ sub_link.title | escape }}
                            </a>
                          {%- endfor -%}
                        {%- else -%}
                          <a href="{{ category_link.url }}" class="py-1.5 font-primary text-[14px] font-normal leading-[20px] tracking-[0.02em] text-ink">
                            {{ 'mega_menu.shop_all' | t: category: category_link.title }}
                          </a>
                        {%- endif -%}
                      </div>

                      {%- if category_banners_markup != blank -%}
                        <div class="flex flex-col">
                          {{ category_banners_markup }}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</mega-menu>

<script src="{{ 'mega-menu.js' | asset_url }}" defer></script>
