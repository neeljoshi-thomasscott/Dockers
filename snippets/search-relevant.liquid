{% doc %}
  Search Relevant

  Outputs "true" or "false". Shopify's semantic search returns loosely
  related products (e.g. "jeans" → shirts whose description says "pair with
  jeans"). A search only counts as having results when at least one result
  has a search word (singular or plural) in its title, product type, tags,
  handle or SKU; otherwise callers show the no-results state.

  @example
  {%- capture search_relevant -%}{%- render 'search-relevant' -%}{%- endcapture -%}
{% enddoc %}

{%- liquid
  assign relevant = true
  if search.performed and search.results_count > 0
    assign stems = ''
    assign words = search.terms | downcase | split: ' '
    for word in words
      assign stem = word | strip
      if stem.size < 3
        continue
      endif
      assign last_char = stem | slice: -1
      if last_char == 's' and stem.size > 3
        assign stem = stem | remove_last: 's'
      endif
      assign stems = stems | append: stem | append: '|'
    endfor
    assign stems = stems | split: '|'

    if stems.size > 0
      assign relevant = false
      for result in search.results limit: 50
        capture haystack
          echo result.title | append: ' ' | append: result.type | append: ' ' | append: result.handle | append: ' '
          echo result.tags | join: ' '
          for variant in result.variants
            echo ' ' | append: variant.sku
          endfor
        endcapture
        assign haystack = haystack | downcase
        for search_stem in stems
          if haystack contains search_stem
            assign relevant = true
            break
          endif
        endfor
        if relevant
          break
        endif
      endfor
    endif
  endif
  echo relevant
-%}
