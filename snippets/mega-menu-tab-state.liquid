{% doc %}
  Mega Menu Tab State

  Single source of the mega menu's per-tab rules, shared by the desktop header
  (which tabs are flyout triggers) and the mega menu (which tabs get a panel), so
  the two can never disagree. Outputs one `block_index:has_content` entry per
  main-menu link, comma-separated, in menu order:
  - block_index: index into the nav-tab blocks of the first block whose Tab Title
    matches the link title, or -1
  - has_content: true when the tab has its own menus or default banners, or the
    shared info menu has links. Home never has content.
  Titles are compared case- and whitespace-insensitively.

  @param {string} main_menu - Handle of the top-level link_list (header_main_menu setting)
  @param {string} info_menu - Handle of the shared Group 3 link_list (header_info_menu setting), may be blank
  @param {block[]} blocks - section.blocks, filtered internally by type

  @example
  {%- capture tab_state_list -%}{%- render 'mega-menu-tab-state', main_menu: main_menu, info_menu: info_menu, blocks: blocks -%}{%- endcapture -%}
{% enddoc %}

{%- liquid
  assign state_nav_tab_blocks = blocks | where: 'type', 'nav-tab'
  assign state_banner_blocks = blocks | where: 'type', 'nav-banner'
  assign state_info_links = linklists[info_menu].links

  for state_tab_link in linklists[main_menu].links
    assign state_tab_key = state_tab_link.title | strip | downcase

    assign state_block_index = -1
    for state_block in state_nav_tab_blocks
      assign state_block_key = state_block.settings.tab_title | strip | downcase
      if state_block_key == state_tab_key
        assign state_block_index = forloop.index0
        break
      endif
    endfor

    assign state_has_content = false
    unless state_tab_key == 'home'
      if state_block_index >= 0
        assign state_block = state_nav_tab_blocks[state_block_index]
        if state_block.settings.tab_feat_menu != blank or state_block.settings.tab_cat_menu != blank
          assign state_has_content = true
        endif
      endif

      for state_banner_block in state_banner_blocks
        assign state_banner_tab_key = state_banner_block.settings.banner_tab | strip | downcase
        assign state_banner_category = state_banner_block.settings.banner_cat | strip
        if state_banner_tab_key == state_tab_key and state_banner_category == blank and state_banner_block.settings.banner_img != blank
          assign state_has_content = true
        endif
      endfor

      if state_info_links.size > 0
        assign state_has_content = true
      endif
    endunless

    echo state_block_index | append: ':' | append: state_has_content | append: ','
  endfor
-%}
