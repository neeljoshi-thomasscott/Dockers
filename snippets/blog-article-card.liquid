{% doc %}
  Article card used by blog rows, the blog grid and Keep reading. The whole card links to the article.

  @param {article} card_article - Article (required)
  @param {string} category_label - Category text shown before the read time (required)
  @param {string} [image_height] - 'row', 'row-tall' or 'grid' (default 'grid')
  @param {boolean} [lazy] - Lazy-load the image (default true)

  @example
  {% render 'blog-article-card', card_article: article, category_label: blog.title, image_height: 'grid' %}
{% enddoc %}

{%- if card_article == blank -%}
  {%- break -%}
{%- endif -%}

{%- liquid
  case image_height
    when 'row'
      assign card_media_height = 'h-blog-card-image-row-mobile lg:h-blog-card-image-row'
    when 'row-tall'
      assign card_media_height = 'h-blog-card-image-row-mobile lg:h-blog-card-image-row-tall'
    else
      assign card_media_height = 'h-blog-card-image-grid-mobile lg:h-blog-card-image-grid'
  endcase

  assign card_lazy = true
  if lazy == false
    assign card_lazy = false
  endif
-%}
{%- capture card_read_time -%}{% render 'article-read-time', article: card_article %}{%- endcapture -%}
{%- assign card_read_time = card_read_time | plus: 0 -%}

<a href="{{ card_article.url }}" class="blog-article-card group flex h-full w-full flex-col">
  <div class="blog-article-card__media w-full overflow-hidden bg-surface-alt {{ card_media_height }}">
    {%- if card_article.image != blank -%}
      {%- assign card_image_alt = card_article.image.alt | default: card_article.title -%}
      {%- render 'image',
        image: card_article.image,
        alt: card_image_alt,
        class_name: 'h-full w-full object-cover',
        lazy: card_lazy,
        srcset_widths: '400,600,800,1000,1200',
        sizes: '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'
      -%}
    {%- endif -%}
  </div>
  <div class="blog-article-card__details flex flex-col gap-1 px-5 pb-8 pt-4">
    <p class="font-secondary text-blog-meta-sm text-ink-muted">
      {{- category_label | escape }}/{{ 'blog.read_time' | t: count: card_read_time -}}
    </p>
    <h3 class="line-clamp-2 h-8 font-primary text-blog-card-title font-medium text-ink can-hover:group-hover:underline">
      {{ card_article.title | escape }}
    </h3>
    <p class="line-clamp-2 h-10 font-primary text-blog-card-excerpt text-ink-muted">
      {{ card_article.excerpt_or_content | strip_html | truncatewords: 40 }}
    </p>
  </div>
</a>
