{% doc %}
  Mega Menu Promo

  Renders a single promo banner tile used inside the mega menu's content column
  (desktop flyout and mobile drawer). The CTA overlay position is
  merchant-configurable in the same spirit as the hero banner's alignment setting.

  @param {image} promo_image - Promo banner image
  @param {string} [promo_url] - Destination URL for the tile; without one the tile renders as a plain, non-clickable block
  @param {string} promo_text - CTA label
  @param {string} [promo_cta_pos] - CTA position, one of top-left, top-center, top-right, middle-left, middle-center, middle-right, bottom-left, bottom-center, bottom-right. Defaults to bottom-left.
{% enddoc %}

{%- liquid
  assign promo_resolved_pos = promo_cta_pos | default: 'bottom-left'

  case promo_resolved_pos
    when 'top-left'
      assign promo_align_class = 'items-start justify-start'
    when 'top-center'
      assign promo_align_class = 'items-start justify-center'
    when 'top-right'
      assign promo_align_class = 'items-start justify-end'
    when 'middle-left'
      assign promo_align_class = 'items-center justify-start'
    when 'middle-center'
      assign promo_align_class = 'items-center justify-center'
    when 'middle-right'
      assign promo_align_class = 'items-center justify-end'
    when 'bottom-center'
      assign promo_align_class = 'items-end justify-center'
    when 'bottom-right'
      assign promo_align_class = 'items-end justify-end'
    else
      assign promo_align_class = 'items-end justify-start'
  endcase
-%}

{%- if promo_image != blank -%}
  {%- if promo_url != blank -%}
    <a href="{{ promo_url }}" class="mega-menu__promo-tile relative block w-full shrink-0 aspect-[2/3] overflow-hidden">
  {%- else -%}
    <div class="mega-menu__promo-tile relative block w-full shrink-0 aspect-[2/3] overflow-hidden">
  {%- endif -%}
    {% render 'image', image: promo_image, class_name: 'w-full h-full object-cover', width: 360, height: 540 %}

    {%- if promo_text != blank -%}
      <span class="absolute inset-0 flex {{ promo_align_class }} py-[72px] pointer-events-none">
        <span class="flex items-center gap-2.5 bg-ink text-surface font-plex-mono text-[14px] leading-[20px] tracking-[0.02em] uppercase px-3 py-1">
          {% render 'icon-cta-arrow', size: 10 %}
          {{ promo_text | escape }}
        </span>
      </span>
    {%- endif -%}
  {%- if promo_url != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
{%- endif -%}
