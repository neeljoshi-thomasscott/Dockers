{% doc %}
  Outputs an article's estimated read time in whole minutes (200 words per minute, minimum 1).

  @param {article} article - Article object (required)

  @example
  {% render 'article-read-time', article: article %}
{% enddoc %}

{%- if article != blank -%}
  {%- liquid
    assign read_time_words = article.content | strip_html | split: ' ' | size
    assign read_time_minutes = read_time_words | plus: 199 | divided_by: 200 | at_least: 1
  -%}
  {{- read_time_minutes -}}
{%- endif -%}
