{% doc %}
  Pause Icon

  Two-bar pause glyph used in the hero banner carousel's autoplay
  toggle button.

  @param {string} [class] - CSS classes
  @param {number} [size] - Icon width/height in px (default: 24)

  @example
  {% render 'icon-pause', class: 'size-6' %}
{% enddoc %}

{%- assign icon_size = size | default: 24 -%}
<svg class="{{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <path d="M13 19V5H19V19H13ZM5 19V5H11V19H5ZM15 17H17V7H15V17ZM7 17H9V7H7V17Z" fill="currentColor"/>
</svg>
