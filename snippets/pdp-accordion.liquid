{% doc %}
  PDP Accordion

  Shared `<details>` accordion row used by the PDP's description/fit/
  materials-care/details/collapsible blocks — same markup shape, only the
  heading/content source and a couple of edge classes differ per block.

  @param {string} heading - Accordion summary text (required)
  @param {string} content - Accordion body content, may contain HTML (required)
  @param {boolean} [open_by_default] - Whether the `<details>` starts open (optional)
  @param {string} [border_class] - Border classes for the row (optional, defaults to bottom border)
  @param {string} [padding_class] - Top/side padding classes for the row (optional)
  @param {string} [summary_padding_class] - Vertical padding on the summary (optional, defaults to "py-4")
  @param {string} [content_class] - Extra classes on the body wrapper (optional, defaults to "font-primary")
  @param {string} [shopify_attributes] - `block.shopify_attributes` passthrough (optional)

  @example
  {% render 'pdp-accordion',
    heading: 'products.description' | t,
    content: product.description,
    open_by_default: block.settings.open_by_default,
    padding_class: 'pt-6 md:mx-10',
    shopify_attributes: block.shopify_attributes
  %}
{% enddoc %}

{%- liquid
  assign border_class = border_class | default: 'border-b border-border'
  assign padding_class = padding_class | default: 'md:mx-10'
  assign summary_padding_class = summary_padding_class | default: 'py-4'
  assign content_class = content_class | default: 'font-primary'
-%}

<details class="group {{ border_class }} {{ padding_class }}" {% if open_by_default %}open{% endif %} {{ shopify_attributes }}>
  <summary class="flex cursor-pointer items-center justify-between {{ summary_padding_class }} text-sm font-medium">
    {{ heading }}
    <span class="transition-transform duration-200 group-open:rotate-180">
      {% render 'icon-chevron-down', size: 16 %}
    </span>
  </summary>
  <div class="pb-4 {{ content_class }} text-pdp-accordion-body text-ink">
    {{ content }}
  </div>
</details>
