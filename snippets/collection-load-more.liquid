{% doc %}
  Collection Load More

  Renders the lazy-load trigger for the PLP grid: a real link to the next
  page of results, so it works with JavaScript disabled. With JavaScript
  enabled, collection-controller.js intercepts clicks and also auto-fires
  the fetch via an IntersectionObserver once this element nears the
  viewport, appending the next batch of products in place instead of
  navigating.

  @param {paginate} paginate - Shopify paginate object (required)
{% enddoc %}

{%- liquid
  assign paginate = paginate | default: empty

  unless paginate != empty
    break
  endunless

  # `paginate.next.url` keeps sort_by/filter.* but not reliably `view`, so
  # view is appended only when the URL doesn't already carry it.
  assign current_view_param = template.suffix

  assign next_url = paginate.next.url
  assign next_url_view_param = 'view=' | append: current_view_param
  if current_view_param != blank and next_url contains next_url_view_param
    assign current_view_param = ''
  endif

  if current_view_param != blank
    if next_url contains '?'
      assign next_url = next_url | append: '&view=' | append: current_view_param
    else
      assign next_url = next_url | append: '?view=' | append: current_view_param
    endif
  endif
-%}

{%- if paginate.next -%}
  <div class="collection-listing__load-more mt-8 flex justify-center" data-collection-load-more>
    <a
      href="{{ next_url }}"
      class="inline-block px-2 py-2 text-sm font-medium text-foreground transition-colors duration-200 hover:text-muted"
      data-collection-load-more-trigger
    >
      {{ 'general.pagination.next' | t }}
    </a>
    <div class="hidden" data-collection-load-more-spinner aria-live="polite">
      <span class="sr-only">{{ 'general.loading' | t }}</span>
      {%- render 'loader-spinner' -%}
    </div>
  </div>
{%- endif -%}
