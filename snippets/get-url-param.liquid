{% doc %}
  Get URL Parameter

  Extracts a URL query parameter value. Tries request.params first,
  falls back to content_for_header parsing for Section Rendering API compatibility.

  @param {string} param_name - The parameter name to extract (required)

  @example
  {% capture city_param %}
    {% render 'get-url-param', param_name: 'city' %}
  {% endcapture %}
  {% assign city_filter = city_param | strip %}
{% enddoc %}

{%- liquid
  assign param_name = param_name | default: ''
  assign param_value = ''

  if param_name == blank or param_name == ''
    echo ''
  else
    assign param_value = request.params[param_name] | default: ''

    if param_value == blank or param_value == ''
      # theme-check-disable ContentForHeaderModification
      # Deliberate workaround: the Section Rendering API (?sections=) only
      # guarantees built-in params like `q`/`page` reach request.params — custom
      # params (e.g. `products_shown` from the search drawer) are not exposed,
      # so we read the request URL from content_for_header.
      capture page_url_raw
        echo content_for_header | split: '"pageurl":"' | last | split: '"' | first
      endcapture
      # theme-check-enable ContentForHeaderModification

      # `pageurl` is embedded in content_for_header as JSON, so its separators
      # arrive escaped: every `&` as the literal characters `\u0026`, every
      # `/` as `\/`. They must be normalised before the query string is
      # split, or `split: '&'` finds nothing and every param except the last
      # one in the URL returns the whole remainder as its value — e.g.
      # `?sort_by=price-ascending&q=jeans` yielded the value
      # `price-ascending\u0026q=jeans` instead of `price-ascending`.
      assign ampersand_escape_sequence = '\u0026'
      assign page_url = page_url_raw | replace: ampersand_escape_sequence, '&' | replace: '\/', '/'

      if page_url contains '?'
        # The query string and the search term are both prefixed with `&` so
        # the match is anchored to a parameter boundary — otherwise a request
        # carrying `my_sort_by=` would satisfy a search for
        # `sort_by=`.
        assign query_string = page_url | split: '?' | last | prepend: '&'
        assign param_search = param_name | prepend: '&' | append: '='

        if query_string contains param_search
          assign param_parts = query_string | split: param_search
          if param_parts.size > 1
            assign param_value = param_parts[1] | split: '&' | first | split: '#' | first | url_decode
          endif
        endif
      endif
    endif

    echo param_value
  endif
-%}
