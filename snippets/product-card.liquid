{% doc %}
  Product Card

  Renders a product card for one of three views: column, grid, or row.
  Grid view shows image + wishlist only. Column and row also show an info
  block (title, price, swatches, rating) and a compact add-to-cart button.
  In every view the gallery viewport links to the product (Embla cancels the
  click after a drag, so tapping navigates while swiping still swipes). In
  column/row the title is the accessible link, so the image link is hidden
  from assistive tech and the tab order.

  @param {product} card_product - Product object (required)
  @param {string} [view] - Card layout: 'column', 'grid', or 'row' (default: 'column')
  @param {boolean} [show_discount_label] - Show computed discount percentage when a compare-at price exists (default: false)
  @param {boolean} [lazy_load] - Lazy-load the first image; pass false only for above-the-fold cards (default: true)
  @param {string} [card_class] - Additional CSS classes (optional)
  @param {string} [aspect_ratio] - Image aspect ratio: '2:3', '1:1', '4:5', '3:4', or '8:13' (default: '2:3')
  @param {boolean} [autoplay] - Enable gallery autoplay (default: false)
  @param {number} [autoplay_interval] - Autoplay interval in seconds (default: 5)
  @param {boolean} [compact] - Keep mobile card spacing at every width, for cards in narrow containers like the search drawer (default: false)
  @param {number} [image_width] - Requested image resolution in px, used for image_url width + srcset 1x/2x + the width attribute (default: 400)

  @example
  {% render 'product-card', card_product: product, view: 'column' %}
{% enddoc %}

{%- liquid
  assign card_product = card_product | default: blank

  unless card_product != blank
    break
  endunless

  assign view = view | default: 'column'
  case view
    when 'grid', 'row', 'column'
    else
      assign view = 'column'
  endcase

  assign show_discount_label = show_discount_label | default: false
  assign compact = compact | default: false
  # Explicit == false check, not `| default: true` — Liquid's default filter
  # treats a passed `false` as empty and would turn it back into true.
  assign card_image_lazy = true
  if lazy_load == false
    assign card_image_lazy = false
  endif
  assign card_class = card_class | default: ''
  assign image_width = image_width | default: 400
  assign image_width_2x = image_width | times: 2

  assign aspect_ratio = aspect_ratio | default: '2:3'
  case aspect_ratio
    when '2:3'
      assign aspect_ratio_class = 'aspect-[2/3]'
    when '1:1'
      assign aspect_ratio_class = 'aspect-[1/1]'
    when '4:5'
      assign aspect_ratio_class = 'aspect-[4/5]'
    when '3:4'
      assign aspect_ratio_class = 'aspect-[3/4]'
    when '8:13'
      assign aspect_ratio_class = 'aspect-[8/13]'
    else
      assign aspect_ratio_class = 'aspect-[2/3]'
  endcase

  assign autoplay = autoplay | default: false
  assign autoplay_interval = autoplay_interval | default: 5

  assign is_grid = false
  if view == 'grid'
    assign is_grid = true
  endif

  assign is_row = false
  if view == 'row'
    assign is_row = true
  endif

  assign show_info_block = true
  assign show_add_to_cart = true
  if is_grid
    assign show_info_block = false
    assign show_add_to_cart = false
  endif

  assign card_images = card_product.images
  assign card_images_count = card_images | size

  assign show_progress = false
  if is_grid == false and card_images_count > 1
    assign show_progress = true
  endif

  assign badge_text = card_product.metafields.custom.badge_text | strip
  assign show_badge = false
  if badge_text != blank and is_grid == false
    assign show_badge = true
  endif

  assign color_option = null
  assign color_option_index = null
  for option in card_product.options_with_values
    assign option_name_lower = option.name | downcase | strip
    if option_name_lower == 'color' or option_name_lower == 'colour'
      assign color_option = option
      assign color_option_index = forloop.index0
      break
    endif
  endfor

  assign show_swatches = false
  if color_option != blank and is_grid == false and card_product.has_only_default_variant == false
    assign show_swatches = true
  endif

  assign swatch_overflow_count = 0
  if show_swatches
    assign swatch_values_count = color_option.values | size
    assign swatch_overflow_count = swatch_values_count | minus: 5
  endif

-%}
{%- comment -%}
  Placeholder rating metafields, read the same way as in sections/product.liquid
  (see the note there on the reviews.* namespace and the Drop coercion).
{%- endcomment -%}
{%- capture rating_value_string -%}{{ card_product.metafields.custom.product_rating.value }}{%- endcapture -%}
{%- liquid
  assign rating_value = rating_value_string | times: 1.0
  assign review_count = card_product.metafields.custom.review_count.value | default: 0
  assign show_rating = false
  if is_grid == false and rating_value > 0 and review_count > 0
    assign show_rating = true
  endif
  if show_rating
    assign rating_rounded = rating_value | round
  endif

  assign wishlist_class_hover = 'relative flex items-center justify-center bg-surface-20 p-0.5 text-surface md:p-card-button-pad transition-colors duration-200 [@media(hover:hover)]:group-hover/card:bg-surface [@media(hover:hover)]:group-hover/card:text-ink focus-visible:bg-surface focus-visible:text-ink'
  assign wishlist_class_static = 'relative flex items-center justify-center bg-surface-20 p-0.5 text-surface transition-colors duration-200 md:p-card-button-pad'
  assign wishlist_class_row_desktop = 'relative flex items-center justify-center bg-swatch-border p-[2px] text-ink transition-colors duration-200'

  # group-hover/card:hover: (stacked) stays more specific than the plain
  # group-hover/card: rules, so it wins regardless of Tailwind's CSS order.
  # focus-visible: works without card hover (keyboard, or focus restored by
  # the cart drawer). The reveal animates height (0 -> h-6), not display: the
  # wishlist button above only gets its resting position from this one
  # collapsing to zero size.
  assign atc_class_hover = '[@media(hover:hover)]:h-0 [@media(hover:hover)]:py-0 [@media(hover:hover)]:pointer-events-none [@media(hover:hover)]:group-hover/card:h-6 [@media(hover:hover)]:group-hover/card:py-card-button-pad [@media(hover:hover)]:group-hover/card:pointer-events-auto [@media(hover:hover)]:group-hover/card:bg-surface [@media(hover:hover)]:group-hover/card:text-ink [@media(hover:hover)]:group-hover/card:hover:bg-ink [@media(hover:hover)]:group-hover/card:hover:text-surface [@media(hover:none)]:bg-surface-20 [@media(hover:none)]:text-surface focus-visible:h-6 focus-visible:py-card-button-pad focus-visible:pointer-events-auto focus-visible:bg-surface focus-visible:text-ink transition-[height,padding,background-color,color] duration-500 ease-out'
  assign atc_class_row_mobile = 'flex bg-surface-20 text-surface'
  assign atc_class_row_desktop = 'flex bg-swatch-border text-ink'

  # Full image width because quick-add-atc's size panel resolves `md:inset-x-0`
  # against this box; `items-end` keeps the buttons on the right. The box
  # passes clicks through (pointer-events-none, children re-enabled) so the
  # product link stays reachable. No z-index: one would create a stacking
  # context and trap quick-add-atc's scrim/panel below the sticky header.
  assign image_cluster_wrapper_class = 'pointer-events-none absolute bottom-card-image-inset-y-mobile left-card-image-inset-x-mobile right-card-image-inset-x-mobile flex flex-col items-end [&>*]:pointer-events-auto md:bottom-card-image-inset-y-desktop md:left-card-image-inset-x-desktop md:right-card-image-inset-x-desktop'

  # The gap is gated on the same conditions that reveal the ATC button (plus
  # its loading/added states, as in base.css) — flex `gap` would otherwise
  # still space out a zero-height button.
  assign cluster_gap_always = 'gap-card-button-gap'
  assign cluster_gap_on_atc = '[@media(hover:hover)]:gap-0 [@media(hover:hover)]:group-hover/card:gap-card-button-gap [@media(hover:none)]:gap-card-button-gap focus-within:gap-card-button-gap has-[.is-loading]:gap-card-button-gap has-[.is-added]:gap-card-button-gap transition-[gap] duration-500 ease-out'

  assign image_wishlist_class = wishlist_class_hover
  assign image_atc_class = atc_class_hover
  assign image_cluster_gap_class = cluster_gap_on_atc
  assign card_discount_class = 'text-price'
  if is_row
    assign card_discount_class = 'text-count tracking-normal'
    assign image_cluster_wrapper_class = image_cluster_wrapper_class | append: ' md:hidden'
    assign image_wishlist_class = wishlist_class_static
    assign image_atc_class = atc_class_row_mobile
    assign image_cluster_gap_class = cluster_gap_always
  endif
  assign badge_inset_class = 'md:bottom-card-image-inset-y-desktop md:left-card-image-inset-x-desktop'
  assign atc_compact_pad_class = 'p-0.5 md:p-card-button-pad'
  assign atc_panel_position_class = 'md:absolute md:-inset-x-[10px] md:bottom-0'
  assign info_pad_desktop_class = 'md:px-card-info-pad-x-desktop md:pt-card-info-pad-top-desktop md:pb-card-info-pad-bottom-desktop'
  if is_row
    assign info_pad_desktop_class = 'md:px-card-info-pad-x-desktop md:pt-card-info-pad-top-row-desktop md:pb-card-info-pad-bottom-row-desktop md:relative md:pr-16'
  endif

  # Compact cards keep the mobile insets and paddings at every width; the
  # size panel's -2px offset lands it 10px from the card edge, as above.
  if compact
    assign image_cluster_wrapper_class = image_cluster_wrapper_class | remove: ' md:bottom-card-image-inset-y-desktop md:left-card-image-inset-x-desktop md:right-card-image-inset-x-desktop'
    assign image_wishlist_class = image_wishlist_class | remove: ' md:p-card-button-pad'
    assign badge_inset_class = ''
    assign atc_compact_pad_class = 'p-0.5'
    assign atc_panel_position_class = 'md:absolute md:-inset-x-[2px] md:bottom-0'
    assign info_pad_desktop_class = ''
  endif
  assign image_cluster_wrapper_class = image_cluster_wrapper_class | append: ' ' | append: image_cluster_gap_class
-%}

<div
  class="product-card group/card relative flex h-full w-full flex-col overflow-hidden {{ card_class }}"
  data-product-card
  data-product-id="{{ card_product.id }}"
>
  {%- comment -%}
    Idiomorph (collection-controller.js's client-side view swap) matches
    nodes without an id by tag name + position, so without this it reuses
    the same <product-gallery> element across a row->column swap instead of
    replacing it — connectedCallback never re-fires, Embla is never
    reinitialized against the new slide count, and the progress bar (driven
    entirely by Embla's init/reInit/select events) goes stale. Keying the id
    on both product and view forces a real replace on any view change, so
    disconnectedCallback/connectedCallback correctly tear down and rebuild
    Embla; within the same view (e.g. a sort/filter update) the id stays
    stable and the node is reused as before.
  {%- endcomment -%}
  <product-gallery
    id="product-gallery-{{ card_product.id }}-{{ view }}"
    class="product-gallery relative block w-full"
    data-autoplay="{{ autoplay }}"
    data-autoplay-interval="{{ autoplay_interval }}"
    data-loop="true"
    {% unless is_row %}
      data-hover-swap
    {% endunless %}
  >
    <div
      class="product-card__image relative overflow-hidden bg-muted/5{% unless is_row %} {{ aspect_ratio_class }}{% endunless %}"
    >
      {%- comment -%}
        The badge sits bottom-left of the image in every view, inset by the same
        card-image-inset tokens the wishlist/add cluster uses on the bottom-right,
        so the two share one baseline as they do in the design.
      {%- endcomment -%}
      {%- if show_badge -%}
        <span
          class="absolute bottom-card-image-inset-y-mobile left-card-image-inset-x-mobile z-[1] flex h-badge-height items-center px-badge-pad-x py-badge-pad-y text-badge font-normal uppercase bg-surface-20 text-surface transition-colors duration-200 [@media(hover:hover)]:group-hover/card:bg-surface [@media(hover:hover)]:group-hover/card:text-ink {{ badge_inset_class }}"
          data-product-card-badge
        >
          {{ badge_text }}
        </span>
      {%- endif -%}

      <a
        href="{{ card_product.url }}"
        class="block h-full w-full"
        {%- if is_grid %}
          aria-label="{{ card_product.title | escape }}"
        {%- else %}
          tabindex="-1"
          aria-hidden="true"
        {%- endif %}
        data-product-card-image-link
      >

      {%- if card_images_count > 0 -%}
        <div class="product-gallery__viewport h-full w-full overflow-hidden" data-product-gallery-viewport>
          <div class="product-gallery__track flex h-full" data-product-gallery-track>
            {%- for image in card_images -%}
              <div class="product-gallery__slide overflow-hidden{% if is_row %} {{ aspect_ratio_class }} h-full w-full shrink-0 md:w-[390px]{% else %} h-full w-full shrink-0{% endif %}">
                <img
                  {%- if forloop.first %}
                    src="{{ image | image_url: width: image_width }}"
                    srcset="{{ image | image_url: width: image_width }} {{ image_width }}w, {{ image | image_url: width: image_width_2x }} {{ image_width_2x }}w"
                    {%- if card_image_lazy %}
                      loading="lazy"
                    {%- else %}
                      loading="eager"
                      fetchpriority="high"
                    {%- endif %}
                  {%- elsif is_row %}
                    src="{{ image | image_url: width: image_width }}"
                    srcset="{{ image | image_url: width: image_width }} {{ image_width }}w, {{ image | image_url: width: image_width_2x }} {{ image_width_2x }}w"
                    loading="lazy"
                  {%- else %}
                    data-src="{{ image | image_url: width: image_width }}"
                    data-srcset="{{ image | image_url: width: image_width }} {{ image_width }}w, {{ image | image_url: width: image_width_2x }} {{ image_width_2x }}w"
                  {%- endif %}
                  sizes="(min-width: 768px) 25vw, 50vw"
                  alt="{{ card_product.title | escape }}"
                  width="{{ image_width }}"
                  height="{% if is_row %}585{% else %}600{% endif %}"
                  class="h-full w-full object-cover"
                >
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <div class="flex h-full w-full items-center justify-center text-muted">
          {%- render 'icon-cart', size: 48 -%}
        </div>
      {%- endif -%}

      </a>

      <div class="{{ image_cluster_wrapper_class }}">
        <button
          type="button"
          class="{{ image_wishlist_class }}"
          data-wishlist-button
          aria-label="{{ 'products.wishlist' | t }}"
          {% comment %} flits support removed thrid party wishlist code from here {% endcomment %}
          style="display: none;"
          {% comment %} till here {% endcomment %}
        >
          {%- render 'icon-wishlist', size: 16 -%}
        </button>
        {%- if show_add_to_cart -%}
          {%- comment -%}
            -10px, not 0: the wrapper this panel measures against is already
            inset 20px from the card edge (card-image-inset-x-desktop, shared
            with the badge/wishlist/button positioning); Figma's panel sits at
            a 10px inset, so it must extend 10px past the wrapper on each side
            to land at the right width instead of inheriting the wrapper's.
          {%- endcomment -%}
          {%- render 'quick-add-atc', product: card_product, button_class: image_atc_class, compact_pad_class: atc_compact_pad_class, panel_position_class: atc_panel_position_class -%}
        {%- endif -%}
      </div>
    </div>

    {%- if show_progress -%}
      <div class="product-gallery__progress-track h-[3px] w-full overflow-hidden bg-ink-10" data-product-gallery-progress-track>
        <div class="product-gallery__progress-thumb" data-product-gallery-progress-thumb></div>
      </div>
    {%- endif -%}
  </product-gallery>

  {%- if show_info_block -%}
    <div class="flex flex-1 flex-col gap-card-info-gap px-card-info-pad-x-mobile pt-card-info-pad-top-mobile pb-card-info-pad-bottom-mobile {{ info_pad_desktop_class }}">
      <a
        href="{{ card_product.url }}"
        class="product-card__title truncate text-card-title font-normal text-ink"
        data-product-card-title-link
      >
        {{ card_product.metafields.custom.short_title.value | default: card_product.title }}
      </a>

      {%- render 'price-row',
        price: card_product.price,
        compare_at_price: card_product.compare_at_price,
        show_discount_label: show_discount_label,
        size: 'card',
        card_discount_class: card_discount_class
      -%}

      {%- if show_swatches -%}
        <div class="flex items-center gap-swatch-gap pt-swatch-row-pad-top" data-product-card-swatches>
          {%- for value in color_option.values limit: 5 -%}
            {%- liquid
              assign swatch_image = null
              assign swatch_color = null

              if value.swatch.image != blank
                assign swatch_image = value.swatch.image
              endif

              if value.swatch.color != blank
                assign swatch_color = value.swatch.color
              endif

              # Shopify's native color swatch (value.swatch above) is backed by a
              # metaobject type reserved to first-party apps — custom apps can't
              # create or link it. custom.swatch_colors is the fallback: a
              # merchant-editable {value: hex} map, checked before falling back
              # further to a per-variant thumbnail image.
              if swatch_color == null
                assign swatch_color = card_product.metafields.custom.swatch_colors.value[value]
              endif

              if swatch_image == null and swatch_color == null
                for variant in card_product.variants
                  case color_option_index
                    when 0
                      assign variant_option_value = variant.option1
                    when 1
                      assign variant_option_value = variant.option2
                    when 2
                      assign variant_option_value = variant.option3
                  endcase
                  if variant_option_value == value and variant.featured_image != blank
                    assign swatch_image = variant.featured_image
                    break
                  endif
                endfor
              endif
            -%}
            <span
              class="relative block h-2.5 w-2.5 overflow-hidden border border-ink-50"
              data-product-card-swatch
              title="{{ value | escape }}"
              aria-label="{{ value | escape }}"
            >
              {%- if swatch_image != blank -%}
                <img
                  src="{{ swatch_image | image_url: width: 40 }}"
                  alt="{{ value | escape }}"
                  width="20"
                  height="20"
                  loading="lazy"
                  class="h-full w-full object-cover"
                >
              {%- elsif swatch_color != blank -%}
                <span class="absolute inset-0" style="background-color: {{ swatch_color | escape }};"></span>
              {%- else -%}
                <span class="absolute inset-0 flex items-center justify-center bg-muted/30 text-[8px] font-medium uppercase leading-none text-muted">
                  {{- value | slice: 0 | escape -}}
                </span>
              {%- endif -%}
            </span>
          {%- endfor -%}
          {%- if swatch_overflow_count > 0 -%}
            <span class="text-swatch-more text-muted" data-product-card-swatch-overflow>
              +{{ swatch_overflow_count }}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_rating -%}
        <div class="flex items-center pt-rating-row-pad-top" data-product-card-rating>
          <div class="flex items-center gap-rating-gap">
            {%- for i in (1..5) -%}
              {%- if i <= rating_rounded -%}
                {%- render 'icon-star', size: 12, filled: true, class: 'text-ink' -%}
              {%- else -%}
                {%- render 'icon-star', size: 12, filled: false, class: 'text-muted' -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="ml-1.5 text-pdp-rating-count text-ink" data-product-card-review-count>
            ({{ review_count }})
          </span>
        </div>
      {%- endif -%}

      {%- if is_row -%}
        {%- comment -%}
          Spans between both info-block insets for the same reason the image
          cluster above does — it is the positioned ancestor quick-add-atc's
          size panel measures its width against. `md:items-end` keeps the two
          buttons pinned right.
        {%- endcomment -%}
        <div class="hidden md:pointer-events-none md:absolute md:left-card-info-pad-x-desktop md:right-card-image-inset-x-desktop md:top-card-info-pad-top-row-desktop md:flex md:flex-col md:items-end md:gap-card-button-gap md:[&>*]:pointer-events-auto">
          <button
            type="button"
            class="{{ wishlist_class_row_desktop }}"
            data-wishlist-button
            {% comment %} flits support removed thrid party wishlist code from here {% endcomment %}
          style="visibility: hidden;"
          {% comment %} till here {% endcomment %}
            aria-label="{{ 'products.wishlist' | t }}"
          >
            {%- render 'icon-wishlist', size: 16 -%}
          </button>
          {%- render 'quick-add-atc', product: card_product, button_class: atc_class_row_desktop, compact_pad_class: 'p-[2px]', panel_position_class: 'md:absolute md:inset-x-0 md:bottom-0' -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
