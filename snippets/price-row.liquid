{% doc %}
  Price Row

  Renders a product price row shared by the PLP product card, the PDP price
  block and the PDP "style with" cards. Selling price comes first, then the
  green discount, then the struck-through MRP.

  @param {number} price - Current price in cents
  @param {number} [compare_at_price] - Compare-at price in cents (optional)
  @param {boolean} [show_discount_label] - Show computed discount percentage when a compare-at price exists (default: false)
  @param {string} [size] - Layout variant: 'card', 'pdp' (inline) or 'pdp_mrp' (price + discount, then an MRP line) (default: 'card')
  @param {string} [class] - Additional wrapper CSS classes (optional)
  @param {string} [price_class] - Font-size utilities for the price ('pdp' and 'pdp_mrp' sizes)
  @param {string} [discount_class] - Font-size utilities for the discount label ('pdp' and 'pdp_mrp' sizes)
  @param {string} [gap_class] - Horizontal gap utility between price parts ('pdp' size only)
  @param {string} [card_discount_class] - Size class for the card discount (default: 'text-price')
  @param {string} [tax_note] - Text after the MRP on the 'pdp_mrp' layout (optional)

  Theme settings `show_compare_price` and `show_discount_percent` switch the
  MRP slash and the discount % off store-wide. When off, the element is not
  rendered, so the variant price updaters skip it.

  @example
  {% render 'price-row', price: current_variant.price, compare_at_price: current_variant.compare_at_price, show_discount_label: true, size: 'pdp_mrp', tax_note: 'Inclusive of all taxes' %}
{% enddoc %}

{%- liquid
  assign price = price | default: 0
  assign show_discount_label = show_discount_label | default: false
  assign size = size | default: 'card'
  assign row_class = class | default: ''

  assign render_compare = settings.show_compare_price
  assign render_discount = settings.show_discount_percent

  assign show_compare = false
  if compare_at_price > price
    assign show_compare = true
  endif

  assign discount_pct = 0
  if show_compare
    assign discount_pct = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round
  endif

  assign show_discount = false
  if show_discount_label and show_compare and render_discount
    assign show_discount = true
  endif

  assign price_class = price_class | default: 'text-pdp-price-mobile md:text-pdp-price-desktop'
  assign discount_class = discount_class | default: 'text-pdp-discount-mobile md:text-pdp-discount-desktop'
  assign gap_class = gap_class | default: 'gap-2'
-%}
{%- case size -%}
  {%- when 'pdp_mrp' -%}
    <div class="price-row flex flex-col gap-0.5 {{ row_class }}" data-product-price-row>
      <div class="flex flex-wrap items-baseline gap-2">
        <span class="font-primary {{ price_class }} font-semibold text-ink" data-product-price>
          {%- render 'format-price', cents: price -%}
        </span>
        {%- if render_discount -%}
          <span
            class="font-primary {{ discount_class }} whitespace-nowrap font-medium text-success{% unless show_compare %} hidden{% endunless %}"
            data-product-discount
          >
            {%- if show_compare -%}
              {{ discount_pct }}% OFF
            {%- endif -%}
          </span>
        {%- endif -%}
      </div>
      <p class="flex flex-wrap items-baseline gap-x-2 font-primary text-count tracking-normal text-ink">
        {%- if render_compare -%}
          <span class="text-muted{% unless show_compare %} hidden{% endunless %}" data-product-mrp>
            MRP
            <s data-product-compare-price>
              {%- if show_compare -%}
                {%- render 'format-price', cents: compare_at_price -%}
              {%- endif -%}
            </s>
          </span>
        {%- endif -%}
        {%- if tax_note != blank -%}
          <span>{{ tax_note }}</span>
        {%- endif -%}
      </p>
    </div>
  {%- when 'pdp' -%}
    <div class="price-row flex flex-wrap items-baseline {{ gap_class }} {{ row_class }}" data-product-price-row>
      <span class="font-primary {{ price_class }} font-semibold text-ink" data-product-price>
        {%- render 'format-price', cents: price -%}
      </span>
      {%- if render_discount -%}
        <span
          class="font-primary {{ discount_class }} whitespace-nowrap text-success{% unless show_compare %} hidden{% endunless %}"
          data-product-discount
        >
          {%- if show_compare -%}
            ({{ discount_pct }}% OFF)
          {%- endif -%}
        </span>
      {%- endif -%}
      {%- if render_compare -%}
        <s
          class="font-primary {{ price_class }} text-muted{% unless show_compare %} hidden{% endunless %}"
          data-product-compare-price
        >
          {%- if show_compare -%}
            {%- render 'format-price', cents: compare_at_price -%}
          {%- endif -%}
        </s>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="product-card__price flex flex-wrap items-baseline gap-x-1 {{ row_class }}" data-product-card-price-row>
      <span class="text-price font-semibold" data-product-card-price>
        {%- render 'format-price', cents: price -%}
      </span>
      {%- if show_discount -%}
        <span class="{{ card_discount_class | default: 'text-price' }} whitespace-nowrap font-normal text-success" data-product-card-discount>
          ({{ discount_pct }}% OFF)
        </span>
      {%- endif -%}
      {%- if render_compare -%}
        <s class="text-price text-text-muted{% unless show_compare %} hidden{% endunless %}" data-product-card-compare-price>
          {%- render 'format-price', cents: compare_at_price -%}
        </s>
      {%- endif -%}
    </div>
{%- endcase -%}
