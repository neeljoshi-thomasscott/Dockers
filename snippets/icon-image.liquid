{% doc %}
  Image Icon

  Generic placeholder glyph for an empty image slot (e.g. a size guide
  image not yet uploaded for this product).

  @param {string} [class] - Additional CSS classes (optional)
  @param {number} size - Icon size in pixels (default: 20)
{% enddoc %}

{%- assign icon_size = size | default: 20 -%}
<svg
  class="{{ class }}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
  <circle cx="8.5" cy="8.5" r="1.5"/>
  <polyline points="21 15 16 10 5 21"/>
</svg>
