{% doc %}
  Collection Listing Grid

  Renders the paginated product grid (or empty state) for one page of
  results. Extracted so sections/collection-listing.liquid can branch its
  {% paginate %} tag over the literal `collection.products` or
  `search.results` expression (paginate requires the native paginateable
  object, not an assigned alias) while sharing this markup between both
  branches.

  @param {product[]} items - Paginated products for the current page
  @param {string} view - Current view mode (column/grid/row)
  @param {string} image_aspect_ratio - Product card image aspect ratio
  @param {boolean} gallery_autoplay - Whether card galleries autoplay
  @param {number} gallery_autoplay_interval - Autoplay interval in seconds
  @param {string} grid_class_mobile - Tailwind grid-cols class for mobile
  @param {string} grid_class_desktop - Tailwind grid-cols class for desktop
  @param {object} [paginate] - The paginate drop for the current page (omit to hide load-more)
  @param {number} [items_limit] - Max products to render (default: all items)
  @param {string} [empty_state] - Empty state HTML (snippets/collection-empty-state.liquid)
{% enddoc %}

{%- liquid
  assign items_limit = items_limit | default: items.size

  # Only the first row of page 1 is above the fold — those cards load their
  # first image eagerly; every later card (and every load-more page) is lazy.
  assign eager_card_count = 0
  if paginate == blank or paginate.current_page == 1
    assign eager_card_count = 4
  endif
-%}

{%- if items.size > 0 -%}
  <div
    class="collection-listing__grid grid {{ grid_class_mobile }} {{ grid_class_desktop }} gap-0"
    data-collection-listing-grid
  >
    {%- for product in items limit: items_limit -%}
      {%- comment -%} A search URL without type=product also returns articles and pages {%- endcomment -%}
      {%- if product.object_type and product.object_type != 'product' -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign card_lazy_load = true
        if forloop.index <= eager_card_count
          assign card_lazy_load = false
        endif
      -%}
      {% render 'product-card',
        card_product: product,
        view: view,
        aspect_ratio: image_aspect_ratio,
        autoplay: gallery_autoplay,
        autoplay_interval: gallery_autoplay_interval,
        show_discount_label: true,
        lazy_load: card_lazy_load
      %}
    {%- endfor -%}
  </div>

  {%- render 'collection-load-more', paginate: paginate -%}
{%- else -%}
  <div class="collection-listing__empty" data-collection-listing-empty>
    {{ empty_state }}
  </div>
{%- endif -%}
