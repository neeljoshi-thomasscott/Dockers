{% doc %}
  Renders breadcrumb items (Home, parent collections, current collection and
  optional product) plus matching BreadcrumbList structured data. Parent
  collections come from handle prefixes: men-shirts-casual -> men, men-shirts.

  @param {collection} [crumb_collection] - Current collection, or the collection the product was opened from
  @param {product} [product] - Current product; when set, the collection becomes a link and the product is the last item
  @param {string} [home_label] - Label for the Home link
  @param {boolean} [show_structured_data] - Output BreadcrumbList JSON-LD (default true)
{% enddoc %}
{%- liquid
  assign trail_collection = crumb_collection

  if product != blank and trail_collection == blank
    assign product_type_handle = product.type | handleize
    for product_tag in product.tags
      assign category_handle = product_tag | handleize | append: '-' | append: product_type_handle
      if collections[category_handle].id != blank
        assign trail_collection = collections[category_handle]
        break
      endif
    endfor
    if trail_collection == blank
      assign trail_collection = product.collections.first
    endif
  endif

  assign parent_handles = ''
  if trail_collection != blank
    assign handle_parts = trail_collection.handle | split: '-'
    assign handle_prefix = ''
    for handle_part in handle_parts
      if forloop.last
        break
      endif
      if handle_prefix == ''
        assign handle_prefix = handle_part
      else
        assign handle_prefix = handle_prefix | append: '-' | append: handle_part
      endif
      if collections[handle_prefix].id != blank
        assign parent_handles = parent_handles | append: handle_prefix | append: ','
      endif
    endfor
  endif
  assign parent_handles = parent_handles | split: ','

  assign crumb_position = 1
-%}

<a href="{{ routes.root_url }}">{{ home_label | default: 'Home' }}</a>

{%- for parent_handle in parent_handles -%}
  {%- assign parent_collection = collections[parent_handle] -%}
  <span>/</span>
  <a href="{{ parent_collection.url }}">{{ parent_collection.title }}</a>
{%- endfor -%}

{%- if trail_collection != blank -%}
  <span>/</span>
  {%- if product != blank -%}
    <a href="{{ trail_collection.url }}">{{ trail_collection.title }}</a>
  {%- else -%}
    <span aria-current="page">{{ trail_collection.title }}</span>
  {%- endif -%}
{%- endif -%}

{%- if product != blank -%}
  <span>/</span>
  <span aria-current="page">{{ product.title }}</span>
{%- endif -%}

{%- if show_structured_data == false -%}
  {%- break -%}
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": {{ crumb_position }},
        "name": {{ home_label | default: 'Home' | json }},
        "item": {{ request.origin | append: routes.root_url | json }}
      }
      {%- for parent_handle in parent_handles -%}
        {%- assign parent_collection = collections[parent_handle] -%}
        {%- assign crumb_position = crumb_position | plus: 1 -%}
        ,{
          "@type": "ListItem",
          "position": {{ crumb_position }},
          "name": {{ parent_collection.title | json }},
          "item": {{ request.origin | append: parent_collection.url | json }}
        }
      {%- endfor -%}
      {%- if trail_collection != blank -%}
        {%- assign crumb_position = crumb_position | plus: 1 -%}
        ,{
          "@type": "ListItem",
          "position": {{ crumb_position }},
          "name": {{ trail_collection.title | json }},
          "item": {{ request.origin | append: trail_collection.url | json }}
        }
      {%- endif -%}
      {%- if product != blank -%}
        {%- assign crumb_position = crumb_position | plus: 1 -%}
        ,{
          "@type": "ListItem",
          "position": {{ crumb_position }},
          "name": {{ product.title | json }},
          "item": {{ request.origin | append: product.url | json }}
        }
      {%- endif -%}
    ]
  }
</script>
