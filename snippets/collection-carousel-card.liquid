{% doc %}
  Renders a single collection carousel slide/card.

  @param {object} block - The `collection-card` block object
{% enddoc %}

{%- liquid
  assign card_link = block.settings.link
  assign card_label = block.settings.label
-%}

<div class="collection-carousel__slide shrink-0 w-card-width snap-start" data-drag-scroll-item {{ block.shopify_attributes }}>
  {%- if card_link != blank -%}
    <a href="{{ card_link }}" class="collection-carousel__card block">
  {%- else -%}
    <div class="collection-carousel__card">
  {%- endif -%}

    <div class="collection-carousel__image aspect-[2/3] overflow-hidden">
      {%- if block.settings.image == blank and request.design_mode -%}
        <div class="flex h-full w-full items-center justify-center border border-dashed border-border bg-background-alt text-meta text-muted">
          Select an image
        </div>
      {%- else -%}
        {%- render 'image',
          image: block.settings.image,
          mobile_image: block.settings.mobile_image,
          class_name: 'h-full w-full object-cover',
          lazy: true,
          decorative: true,
          srcset_widths: '180,240,320,360,480,640,800,1000',
          sizes: 'max(clamp(168px, calc(168px + (100vw - 390px) * 0.221), 506px), 27.78vw)',
          width: 400,
          height: 600
        -%}
      {%- endif -%}
    </div>
    <div class="collection-carousel__label-bar bg-ink pt-card-label-pad-top pb-card-label-pad-bottom px-card-label-pad-x">
      <span class="collection-carousel__label block text-label md:text-card-label font-primary text-surface">{{ card_label | escape }}</span>
    </div>

  {%- if card_link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}
</div>
