{% doc %}
  Product Form

  Renders the add-to-cart form with selling plan selector and buy buttons (quantity fixed to 1, no visible stepper).
  AJAX add-to-cart via product-form.js Web Component. Falls back to standard form POST without JS.

  @param {object} product - Product object (required)
  @param {string} [buy_now_label] - Resolved "Buy Now" label (default: products.buy_now locale key)
  @param {string} [add_to_bag_label] - Resolved "Add to Bag" label (default: products.add_to_bag locale key)

  @example
  {% render 'product-form', product: product, buy_now_label: buy_now_label, add_to_bag_label: add_to_bag_label %}
{% enddoc %}

{%- liquid
  assign product = product | default: blank

  unless product != blank
    break
  endunless

  assign selected_variant = product.selected_or_first_available_variant
  assign current_variant_id = selected_variant.id
  assign default_buy_now_label = 'products.buy_now' | t
  assign default_add_to_bag_label = 'products.add_to_bag' | t
  assign buy_now_label = buy_now_label | default: default_buy_now_label
  assign add_to_bag_label = add_to_bag_label | default: default_add_to_bag_label
-%}

<product-form
  class="product-form block"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-url="{{ product.url }}"
>
  <form
    id="product-form-{{ product.id }}"
    action="{{ routes.cart_add_url }}"
    method="post"
    data-product-form
  >
    <select
      name="id"
      class="mb-4 w-full border border-border bg-transparent px-4 py-3 font-primary text-sm text-ink"
      aria-label="{{ 'products.select_variant' | t }}"
      data-variant-select
    >
      {%- for variant in product.variants -%}
        <option
          value="{{ variant.id }}"
          {% if variant.id == current_variant_id %}selected{% endif %}
          {% unless variant.available %}disabled{% endunless %}
        >
          {{ variant.title | escape }}{% unless variant.available %} - {{ 'products.sold_out' | t }}{% endunless %}
        </option>
      {%- endfor -%}
    </select>
    <input type="hidden" name="selling_plan" value="" data-selling-plan-input>

    {%- if product.selling_plan_groups.size > 0 -%}
      <div class="mb-4">
        {% render 'selling-plan-selector', product: product %}
      </div>
    {%- endif -%}

    <input type="hidden" name="quantity" value="1">

    <div class="hidden gap-pdp-buy-gap md:flex md:px-pdp-info-pad-x-desktop md:py-pdp-info-pad-y-desktop">
      {% render 'buy-buttons', product: product, buy_now_label: buy_now_label, add_to_bag_label: add_to_bag_label %}
    </div>
    <div data-form-error class="mt-2 text-sm text-error" hidden></div>
  </form>
</product-form>
