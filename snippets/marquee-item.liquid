{% doc %}
  Renders a single marquee item followed by its separator.

  @param {block} block - The marquee-item block object
  @param {boolean} [is_duplicate] - True for repeated copies; hides it from screen readers and drops the editor attributes
{% enddoc %}

{%- liquid
  assign marquee_item_text = block.settings.marquee_item_text
-%}

{%- if marquee_item_text != blank -%}
  <li
    class="about-marquee__item flex shrink-0 gap-about-marquee-gap-mobile whitespace-nowrap md:gap-about-marquee-gap-desktop"
    {%- if is_duplicate %} aria-hidden="true"{%- else %} {{ block.shopify_attributes }}{%- endif %}
  >
    <span class="about-marquee__text">{{ marquee_item_text | escape }}</span>
    <span class="about-marquee__separator" aria-hidden="true">/</span>
  </li>
{%- endif -%}
