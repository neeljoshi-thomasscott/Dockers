{% doc %}
  Collection Empty State

  Centred message with one way back, for a listing with no products.

  @param {string} heading - Heading text
  @param {string} [text] - Supporting line
  @param {string} [button_label] - Button text (button hidden when blank)
  @param {string} [button_href] - Button link
{% enddoc %}

<div class="collection-empty-state flex flex-col items-center px-page-gutter-mobile py-16 text-center md:px-page-gutter-desktop md:py-24">
  <h2 class="font-primary text-2xl font-bold md:text-3xl">{{ heading | escape }}</h2>
  {%- if text != blank -%}
    <p class="mt-3 max-w-md text-base text-muted">{{ text | escape }}</p>
  {%- endif -%}
  {%- if button_label != blank and button_href != blank -%}
    <div class="mt-8">
      {%- render 'tag-pill', href: button_href, label: button_label -%}
    </div>
  {%- endif -%}
</div>
