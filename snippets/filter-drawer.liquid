{% doc %}
  Filter Drawer

  Single filter control rendered once per collection or search page. Renders
  as a right-anchored desktop panel and a bottom sheet on mobile, over a
  scrim. Opens on the `toolbar:open-filter` CustomEvent. Every filter group
  reuses the shared accordion snippet, and every checkbox is a real form
  input so the control works with JavaScript disabled. On `/search`,
  `collection.*` reads are aliased to `search.*` internally.

  @param {object} collection - The collection object (blank on /search)
  @param {string} [drawer_title] - Header title text (default: locale)
  @param {string} [reset_label] - Reset button text (default: locale)
  @param {string} [apply_label] - Apply button text (default: locale)
{% enddoc %}

{%- liquid
  assign collection = collection | default: blank
  assign is_search_template = false
  if template.name == 'search'
    assign is_search_template = true
  endif

  unless collection != blank or is_search_template
    break
  endunless

  assign drawer_title_fallback = 'collections.filter_drawer_title' | t
  assign reset_label_fallback = 'collections.filter_reset' | t
  assign apply_label_fallback = 'collections.filter_apply' | t
  assign drawer_title = drawer_title | default: drawer_title_fallback
  assign reset_label = reset_label | default: reset_label_fallback
  assign apply_label = apply_label | default: apply_label_fallback

  if is_search_template
    assign working_filters = search.filters
    assign working_result_count = search.results_count
    capture search_relevant
      render 'search-relevant'
    endcapture
    if search_relevant contains 'false'
      assign working_result_count = 0
    endif
    assign form_action = routes.search_url
  else
    assign working_filters = collection.filters
    assign working_result_count = collection.products_count
    assign form_action = collection.url
  endif

  # No-JS GET submit drops view (template.suffix) and sort unless they ride along as hidden inputs.
  assign current_view_param = template.suffix

  capture current_sort_param
    render 'get-url-param', param_name: 'sort_by'
  endcapture
  assign current_sort_param = current_sort_param | strip
-%}

<filter-drawer
  class="filter-drawer fixed inset-0 z-[110] pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="filter-drawer-title"
>
  <div
    class="filter-drawer__scrim absolute inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
    data-filter-drawer-scrim
  ></div>

  {% comment %}
    The mobile sheet is anchored on `bottom` only and sized relative to the
    viewport, so `translate-y-full` (100% of its own height) parks it exactly
    off-screen on every device.
  {% endcomment %}
  <div
    class="filter-drawer__panel fixed inset-x-0 bottom-0 top-sheet-top w-full translate-y-full bg-background shadow-xl transition-transform duration-300 flex flex-col md:absolute md:inset-y-0 md:inset-x-auto md:right-0 md:w-filter-drawer-width md:h-full md:translate-x-full md:translate-y-0 md:border-l-[0.5px] md:border-ink"
    data-filter-drawer-panel
  >
    <div class="filter-drawer__header flex h-drawer-header-height items-center justify-between py-drawer-header-pad-y pl-drawer-header-pad-left-mobile pr-drawer-header-pad-right-mobile md:pl-drawer-header-pad-left-desktop md:pr-drawer-header-pad-right-desktop">
      <h2 id="filter-drawer-title" class="filter-drawer__title text-control font-medium uppercase">{{ drawer_title }}</h2>
      <div class="flex items-center gap-3">
        <span class="filter-drawer__count text-copy uppercase font-secondary text-muted" data-filter-drawer-count>{{ 'collections.products_count' | t: count: working_result_count }}</span>
        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center"
          data-filter-drawer-close
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {%- render 'icon-close', size: 20 -%}
        </button>
      </div>
    </div>

    <form action="{{ form_action }}" method="get" class="filter-drawer__form flex flex-1 flex-col overflow-hidden" data-filter-drawer-form>
      {%- if current_view_param != blank -%}
        <input type="hidden" name="view" value="{{ current_view_param }}">
      {%- endif -%}
      {%- if current_sort_param != blank -%}
        <input type="hidden" name="sort_by" value="{{ current_sort_param }}">
      {%- endif -%}
      {%- if is_search_template -%}
        <input type="hidden" name="q" value="{{ search.terms | escape }}">
        <input type="hidden" name="type" value="product">
      {%- endif -%}

      <div class="filter-drawer__body flex-1 overflow-y-auto overscroll-contain" data-filter-drawer-body>
        {%- if working_filters.size > 0 -%}
          {%- for filter in working_filters -%}
            {%- assign group_default_open = false -%}
            {%- if forloop.first -%}
              {%- assign group_default_open = true -%}
            {%- endif -%}

            {%- capture group_content -%}
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  {%- comment -%}
                    Bounds are whole rupees: Shopify reports cents, and the top is rounded up
                    to the next step so the right handle can reach the highest price. The
                    hidden inputs carry the filter; a handle left at its end sends nothing.
                  {%- endcomment -%}
                  {%- liquid
                    assign price_step = 100
                    assign price_max = filter.range_max | divided_by: 100.0 | divided_by: price_step | ceil | times: price_step
                    assign price_value_min = filter.min_value.value | divided_by: 100
                    assign price_value_max = filter.max_value.value | divided_by: 100.0 | ceil
                    assign price_from = 0
                    assign price_to = price_max
                    if filter.min_value.value != null
                      assign price_from = price_value_min
                    endif
                    if filter.max_value.value != null
                      assign price_to = price_value_max
                    endif
                  -%}

                  <price-range
                    class="filter-drawer__price block px-drawer-group-pad-x-mobile md:px-drawer-group-pad-x-desktop"
                    data-max="{{ price_max }}"
                  >
                    <div class="flex items-center justify-between text-control font-medium" aria-hidden="true">
                      <span>{{ cart.currency.symbol }}<span data-price-range-label="min">{{ price_from }}</span></span>
                      <span>{{ cart.currency.symbol }}<span data-price-range-label="max">{{ price_to }}</span></span>
                    </div>

                    <div class="price-range__track relative mt-3 h-5">
                      <input
                        type="range"
                        class="price-range__input"
                        min="0"
                        max="{{ price_max }}"
                        step="{{ price_step }}"
                        value="{{ price_from }}"
                        aria-label="{{ filter.label | escape }} minimum"
                        data-price-range-input="min"
                      >
                      <input
                        type="range"
                        class="price-range__input"
                        min="0"
                        max="{{ price_max }}"
                        step="{{ price_step }}"
                        value="{{ price_to }}"
                        aria-label="{{ filter.label | escape }} maximum"
                        data-price-range-input="max"
                      >
                    </div>

                    <input type="hidden" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value != null %}{{ price_value_min }}{% endif %}" data-filter-drawer-price data-price-range-value="min">
                    <input type="hidden" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value != null %}{{ price_value_max }}{% endif %}" data-filter-drawer-price data-price-range-value="max">
                  </price-range>
                {%- else -%}
                  <ul class="flex flex-col gap-2.5">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="filter-drawer__option flex h-4 items-center gap-option-row-gap px-drawer-group-pad-x-mobile md:px-drawer-group-pad-x-desktop has-[:disabled]:cursor-not-allowed has-[:disabled]:opacity-40">
                          <span class="relative flex h-3.5 w-3.5 shrink-0">
                            <input
                              type="checkbox"
                              class="filter-drawer__checkbox peer h-3.5 w-3.5 cursor-pointer appearance-none rounded-none border border-ink-20 bg-background checked:border-ink checked:bg-ink"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              data-filter-drawer-checkbox
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            >
                            {% render 'icon-checkmark', size: 10, class: 'pointer-events-none absolute left-0.5 top-0.5 hidden text-surface peer-checked:block' %}
                          </span>
                          <span class="text-filter-option font-normal">
                            {{- value.label }} <span data-filter-drawer-option-count>({{ value.count }})</span>
                          </span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
              {%- endcase -%}
            {%- endcapture -%}

            {%- render 'accordion',
              title: filter.label,
              content: group_content,
              default_open: group_default_open,
              group: 'filter-drawer',
              icon_type: 'plus-minus',
              class_name: 'filter-drawer__group',
              title_class: 'h-drawer-group-height-collapsed-mobile md:h-drawer-group-height-collapsed-desktop md:aria-expanded:h-12 px-drawer-group-pad-x-mobile md:px-drawer-group-pad-x-desktop text-control font-medium',
              content_class: 'mt-1 pb-6 md:mt-0 md:pb-7'
            -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      {% comment %} Footer actions are flush per Figma: no padding, gap or Reset border. {% endcomment %}
      <div class="filter-drawer__footer flex h-12 items-center border-t-[0.5px] border-ink md:h-drawer-footer-height" data-filter-drawer-footer>
        <button
          type="reset"
          class="filter-drawer__reset h-full w-filter-reset-width shrink-0 text-control font-medium uppercase text-foreground bg-background"
          data-filter-drawer-reset
        >{{ reset_label }}</button>
        <button
          type="submit"
          class="filter-drawer__apply h-full flex-1 text-control font-medium uppercase text-background bg-foreground"
          data-filter-drawer-apply
        >{{ apply_label }}</button>
      </div>
    </form>
  </div>
</filter-drawer>

<script src="{{ 'filter-drawer.js' | asset_url }}" defer></script>
