{% doc %}
  Buy Buttons

  Renders the Buy Now (outline) + Add to Bag (solid) button pair used by both
  the desktop product-form and the mobile sticky bar. Must be rendered inside
  a <product-form> Web Component wrapping a <form data-product-form> — relies
  on that ancestor's variant:change subscriber for disabled/sold-out state.

  @param {object} product - Product object (required)
  @param {string} buy_now_label - Resolved "Buy Now" label (required)
  @param {string} add_to_bag_label - Resolved "Add to Bag" label (required)

  @example
  {% render 'buy-buttons', product: product, buy_now_label: buy_now_label, add_to_bag_label: add_to_bag_label %}
{% enddoc %}

{%- liquid
  assign product = product | default: blank

  unless product != blank
    break
  endunless

  assign selected_variant = product.selected_or_first_available_variant
  assign buy_button_base = 'flex h-12 flex-1 items-center justify-center font-plex-mono text-pdp-buy-button uppercase tracking-wide disabled:cursor-not-allowed disabled:opacity-50'
-%}

<button
  type="button"
  class="{{ buy_button_base }} border border-ink bg-transparent text-ink"
  data-buy-now
  {%- unless selected_variant.available %}
    disabled
  {% endunless -%}
>
  <span data-button-text data-available-label="{{ buy_now_label | escape }}">
    {%- if selected_variant.available == false -%}
      {{ 'products.sold_out' | t }}
    {%- else -%}
      {{ buy_now_label }}
    {%- endif -%}
  </span>
</button>
<button
  type="submit"
  name="add"
  class="{{ buy_button_base }} relative bg-ink text-surface"
  data-add-to-bag
  {%- unless selected_variant.available %}
    disabled
  {% endunless -%}
>
  <span data-button-text data-available-label="{{ add_to_bag_label | escape }}">
    {%- if selected_variant.available == false -%}
      {{ 'products.sold_out' | t }}
    {%- else -%}
      {{ add_to_bag_label }}
    {%- endif -%}
  </span>
  <span class="absolute inset-0 hidden items-center justify-center" data-button-loader>
    {%- render 'icon-spinner', size: 20 -%}
  </span>
</button>
