{% doc %}
  Mega Menu Banners

  Renders, in block order, every Nav Banner block that targets the given tab and
  category. Tab and category titles are compared case- and whitespace-insensitively.
  Renders nothing when no banner matches, so callers can capture the output and
  fall back to the tab's banners when a category has none of its own.

  @param {block[]} banner_blocks - section.blocks filtered to the nav-banner type
  @param {string} tab_title - Main menu tab title the banners belong to
  @param {string} [category_title] - Category link title; blank renders the tab's default banners

  @example
  {% render 'mega-menu-banners', banner_blocks: banner_blocks, tab_title: tab_link.title, category_title: category_link.title %}
{% enddoc %}

{%- liquid
  assign banners_tab_key = tab_title | strip | downcase
  assign banners_category_key = category_title | strip | downcase

  for banner_block in banner_blocks
    assign banner_block_tab_key = banner_block.settings.banner_tab | strip | downcase
    assign banner_block_category_key = banner_block.settings.banner_cat | strip | downcase

    if banner_block_tab_key == banners_tab_key and banner_block_category_key == banners_category_key
      render 'mega-menu-promo', promo_image: banner_block.settings.banner_img, promo_url: banner_block.settings.banner_url, promo_text: banner_block.settings.banner_text, promo_cta_pos: banner_block.settings.banner_cta_pos
    endif
  endfor
-%}
