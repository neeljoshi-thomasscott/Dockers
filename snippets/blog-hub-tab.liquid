{% doc %}
  Category tab link used in the blog hub tabs.

  @param {string} href - Tab link target (required)
  @param {string} label - Tab text (required)
  @param {boolean} [active] - Whether this tab is the current page (default false)

  @example
  {% render 'blog-hub-tab', href: blog.url, label: 'All Stories', active: true %}
{% enddoc %}

{%- if active -%}
  <a
    href="{{ href }}"
    class="blog-hub-tab shrink-0 whitespace-nowrap border border-ink bg-ink px-4 py-2 font-primary text-blog-tab font-medium text-surface"
    aria-current="page"
  >
    {{- label | escape -}}
  </a>
{%- else -%}
  <a
    href="{{ href }}"
    class="blog-hub-tab shrink-0 whitespace-nowrap border border-ink px-4 py-2 font-primary text-blog-tab text-ink"
  >
    {{- label | escape -}}
  </a>
{%- endif -%}
