{% doc %}
  Style With Card

  Renders a single "Style With" card on the PDP: a fixed-size image tile,
  title, price row, and a compact Add to Bag button reusing the shared
  add-to-cart-button snippet.

  @param {product} card_product - Product object (required)
  @param {string} [atc_label] - Add to Bag button text (default: "Add to Bag")

  @example
  {% render 'style-with-card', card_product: product, atc_label: 'Add to Bag' %}
{% enddoc %}

{%- liquid
  assign card_product = card_product | default: blank

  unless card_product != blank
    break
  endunless

  assign atc_label = atc_label | default: 'Add to Bag'
-%}

<div class="style-with-card group/card relative flex h-[180px] w-full border border-border transition-shadow duration-300 ease-out focus-within:shadow-style-with-card-hover motion-reduce:transition-none can-hover:hover:shadow-style-with-card-hover" data-style-with-card>
  <div class="h-full w-[120px] shrink-0 overflow-hidden bg-surface-soft">
    {%- if card_product.featured_image != blank -%}
      <img
        src="{{ card_product.featured_image | image_url: width: 240 }}"
        srcset="{{ card_product.featured_image | image_url: width: 120 }} 1x, {{ card_product.featured_image | image_url: width: 240 }} 2x"
        sizes="120px"
        loading="lazy"
        alt="{{ card_product.title | escape }}"
        width="120"
        height="178"
        class="h-full w-full object-cover transition-transform duration-300 ease-out motion-reduce:transition-none motion-safe:can-hover:group-hover/card:scale-style-with-card-image-hover"
      >
    {%- else -%}
      <div class="flex h-full w-full items-center justify-center text-muted">
        {%- render 'icon-cart', size: 32 -%}
      </div>
    {%- endif -%}
  </div>

  <div class="flex min-w-0 flex-1 flex-col justify-center gap-1 px-6">
    <a
      href="{{ card_product.url }}"
      class="truncate font-primary text-style-with-title text-ink after:absolute after:inset-0"
      data-style-with-card-title
    >
      {{ card_product.title }}
    </a>

    {%- render 'price-row',
      price: card_product.price,
      compare_at_price: card_product.compare_at_price,
      show_discount_label: true,
      size: 'pdp',
      price_class: 'text-style-with-price',
      discount_class: 'text-style-with-discount',
      gap_class: 'gap-1'
    -%}

    <div class="relative z-10 mt-2.5 w-[115px]">
      {%- render 'add-to-cart-button',
        product: card_product,
        button_text: atc_label,
        button_class: 'font-secondary !text-label !font-normal uppercase !rounded-none !py-0 !px-3 !h-[32px]'
      -%}
    </div>
  </div>
</div>
