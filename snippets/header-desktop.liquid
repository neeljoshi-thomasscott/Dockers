{% doc %}
  Desktop Header

  Renders the desktop header with logo, navigation, and action icons.
  Hidden on mobile (lg:flex).

  @param {string} main_menu - Handle of the top-level link_list (header_main_menu setting)
  @param {string} info_menu - Handle of the shared Group 3 link_list (header_info_menu setting), may be blank
  @param {block[]} blocks - section.blocks, passed to mega-menu-tab-state to decide which tabs open a flyout
{% enddoc %}

{%- liquid
  capture tab_state_list
    render 'mega-menu-tab-state', main_menu: main_menu, info_menu: info_menu, blocks: blocks
  endcapture
  assign tab_states = tab_state_list | strip | split: ','
-%}

<div class="menu-desktop hidden lg:flex items-center justify-between h-header-height-desktop px-5">
  <div class="flex items-center gap-20">
    <a
      href="{{ routes.root_url }}"
      aria-label="{{ shop.name | escape }} - Home"
    >
      {%- if settings.logo != blank -%}
        <img
          src="{{ settings.logo | image_url: width: 272 }}"
          alt="{{ shop.name | escape }}"
          width="136"
          height="40"
          loading="eager"
        >
      {%- else -%}
        <span class="font-primary text-xl font-normal tracking-tight">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <nav aria-label="Main navigation">
      {%- if linklists[main_menu].links.size > 0 -%}
        <ul class="flex items-center gap-6">
          {%- for tab_link in linklists[main_menu].links -%}
            {%- liquid
              assign tab_font_weight = 'font-medium'
              if tab_link.current
                assign tab_font_weight = 'font-bold'
              endif

              assign tab_state = tab_states[forloop.index0] | split: ':'
              assign tab_has_menu_content = false
              if tab_state[1] == 'true'
                assign tab_has_menu_content = true
              endif
            -%}
            <li>
              {%- comment -%}
                Full header height (not py-3) so the trigger's bottom edge meets the flyout's
                top edge — any gap between them lets mouseleave fire and close the menu.
              {%- endcomment -%}
              <a
                href="{{ tab_link.url }}"
                class="flex items-center h-header-height-desktop font-primary text-base {{ tab_font_weight }} leading-6 tracking-[-0.2px] text-foreground"
                {% if tab_has_menu_content %}
                  data-mega-menu-trigger="{{ forloop.index0 }}"
                  data-mega-menu-current="{{ tab_link.current }}"
                {% endif %}
              >
                {{ tab_link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>
  </div>

  <div class="flex items-center gap-2.5">
    <button
      type="button"
      class="w-12 h-12 flex items-center justify-center text-foreground"
      aria-label="Search"
      data-search-drawer-trigger
    >
      {% render 'icon-search', size: 24 %}
    </button>

    <a
      href="{{ routes.account_url }}"
      class="w-12 h-12 flex items-center justify-center text-foreground"
      aria-label="Account"
    >
      {% render 'icon-account', size: 24 %}
    </a>
{% comment %} flits support removed thrid party wishlist code from here {% endcomment %}
    {% comment %} <button
      type="button"
      class="w-12 h-12 flex items-center justify-center text-foreground"
      aria-label="Wishlist"
    >
      {% render 'icon-wishlist', size: 24 %}
    </button> {% endcomment %}
{% comment %} till here {% endcomment %}
    <a
      href="{{ routes.cart_url }}"
      class="relative w-12 h-12 flex items-center justify-center text-foreground"
      aria-label="Cart"
    >
      {% render 'icon-cart', size: 24 %}
      <cart-count
        class="absolute left-1/2 top-1/2 ml-0.5 -mt-[18px] h-4 min-w-4 items-center justify-center rounded-full bg-black px-1 text-[10px] font-medium leading-none text-white ring-1 ring-white {% if cart.item_count > 0 %}flex{% else %}hidden{% endif %}"
        aria-hidden="true"
      >
        {{- cart.item_count | at_most: 99 -}}
      </cart-count>
    </a>
  </div>
</div>
