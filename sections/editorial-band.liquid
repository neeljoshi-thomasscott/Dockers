<div
  class="editorial-band block pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  {%- if section.settings.title != blank or section.settings.subline != blank -%}
    <div class="editorial-band__title flex flex-col gap-editorial-title-gap-mobile pt-editorial-title-pad-mobile px-editorial-title-pad-mobile pb-editorial-title-pad-mobile text-right lg:gap-editorial-title-gap-desktop lg:pt-editorial-title-pad-top-desktop lg:px-editorial-title-pad-x-desktop lg:pb-editorial-title-pad-bottom-desktop">
      {%- if section.settings.title != blank -%}
        <div class="editorial-band__heading font-primary font-bold uppercase text-display-mobile lg:text-display [&_p]:m-0">
          {{ section.settings.title }}
        </div>
      {%- endif -%}
      {%- if section.settings.subline != blank -%}
        <p class="editorial-band__subline font-plex-mono uppercase text-right text-editorial-sub-mobile lg:text-editorial-sub">
          {{ section.settings.subline | escape }}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="editorial-band__row grid grid-cols-3 gap-editorial-row-col-gap gap-y-editorial-row-pad-top px-editorial-row-pad-x-mobile pt-editorial-row-pad-top lg:flex lg:flex-nowrap lg:gap-y-0 lg:px-editorial-row-pad-x-desktop">
      {%- assign editorial_skip_next = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'column' -%}
            {%- if editorial_skip_next -%}
              {%- assign editorial_skip_next = false -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign editorial_next_index = forloop.index0 | plus: 1 -%}
            {%- assign editorial_next_block = section.blocks[editorial_next_index] -%}

            {%- if editorial_next_block
                   and editorial_next_block.type == 'column'
                   and block.settings.label != blank
                   and editorial_next_block.settings.label == block.settings.label -%}
              {%- assign editorial_skip_next = true -%}
              {%- render 'editorial-band-paired-column', block: block, next_block: editorial_next_block -%}
            {%- else -%}
              {%- render 'editorial-band-column', block: block -%}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.view_all_link != blank -%}
    {%- render 'view-all-button',
      label: section.settings.view_all_label,
      url: section.settings.view_all_link,
      variant: 'light'
    -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Editorial Band",
  "class": "editorial-band-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline"
    },
    {
      "type": "header",
      "content": "View All"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Band"
    }
  ]
}
{% endschema %}
