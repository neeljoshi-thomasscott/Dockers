{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign badge_text = product.metafields.custom.badge_text | strip

  assign show_badge = false
  if badge_text != blank
    assign show_badge = true
  endif

  assign show_progress = false
  if product.media.size > 1
    assign show_progress = true
  endif
-%}
{%- comment -%}
  reviews.rating / reviews.rating_count is a namespace reserved to first-party
  review apps — a custom app can't write to it. Until a real reviews app is
  installed, custom.product_rating / custom.review_count hold manually
  entered placeholder data in the same shape.
  The rating metafield's .value is a Drop that renders correctly via string
  interpolation but isn't numeric to filters directly — capture its string
  form first, then coerce that to a real number.
{%- endcomment -%}
{%- capture rating_value_string -%}{{ product.metafields.custom.product_rating.value }}{%- endcapture -%}
{%- liquid
  assign rating_value = rating_value_string | times: 1.0
  assign review_count = product.metafields.custom.review_count.value | default: 0
  assign show_rating = false
  if rating_value > 0 and review_count > 0
    assign show_rating = true
  endif
  if show_rating
    assign rating_rounded = rating_value | round
  endif
-%}

<section
  class="product-section pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] md:pt-[var(--section-padding-top-desktop)] md:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
  data-product-id="{{ product.id }}"
  data-product-section
>
  <div class="mx-auto grid max-w-[1800px] gap-0 md:grid-cols-[2fr_1fr]" data-product-main>
    <div class="product-media min-w-0{% if product.media.size > 0 %} -mt-header-height-mobile lg:mt-0{% endif %}">
      {%- if product.media.size > 0 -%}
        <div class="hidden md:grid md:grid-cols-2" data-product-gallery-desktop>
          {%- for tile_media in product.media limit: 6 -%}
            <div
              class="product-gallery-desktop__tile relative aspect-[480/719] w-full overflow-hidden data-[active=true]:ring-2 data-[active=true]:ring-foreground"
              data-gallery-media-id="{{ tile_media.id }}"
              tabindex="-1"
            >
              {%- if forloop.index == 2 and show_badge -%}
                <span
                  class="absolute z-[1] flex h-pdp-gallery-badge-height items-center px-pdp-gallery-badge-pad-x text-pdp-gallery-badge font-normal bg-surface-20 text-surface top-6 right-6"
                  data-product-gallery-badge
                >
                  {{ badge_text }}
                </span>
              {%- endif -%}
              {%- case tile_media.media_type -%}
                {%- when 'image' -%}
                  <img
                    src="{{ tile_media | image_url: width: 480 }}"
                    srcset="{{ tile_media | image_url: width: 480 }} 1x, {{ tile_media | image_url: width: 960 }} 2x"
                    sizes="480px"
                    alt="{{ tile_media.alt | default: product.title | escape }}"
                    width="480"
                    height="719"
                    loading="lazy"
                    {%- if forloop.index == 1 %}
                      fetchpriority="high"
                    {%- endif %}
                    class="h-full w-full object-cover"
                  >
                {%- when 'video' -%}
                  <inline-video class="block h-full w-full">{{ tile_media | video_tag: autoplay: true, loop: true, controls: false, muted: true, image_size: "1080x", class: "h-full w-full object-cover" }}</inline-video>
                {%- when 'external_video' -%}
                  {{ tile_media | external_video_tag: class: 'h-full w-full object-cover' }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <product-gallery
        id="product-gallery-{{ product.id }}"
        class="product-gallery relative block w-full md:hidden"
        data-autoplay="false"
        data-loop="true"
      >
        <div class="relative aspect-[390/585] w-full overflow-hidden">
          {%- if show_badge -%}
            <span
              class="absolute z-[1] flex h-pdp-gallery-badge-height items-center px-pdp-gallery-badge-pad-x text-pdp-gallery-badge font-normal bg-surface-20 text-surface bottom-4 left-4"
              data-product-gallery-badge
            >
              {{ badge_text }}
            </span>
          {%- endif -%}
          <div class="product-gallery__viewport h-full w-full overflow-hidden" data-product-gallery-viewport>
            <div class="product-gallery__track flex h-full" data-product-gallery-track>
              {%- for media in product.media -%}
                <div
                  class="product-gallery__slide h-full w-full shrink-0 overflow-hidden"
                  data-gallery-media-id="{{ media.id }}"
                  tabindex="-1"
                >
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 390 }}"
                        srcset="{{ media | image_url: width: 390 }} 1x, {{ media | image_url: width: 780 }} 2x"
                        sizes="100vw"
                        alt="{{ media.alt | default: product.title | escape }}"
                        width="390"
                        height="585"
                        {%- if forloop.first %}
                          loading="eager"
                          fetchpriority="high"
                        {%- else %}
                          loading="lazy"
                        {%- endif %}
                        class="h-full w-full object-cover"
                      >
                    {%- when 'video' -%}
                      <inline-video class="block h-full w-full">{{ media | video_tag: autoplay: true, loop: true, controls: false, muted: true, image_size: "1080x", class: "h-full w-full object-cover" }}</inline-video>
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag: class: 'h-full w-full object-cover' }}
                  {%- endcase -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
        {%- if show_progress -%}
          <div class="product-gallery__progress-track h-[3px] w-full overflow-hidden bg-ink-10" data-product-gallery-progress-track>
            <div class="product-gallery__progress-thumb" data-product-gallery-progress-thumb></div>
          </div>
        {%- endif -%}
      </product-gallery>
    </div>

    {%- if section.settings.enable_full_screen_viewer and product.media.size > 0 -%}
      <image-viewer class="image-viewer" data-product-id="{{ product.id }}">
        <dialog class="image-viewer__dialog m-0 h-full max-h-none w-full max-w-none bg-background p-0" data-image-viewer-dialog aria-label="{{ 'products.image_viewer' | t }}">
          <button type="button" class="image-viewer__close fixed z-20 flex h-6 w-6 items-center justify-center bg-surface p-1 left-5 top-5 md:h-10 md:w-10 md:p-2" data-image-viewer-close aria-label="{{ 'general.close' | t }}">
            {%- render 'icon-close', size: 24, class: 'h-4 w-4 text-ink md:h-6 md:w-6' -%}
          </button>

          <div class="image-viewer__stack h-full w-full overflow-hidden md:snap-y md:snap-mandatory md:overflow-y-auto" data-image-viewer-stack>
            <div class="image-viewer__track flex h-full md:block md:h-auto" data-image-viewer-track>
            {%- for media in product.media -%}
              <div class="image-viewer__slide h-full w-full shrink-0 snap-start md:h-auto" data-image-viewer-slide data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <img
                      src="{{ media | image_url: width: 1440 }}"
                      srcset="{{ media | image_url: width: 750 }} 750w, {{ media | image_url: width: 1440 }} 1440w, {{ media | image_url: width: 2160 }} 2160w"
                      sizes="100vw"
                      alt="{{ media.alt | default: product.title | escape }}"
                      width="{{ media.width }}"
                      height="{{ media.height }}"
                      loading="lazy"
                      class="h-full w-full object-cover md:h-auto md:w-full md:object-contain"
                    >
                  {%- when 'video' -%}
                    <inline-video class="block h-full w-full">{{ media | video_tag: autoplay: true, loop: true, controls: false, muted: true, image_size: "1080x", class: "h-full w-full object-cover" }}</inline-video>
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'h-full w-full object-cover' }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
            </div>
          </div>

          <div class="image-viewer__rail fixed inset-x-0 bottom-0 z-10 flex h-[126px] w-full items-end gap-[2px] overflow-x-auto p-4 md:inset-x-auto md:inset-y-0 md:left-0 md:h-full md:w-image-viewer-rail-desktop md:flex-col md:items-start md:overflow-x-hidden md:overflow-y-auto md:p-image-viewer-rail-pad-desktop" data-image-viewer-thumbnails>
            {%- for media in product.media -%}
              {%- liquid
                case media.media_type
                  when 'video'
                    assign thumb_source = media.preview_image
                  when 'external_video'
                    assign thumb_source = media.preview_image
                  else
                    assign thumb_source = media
                endcase
              -%}
              <button
                type="button"
                class="image-viewer__thumbnail aspect-[40/58.57] w-10 shrink-0 border border-surface transition-[height,width] data-[active=true]:w-16 md:w-image-viewer-thumb-desktop md:first:mt-auto md:data-[active=true]:w-image-viewer-thumb-active-desktop"
                data-image-viewer-thumbnail
                data-media-id="{{ media.id }}"
                aria-label="{{ 'products.view_image' | t: index: forloop.index }}"
              >
                <img
                  src="{{ thumb_source | image_url: width: 64 }}"
                  srcset="{{ thumb_source | image_url: width: 64 }} 1x, {{ thumb_source | image_url: width: 128 }} 2x"
                  alt=""
                  width="64"
                  height="94"
                  loading="lazy"
                  class="h-full w-full object-cover"
                >
              </button>
            {%- endfor -%}
          </div>
        </dialog>
      </image-viewer>
    {%- endif -%}

    <div class="product-info min-w-0 px-4 md:px-5 md:sticky md:top-24 md:self-start">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title_price' -%}
            <div
              class="pdp-info-top flex flex-col gap-6 pt-pdp-info-pad-y-mobile pb-pdp-info-pad-y-mobile md:gap-0 md:pt-0 md:pb-0 md:px-pdp-info-pad-x-desktop"
              {{ block.shopify_attributes }}
            >
              <nav
                aria-label="breadcrumb"
                class="hidden flex-wrap items-center gap-x-3 gap-y-1 font-secondary text-crumb uppercase tracking-[0.02em] text-ink md:flex md:pt-3 md:pb-3"
                data-breadcrumb-origin-nav
              >
                {% render 'breadcrumb-trail', product: product %}
                {%- for origin_collection in product.collections -%}
                  <template data-breadcrumb-origin="{{ origin_collection.handle }}">
                    {%- render 'breadcrumb-trail', crumb_collection: origin_collection, product: product, show_structured_data: false -%}
                  </template>
                {%- endfor -%}
              </nav>

              {%- if show_rating -%}
                <div class="hidden items-center md:flex md:pt-4" data-pdp-rating>
                  <div class="flex items-center gap-rating-gap">
                    {%- for i in (1..5) -%}
                      {%- if i <= rating_rounded -%}
                        {%- render 'icon-star', size: 12, filled: true, class: 'text-ink' -%}
                      {%- else -%}
                        {%- render 'icon-star', size: 12, filled: false, class: 'text-muted' -%}
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  <span class="ml-1 text-pdp-rating-count text-ink">({{ review_count }})</span>
                </div>
              {%- endif -%}

              <div class="flex w-full items-center gap-pdp-badge-row-gap md:hidden" data-pdp-badge-row>
                {%- if show_rating -%}
                  <div class="flex h-pdp-badge-height flex-1 items-center justify-center gap-1 border border-border px-3" data-pdp-rating-button>
                    {%- render 'icon-star', size: 14, filled: true, class: 'text-ink' -%}
                    <span class="text-pdp-rating-count text-ink">{{ rating_rounded }} ({{ review_count }})</span>
                  </div>
                {%- endif -%}
                <button  
                  {% comment %} flits support removed thrid party wishlist code from here {% endcomment %}
                  style="display: none;" 
                  {% comment %} till here {% endcomment %}
                  type="button" class="flex h-pdp-badge-height flex-1 items-center justify-center border border-border px-3" data-wishlist-button aria-label="{{ 'products.wishlist' | t }}">
                  {%- render 'icon-wishlist', size: 18 -%}
                </button>
                <button
                  type="button"
                  class="relative flex h-pdp-badge-height flex-1 items-center justify-center border border-border px-3"
                  data-share-button
                  data-share-title="{{ product.title | escape }}"
                  aria-label="{{ 'general.share' | t }}"
                >
                  {%- render 'icon-share', size: 18 -%}
                  <span class="absolute right-0 top-full z-[1] mt-1 whitespace-nowrap bg-ink px-2 py-1 font-primary text-label text-surface" data-share-status role="status" hidden>
                    {{- 'general.link_copied' | t -}}
                  </span>
                </button>
              </div>

              <div class="flex flex-col gap-1 md:gap-2.5 md:pt-4 md:pb-4">
                <div class="flex items-start justify-between gap-2">
                  <h1 class="font-primary text-pdp-title-mobile text-ink md:text-pdp-title-desktop">{{ product.title }}</h1>
                  <button type="button"  
                    {% comment %} flits support removed thrid party wishlist code from here {% endcomment %}
                    style="display: none;" 
                    {% comment %} till here {% endcomment %}
                    class="hidden shrink-0 md:block" data-wishlist-button aria-label="{{ 'products.wishlist' | t }}">
                    {%- render 'icon-wishlist', size: 24 -%}
                  </button>
                </div>
                <div class="flex flex-col gap-0 md:gap-0.5">
                  {%- render 'price-row',
                    price: current_variant.price,
                    compare_at_price: current_variant.compare_at_price,
                    show_discount_label: true,
                    size: 'pdp',
                    gap_class: 'gap-1',
                    class: 'flex-wrap'
                  -%}
                  <p class="font-primary text-count tracking-normal text-ink">{{ block.settings.tax_note | default: 'Inclusive of all taxes' }}</p>
                </div>
              </div>
            </div>

          {%- when 'variant_selector' -%}
            {%- if product.has_only_default_variant == false -%}
              <div class="md:pt-4 md:pb-4 md:px-pdp-info-pad-x-desktop" {{ block.shopify_attributes }}>
                {% render 'variant-selector',
                  product: product,
                  model_note: product.metafields.custom.model_note
                %}
              </div>
            {%- endif -%}

          {%- when 'trust_builder' -%}
            {%- render 'trust-builder', block: block -%}

          {%- when 'buy_buttons' -%}
            {%- liquid
              assign default_buy_now_label = 'products.buy_now' | t
              assign default_add_to_bag_label = 'products.add_to_bag' | t
              assign buy_now_label = block.settings.buy_now_label | default: default_buy_now_label
              assign add_to_bag_label = block.settings.add_to_bag_label | default: default_add_to_bag_label
            -%}
            <div {{ block.shopify_attributes }}>
              {% render 'product-form', product: product, buy_now_label: buy_now_label, add_to_bag_label: add_to_bag_label %}
            </div>
            {%- if block.settings.show_sticky_bar -%}
              {% render 'sticky-buy-bar', product: product, buy_now_label: buy_now_label, add_to_bag_label: add_to_bag_label %}
            {%- endif -%}

          {%- when 'pincode' -%}
            <div class="flex flex-col gap-pdp-delivery-gap pt-pdp-delivery-pad-y pb-pdp-delivery-pad-y md:px-pdp-info-pad-x-desktop" {{ block.shopify_attributes }}>
              <label for="pincode-input-{{ product.id }}" class="font-primary text-control font-medium text-ink">{{ 'products.check_delivery_date' | t }}</label>
              <form class="flex" data-pincode-form>
                <input
                  type="text"
                  id="pincode-input-{{ product.id }}"
                  name="pincode"
                  placeholder="{{ 'products.enter_pincode' | t }}"
                  class="min-w-0 flex-1 bg-surface-alt px-4 py-3 font-primary text-nav text-ink placeholder:text-text-muted focus:outline-none"
                  data-pincode-input
                >
                <button type="submit" class="flex h-12 w-12 items-center justify-center bg-ink text-white" data-pincode-submit aria-label="{{ 'products.check_delivery_date' | t }}">
                  {% render 'icon-pincode-arrow', size: 24 %}
                </button>
              </form>
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              {%- assign description_heading = 'products.description' | t -%}
              {% render 'pdp-accordion',
                heading: description_heading,
                content: product.description,
                open_by_default: block.settings.open_by_default,
                padding_class: 'pt-6 md:mx-10',
                summary_padding_class: 'py-4',
                content_class: '',
                shopify_attributes: block.shopify_attributes
              %}
            {%- endif -%}

          {%- when 'fit' -%}
            {%- if product.metafields.custom.fit != blank -%}
              {%- assign fit_heading = 'products.fit' | t -%}
              {% render 'pdp-accordion',
                heading: fit_heading,
                content: product.metafields.custom.fit,
                open_by_default: block.settings.open_by_default,
                shopify_attributes: block.shopify_attributes
              %}
            {%- endif -%}

          {%- when 'materials_care' -%}
            {%- if product.metafields.custom.materials_care != blank -%}
              {%- assign materials_care_heading = 'products.materials_care' | t -%}
              {% render 'pdp-accordion',
                heading: materials_care_heading,
                content: product.metafields.custom.materials_care,
                open_by_default: block.settings.open_by_default,
                shopify_attributes: block.shopify_attributes
              %}
            {%- endif -%}

          {%- when 'details' -%}
            {%- if product.metafields.custom.details != blank -%}
              {%- assign details_heading = 'products.details' | t -%}
              {% render 'pdp-accordion',
                heading: details_heading,
                content: product.metafields.custom.details,
                open_by_default: block.settings.open_by_default,
                shopify_attributes: block.shopify_attributes
              %}
            {%- endif -%}

          {%- when 'collapsible' -%}
            {%- if block.settings.heading != blank -%}
              {% render 'pdp-accordion',
                heading: block.settings.heading,
                content: block.settings.content,
                border_class: '',
                padding_class: 'md:px-pdp-info-pad-x-desktop',
                content_class: '',
                shopify_attributes: block.shopify_attributes
              %}
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'product.js' | asset_url }}" defer></script>
<script src="{{ 'inline-video.js' | asset_url }}" defer></script>
<script src="{{ 'image-viewer.js' | asset_url }}" type="module" defer></script>
<script src="{{ 'breadcrumb-origin.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_full_screen_viewer",
      "label": "Enable Full Screen Viewer",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "title_price",
      "name": "Title & Price",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "tax_note",
          "label": "Tax Note",
          "default": "Inclusive of all taxes"
        }
      ]
    },
    {
      "type": "variant_selector",
      "name": "Variant selector",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "buy_now_label",
          "label": "Buy Now Label"
        },
        {
          "type": "text",
          "id": "add_to_bag_label",
          "label": "Add To Bag Label"
        },
        {
          "type": "checkbox",
          "id": "show_sticky_bar",
          "label": "Show Sticky Bar",
          "default": true
        }
      ]
    },
    {
      "type": "trust_builder",
      "name": "Trust Builder",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "trust_builder_text_1",
          "label": "Trust Builder Text 1",
          "default": "<p>FREE<br>DELIVERY</p>"
        },
        {
          "type": "richtext",
          "id": "trust_builder_text_2",
          "label": "Trust Builder Text 2",
          "default": "<p>COD<br>AVAILABLE</p>"
        },
        {
          "type": "richtext",
          "id": "trust_builder_text_3",
          "label": "Trust Builder Text 3",
          "default": "<p>7 DAYS<br>RETURNS</p>"
        }
      ]
    },
    {
      "type": "pincode",
      "name": "Pincode checker",
      "limit": 1
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": true
        }
      ]
    },
    {
      "type": "fit",
      "name": "Fit",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "materials_care",
      "name": "Materials & Care",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "details",
      "name": "Details",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping & Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "title_price" },
        { "type": "variant_selector" },
        { "type": "trust_builder" },
        { "type": "pincode" },
