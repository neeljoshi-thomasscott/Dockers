{%- liquid
  assign hub_tab_active_found = false
  for block in section.blocks
    if block.type == 'blog-hub-tab' and block.settings.hub_tab_blog.handle == blog.handle
      assign hub_tab_active_found = true
    endif
  endfor
-%}

<sticky-bar
  class="blog-hub-tabs bg-surface pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  <nav
    class="blog-hub-tabs__nav flex items-center gap-4 overflow-x-auto px-4 py-6 scrollbar-hide lg:justify-center lg:px-20"
    aria-label="{{ 'blog.categories' | t }}"
  >
    {%- liquid
      assign hub_all_label = section.settings.hub_all_label
      assign hub_all_url = section.settings.hub_all_blog.url | default: blog.url
      assign hub_all_active = false
      if hub_tab_active_found == false
        assign hub_all_active = true
      endif
      if hub_all_label != blank
        render 'blog-hub-tab', href: hub_all_url, label: hub_all_label, active: hub_all_active
      endif
    -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'blog-hub-tab' -%}
          {%- liquid
            assign tab_blog = block.settings.hub_tab_blog
            if tab_blog == blank or tab_blog.articles_count == 0
              continue
            endif
            assign tab_label = block.settings.hub_tab_label | default: tab_blog.title
            assign tab_active = false
            if tab_blog.handle == blog.handle
              assign tab_active = true
            endif
          -%}
          <span class="contents" {{ block.shopify_attributes }}>
            {%- render 'blog-hub-tab', href: tab_blog.url, label: tab_label, active: tab_active -%}
          </span>
      {%- endcase -%}
    {%- endfor -%}
  </nav>
</sticky-bar>

<script src="{{ 'sticky-bar.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Blog Hub Tabs",
  "class": "blog-hub-tabs-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "hub_all_label",
      "label": "Hub All Tab Label",
      "default": "All Stories"
    },
    {
      "type": "blog",
      "id": "hub_all_blog",
      "label": "Hub All Tab Blog",
      "info": "The blog the All tab links to. Defaults to the current blog"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "blog-hub-tab",
      "name": "Blog Hub Tab",
      "settings": [
        {
          "type": "blog",
          "id": "hub_tab_blog",
          "label": "Hub Tab Blog"
        },
        {
          "type": "text",
          "id": "hub_tab_label",
          "label": "Hub Tab Label",
          "info": "Defaults to the blog title"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Blog Hub Tabs"
    }
  ]
}
{% endschema %}
