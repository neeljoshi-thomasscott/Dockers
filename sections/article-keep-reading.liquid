{%- liquid
  if article == blank
    break
  endif

  assign keep_reading_limit = section.settings.keep_reading_limit
  assign keep_reading_count = 0
-%}
{%- capture keep_reading_items -%}
  {%- for keep_reading_item in blog.articles limit: 13 -%}
    {%- if keep_reading_item.id == article.id -%}
      {%- continue -%}
    {%- endif -%}
    {%- if keep_reading_count >= keep_reading_limit -%}
      {%- break -%}
    {%- endif -%}
    {%- assign keep_reading_count = keep_reading_count | plus: 1 -%}
    <li{% if keep_reading_count > 3 %} class="hidden md:block"{% endif %}>
      {%- render 'blog-article-card',
        card_article: keep_reading_item,
        category_label: blog.title,
        image_height: 'grid',
        lazy: true
      -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}
{%- liquid
  if keep_reading_count == 0
    break
  endif

  assign keep_reading_url = section.settings.keep_reading_link | default: blog.url
  assign keep_reading_heading = section.settings.keep_reading_heading
  assign keep_reading_link_label = section.settings.keep_reading_link_label
-%}

<div
  class="article-keep-reading flex flex-col gap-6 bg-surface px-5 lg:px-20 pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  <div class="article-keep-reading__header flex items-center justify-between">
    {%- if keep_reading_heading != blank -%}
      <h2 class="font-primary text-blog-heading-mobile font-bold text-navy lg:text-blog-title-desktop lg:text-ink">{{ keep_reading_heading | escape }}</h2>
    {%- endif -%}
    {%- if keep_reading_link_label != blank -%}
      <a href="{{ keep_reading_url }}" class="font-secondary text-blog-link-mobile text-ink lg:hidden">
        {{- keep_reading_link_label | escape -}}
      </a>
    {%- endif -%}
  </div>

  <ul class="article-keep-reading__list grid grid-cols-1 md:grid-cols-2 md:gap-6 lg:grid-cols-4" role="list">
    {{ keep_reading_items }}
  </ul>
</div>

{% schema %}
{
  "name": "Article Keep Reading",
  "class": "article-more-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "keep_reading_heading",
      "label": "Keep Reading Heading",
      "default": "Keep reading..."
    },
    {
      "type": "range",
      "id": "keep_reading_limit",
      "label": "Keep Reading Limit",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "keep_reading_link_label",
      "label": "Keep Reading Link Label",
      "default": "All Blogs"
    },
    {
      "type": "url",
      "id": "keep_reading_link",
      "label": "Keep Reading Link",
      "info": "Defaults to the article's blog"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Article Keep Reading"
    }
  ]
}
{% endschema %}
