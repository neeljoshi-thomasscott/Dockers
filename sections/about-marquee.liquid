{%- liquid
  assign marquee_separator_units = 14
  assign marquee_min_group_units = 300.0
  assign marquee_units_per_second = 12.0

  assign marquee_group_units = 0
  for block in section.blocks
    if block.settings.marquee_item_text != blank
      assign marquee_item_units = block.settings.marquee_item_text.size | plus: marquee_separator_units
      assign marquee_group_units = marquee_group_units | plus: marquee_item_units
    endif
  endfor

  if marquee_group_units > 0
    assign marquee_repeat_count = marquee_min_group_units | divided_by: marquee_group_units | ceil
    assign marquee_total_units = marquee_group_units | times: marquee_repeat_count
    assign marquee_duration = marquee_total_units | divided_by: marquee_units_per_second | round: 1
  endif

  assign marquee_overlap_class = ''
  if section.settings.marquee_overlap
    assign marquee_overlap_class = ' -mt-about-marquee-overlap-mobile md:mt-0'
  endif
-%}

{%- if marquee_group_units > 0 -%}
  <div class="about-marquee relative{{ marquee_overlap_class }} overflow-hidden py-about-marquee-pad-y-mobile font-plex-mono text-about-marquee-mobile uppercase text-surface bg-ink md:pt-about-marquee-pad-top-desktop md:pb-about-marquee-pad-bottom-desktop md:text-about-marquee-desktop">
    <div
      class="about-marquee__track flex w-max animate-about-marquee motion-reduce:animate-none"
      style="--about-marquee-duration: {{ marquee_duration }}s;"
    >
      {%- for marquee_copy in (1..2) -%}
        <ul
          class="about-marquee__group flex shrink-0 gap-about-marquee-gap-mobile pr-about-marquee-gap-mobile md:gap-about-marquee-gap-desktop md:pr-about-marquee-gap-desktop"
          role="list"
          {%- if marquee_copy == 2 %} aria-hidden="true"{%- endif %}
        >
          {%- for marquee_repeat in (1..marquee_repeat_count) -%}
            {%- liquid
              assign marquee_is_duplicate = true
              if marquee_copy == 1 and marquee_repeat == 1
                assign marquee_is_duplicate = false
              endif
            -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'marquee-item' -%}
                  {%- render 'marquee-item', block: block, is_duplicate: marquee_is_duplicate -%}
              {%- endcase -%}
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About Marquee",
  "class": "about-marquee-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "marquee_overlap",
      "label": "Marquee Overlap Above",
      "info": "Below 768px, pulls the marquee 15px up into the section above. Turn on only when About Since sits directly above.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "marquee-item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "marquee_item_text",
          "label": "Marquee Item Text",
          "default": "Comfort"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "About Marquee",
      "blocks": [
        {
          "type": "marquee-item",
          "settings": {
            "marquee_item_text": "Comfort"
          }
        },
        {
          "type": "marquee-item",
          "settings": {
            "marquee_item_text": "Confidence"
          }
        },
        {
          "type": "marquee-item",
          "settings": {
            "marquee_item_text": "Everyday style"
          }
        }
      ]
    }
  ]
}
{% endschema %}
