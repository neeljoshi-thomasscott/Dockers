{%- liquid
  assign about_classic_menswear_image = section.settings.classic_menswear_image
  assign about_classic_menswear_heading = section.settings.classic_menswear_heading
  assign about_classic_menswear_left = section.settings.classic_menswear_left
  assign about_classic_menswear_right = section.settings.classic_menswear_right

  if about_classic_menswear_image != blank
    assign about_classic_menswear_side_pad_class = 'lg:py-about-classic-menswear-side-pad-y-desktop'
    assign about_classic_menswear_media_class = ''
  else
    assign about_classic_menswear_side_pad_class = 'lg:py-about-section-pad-y'
    assign about_classic_menswear_media_class = ' flex items-center justify-center'
  endif

  assign about_classic_menswear_heading_class = 'w-full break-words text-center font-primary text-about-classic-menswear-heading-mobile font-bold text-ink bg-surface lg:w-auto lg:text-about-classic-menswear-heading-desktop'
  assign about_classic_menswear_text_class = 'px-page-gutter-mobile py-about-section-pad-y lg:row-start-1 lg:flex lg:flex-col lg:justify-center lg:px-about-classic-menswear-side-pad-x-desktop ' | append: about_classic_menswear_side_pad_class
  assign about_classic_menswear_body_class = 'font-primary text-about-classic-menswear-body-mobile font-normal text-about-body-ink [&_strong]:font-semibold [&_strong]:text-about-classic-menswear-strong-mobile [&_a]:underline lg:text-about-classic-menswear-body-desktop lg:text-ink-80 lg:[&_strong]:text-about-classic-menswear-strong-desktop'
-%}

{%- if about_classic_menswear_image != blank or about_classic_menswear_heading != blank or about_classic_menswear_left != blank or about_classic_menswear_right != blank -%}
  <div class="about-classic-menswear bg-surface">
    <div class="about-classic-menswear__row mx-auto flex max-w-about-classic-menswear flex-col lg:relative lg:grid lg:grid-cols-about-classic-menswear">
      {%- if about_classic_menswear_left != blank -%}
        <div class="about-classic-menswear__text about-classic-menswear__text--left lg:col-start-1 {{ about_classic_menswear_text_class }}">
          <div class="about-classic-menswear__body {{ about_classic_menswear_body_class }}">
            {{ about_classic_menswear_left }}
          </div>
        </div>
      {%- endif -%}

      {%- if about_classic_menswear_image != blank or about_classic_menswear_heading != blank -%}
        <div class="about-classic-menswear__media relative overflow-hidden lg:static lg:col-start-2 lg:row-start-1{{ about_classic_menswear_media_class }}">
          {%- if about_classic_menswear_image != blank -%}
            <div class="about-classic-menswear__frame relative h-full">
              <div class="about-classic-menswear__spacer aspect-about-classic-menswear-media" aria-hidden="true"></div>
              {%- render 'image',
                image: about_classic_menswear_image,
                alt: section.settings.classic_menswear_img_alt,
                class_name: 'absolute inset-0 block h-full w-full object-cover',
                responsive_widths: '0:780,1024:1080'
              -%}
            </div>

            {%- if about_classic_menswear_heading != blank -%}
              <div class="about-classic-menswear__heading-wrap absolute inset-x-0 bottom-0 flex justify-center pb-about-classic-menswear-heading-offset-mobile lg:pb-about-classic-menswear-heading-offset-desktop">
                <h2 class="about-classic-menswear__heading {{ about_classic_menswear_heading_class }}">
                  {{ about_classic_menswear_heading | escape }}
                </h2>
              </div>
            {%- endif -%}
          {%- else -%}
            <h2 class="about-classic-menswear__heading px-page-gutter-mobile {{ about_classic_menswear_heading_class }}">
              {{ about_classic_menswear_heading | escape }}
            </h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if about_classic_menswear_right != blank -%}
        <div class="about-classic-menswear__text about-classic-menswear__text--right lg:col-start-3 {{ about_classic_menswear_text_class }}">
          <div class="about-classic-menswear__body {{ about_classic_menswear_body_class }}">
            {{ about_classic_menswear_right }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About Classic Menswear",
  "class": "about-menswear-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "classic_menswear_image",
      "label": "Classic Menswear Image"
    },
    {
      "type": "text",
      "id": "classic_menswear_img_alt",
      "label": "Classic Menswear Img Alt",
      "info": "Leave blank to use the image's own alt text"
    },
    {
      "type": "text",
      "id": "classic_menswear_heading",
      "label": "Classic Menswear Heading",
      "default": "Classic Menswear With a Modern Twist"
    },
    {
      "type": "richtext",
      "id": "classic_menswear_left",
      "label": "Classic Menswear Left",
      "default": "<p>Dockers has spent almost <strong>forty years</strong> proving that <strong>comfort</strong> and <strong>tailoring</strong> were never actually enemies. The philosophy is simple to state and harder to execute: take the <strong>discipline of business-appropriate dressing</strong> and strip out everything that made it stiff.</p><p>In practice, that means flexible waistbands, fabrics that breathe, construction that resists wrinkles, and fits engineered around how men actually move rather than how a mannequin stands.</p>",
      "info": "Left column from 1024px up, above the image below 1024px"
    },
    {
      "type": "richtext",
      "id": "classic_menswear_right",
      "label": "Classic Menswear Right",
      "default": "<p>Nobody at Dockers is asking you to choose between looking sharp and <strong>feeling human</strong> by six in the evening. That balance, more than any single product, is what makes Dockers khaki pants and chinos for men different from something that only looks good in a fitting-room mirror.</p><p>It's a small distinction until you're <strong>twelve hours</strong> into a day that started with a commute and hasn't slowed down since. That's when a pant either does its job or it doesn't, and <strong>Dockers has spent decades</strong> making sure it does.</p>",
      "info": "Right column from 1024px up, below the image below 1024px"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "About Classic Menswear"
    }
  ]
}
{% endschema %}
