{%- comment -%}
  The toolbar and collection-listing sections render independently, so the
  toolbar resolves its own initial view the same way collection-listing does
  (template.suffix, same as collection-listing.liquid — no merchant-facing
  fallback setting, see that file for why) to show the correct icon on
  first paint. After that, collection-controller.js keeps the icon in sync
  client-side as the view changes.

  Resolved from template.suffix — Shopify's native alternate-template
  selector, set via ?view=X, which loads templates/collection.X.json — not
  a custom query param. A custom param isn't part of the cache key Shopify's
  server-side collection-page cache uses, so a toggle built on one silently
  stops updating past the first switch once that cache warms up; `view` is
  a param the platform itself depends on, so it's guaranteed to vary it.
{%- endcomment -%}
{%- liquid
  assign current_view = template.suffix | default: 'column'
  case current_view
    when 'column', 'grid', 'row'
    else
      assign current_view = 'column'
  endcase
-%}

{%- comment -%}
  /search has no `collection` object, so every collection.* reference below
  is aliased to its search.* equivalent.
{%- endcomment -%}
{%- liquid
  assign is_search_template = false
  if template.name == 'search'
    assign is_search_template = true
  endif

  if is_search_template
    assign working_filters = search.filters
    assign working_result_count = search.results_count
    capture search_relevant
      render 'search-relevant'
    endcapture
    if search_relevant contains 'false'
      assign working_result_count = 0
    endif
  else
    assign working_filters = collection.filters
    assign working_result_count = collection.products_count
  endif

  assign category_filter = working_filters | where: 'label', 'Category' | first

  assign category_pill_count = 0
  if category_filter
    for category_value in category_filter.values
      if category_value.active or category_value.count < working_result_count
        assign category_pill_count = category_pill_count | plus: 1
      endif
    endfor
  endif

  assign show_pill_row = false
  if category_pill_count > 0
    assign show_pill_row = true
  endif
  if is_search_template and working_result_count > 0
    assign show_pill_row = false
  endif

  assign pill_nav_link = nil
  assign is_pill_nav_leaf = false
  unless is_search_template
    assign pill_nav_menu_handle = section.settings.pill_nav_menu | default: 'men-categories'
    for nav_link in linklists[pill_nav_menu_handle].links
      if nav_link.type == 'collection_link' and nav_link.object.id == collection.id
        if nav_link.links.size > 0
          assign pill_nav_link = nav_link
        endif
        break
      endif
      for nav_child_link in nav_link.links
        if nav_child_link.type == 'collection_link' and nav_child_link.object.id == collection.id
          if nav_child_link.links.size > 0
            assign pill_nav_link = nav_child_link
          else
            assign is_pill_nav_leaf = true
          endif
          break
        endif
      endfor
      if pill_nav_link or is_pill_nav_leaf
        break
      endif
    endfor
  endunless

  if pill_nav_link
    assign show_pill_row = true
  elsif is_pill_nav_leaf
    assign show_pill_row = false
  endif

  # Mobile stacks the pill row above the controls, so its min height only
  # applies when the pill row renders. Desktop is one 64px row either way.
  assign toolbar_min_height_classes = 'md:min-h-toolbar-height-desktop'
  if show_pill_row
    assign toolbar_min_height_classes = 'min-h-toolbar-height-mobile md:min-h-toolbar-height-desktop'
  endif
-%}

{%- comment -%}
  Preserved-pill-query build — mirrors snippets/sort-overlay.liquid's
  preserved_sort_query capture, minus the category filter itself (its
  value is applied per-pill below, not carried forward as "active").
{%- endcomment -%}
{%- liquid
  assign current_view_param = template.suffix

  capture current_sort_by_param
    render 'get-url-param', param_name: 'sort_by'
  endcapture
  assign current_sort_by_param = current_sort_by_param | strip

  assign category_param_names = category_filter.values | map: 'param_name'

  capture preserved_pill_query
    if current_view_param != blank
      echo 'view=' | append: current_view_param | append: '&'
    endif
    if current_sort_by_param != blank
      echo 'sort_by=' | append: current_sort_by_param | append: '&'
    endif
    if is_search_template
      capture escaped_search_terms
        render 'search-terms-param'
      endcapture
      echo 'q=' | append: escaped_search_terms | append: '&'
      echo 'type=product&'
    endif
    for pill_filter in working_filters
      for pill_value in pill_filter.values
        unless category_param_names contains pill_value.param_name
          if pill_value.active
            assign escaped_pill_value = pill_value.value | url_param_escape
            echo pill_value.param_name | append: '=' | append: escaped_pill_value | append: '&'
          endif
        endunless
      endfor
    endfor
  endcapture
  assign preserved_pill_query = preserved_pill_query | strip

  if preserved_pill_query != blank
    assign preserved_pill_query_length = preserved_pill_query.size | minus: 1
    assign preserved_pill_query = preserved_pill_query | slice: 0, preserved_pill_query_length
  endif

  assign pill_base_url = collection.url
  if is_search_template
    assign pill_base_url = routes.search_url
  endif

  assign category_active_count = category_filter.values | where: 'active', true | size
  assign all_pill_active = true
  if category_active_count > 0
    assign all_pill_active = false
  endif

  assign all_pill_href = pill_base_url
  if preserved_pill_query != blank
    assign all_pill_href = all_pill_href | append: '?' | append: preserved_pill_query
  endif
-%}

{%- comment -%}
  data-overlay-open (set by sort-overlay / filter-drawer) lifts the bar above the header so their scrims cover it.
{%- endcomment -%}
<sticky-bar class="collection-toolbar__bar" data-collection-toolbar>
  <section
    class="collection-toolbar relative flex {{ toolbar_min_height_classes }} flex-col gap-toolbar-gap-mobile bg-background px-toolbar-pad-x-mobile pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] md:flex-row md:items-center md:justify-between md:gap-toolbar-gap-desktop md:px-toolbar-pad-x-desktop lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
    style="
      --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    "
  >
    {%- if show_pill_row -%}
      {%- assign all_pill_label = 'collections.pill_all_label' | t -%}
      <div class="collection-toolbar__pills flex items-center gap-pill-row-gap-mobile overflow-x-auto overscroll-x-contain touch-pan-x scrollbar-hide md:gap-pill-row-gap-desktop md:touch-auto" data-collection-toolbar-pills>
        {%- if pill_nav_link -%}
          {%- render 'tag-pill', href: collection.url, label: all_pill_label, active: true -%}
          {%- for nav_pill_link in pill_nav_link.links -%}
            {%- render 'tag-pill', href: nav_pill_link.url, label: nav_pill_link.title, active: false -%}
          {%- endfor -%}
        {%- else -%}
        {%- render 'tag-pill', href: all_pill_href, label: all_pill_label, active: all_pill_active -%}
        {%- for value in category_filter.values -%}
          {%- liquid
            if value.active == false and value.count >= working_result_count
              continue
            endif

            assign escaped_value_param = value.value | url_param_escape
            assign value_href = pill_base_url | append: '?'
            if preserved_pill_query != blank
              assign value_href = value_href | append: preserved_pill_query | append: '&'
            endif
            assign value_href = value_href | append: value.param_name | append: '=' | append: escaped_value_param
          -%}
          {%- render 'tag-pill', href: value_href, label: value.label, active: value.active -%}
        {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-toolbar__controls flex w-full items-center justify-between gap-control-cluster-gap md:w-auto md:justify-start md:ml-auto">
      {%- assign view_toggle_rendered = false -%}
      {%- if section.settings.show_view_toggle -%}
        <button
          type="button"
          data-view-toggle
          data-current-view="{{ current_view }}"
          aria-label="Change view (current: {{ current_view | capitalize }})"
        >
          {%- if section.settings.view_toggle_icon != blank -%}
            <img src="{{ section.settings.view_toggle_icon | image_url: width: 48 }}" width="24" height="24" alt="" loading="lazy">
          {%- else -%}
            {%- comment -%}
              `hidden` as a class, not the attribute — see updateViewToggle() in
              collection-controller.js.
            {%- endcomment -%}
            <svg data-view-icon="column" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="{% if current_view != 'column' %}hidden{% endif %}">
              <path d="M21 21H13L13 3H21V21ZM19 19V5L15 5L15 19H19ZM11 21H3L3 3H11L11 21ZM9 19V5H5L5 19H9Z" fill="currentColor"></path>
            </svg>
            <svg data-view-icon="grid" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="{% if current_view != 'grid' %}hidden{% endif %}">
              <path d="M3 11V3H11V11H3ZM3 21V13H11V21H3ZM13 11V3H21V11H13ZM13 21V13H21V21H13ZM5 9H9V5H5V9ZM15 9H19V5H15V9ZM15 19H19V15H15V19ZM5 19H9V15H5V19Z" fill="currentColor"></path>
            </svg>
            <svg data-view-icon="row" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="{% if current_view != 'row' %}hidden{% endif %}">
              <path d="M21 3L21 11L3 11L3 3L21 3ZM19 5L5 5V9L19 9L19 5ZM21 13V21L3 21V13L21 13ZM19 15L5 15V19H19V15Z" fill="currentColor"></path>
            </svg>
          {%- endif -%}
        </button>
        {%- assign view_toggle_rendered = true -%}
      {%- endif -%}

      {%- if section.settings.show_sort or section.settings.show_filter -%}
        <div class="flex items-center gap-5 md:gap-control-cluster-gap">
          {%- assign inner_rendered = false -%}
          {%- if section.settings.show_sort -%}
            {%- if view_toggle_rendered -%}
              <span class="hidden h-4 w-px bg-ink md:block" aria-hidden="true"></span>
            {%- endif -%}
            <button type="button" class="flex items-center gap-2" data-sort-trigger aria-label="Sort">
              <span class="text-control font-medium uppercase font-primary">Sort</span>
              {%- render 'icon-sort', size: 24 -%}
            </button>
            {%- assign inner_rendered = true -%}
          {%- endif -%}

          {%- if section.settings.show_filter -%}
            {%- if inner_rendered -%}
              <span class="h-4 w-px bg-ink" aria-hidden="true"></span>
            {%- elsif view_toggle_rendered -%}
              <span class="hidden h-4 w-px bg-ink md:block" aria-hidden="true"></span>
            {%- endif -%}
            <button type="button" class="flex items-center gap-2" data-filter-trigger aria-label="Filter">
              <span class="text-control font-medium uppercase font-primary">Filter</span>
              {%- render 'icon-filter', size: 24 -%}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- render 'sort-overlay', collection: collection -%}
  </section>
</sticky-bar>

<script src="{{ 'collection-toolbar.js' | asset_url }}" defer></script>
<script src="{{ 'sticky-bar.js' | asset_url }}" type="module"></script>

{%- render 'filter-drawer', collection: collection -%}

{% schema %}
{
  "name": "Collection Toolbar",
  "class": "collection-toolbar-section",
  "settings": [
    {
      "type": "header",
      "content": "Pills"
    },
    {
      "type": "link_list",
      "id": "pill_nav_menu",
      "label": "Pill Nav Menu",
      "info": "Collections with sub-items in this menu show them as pills; sub-items show no pills. Defaults to men-categories."
    },
    {
      "type": "header",
      "content": "View"
    },
    {
      "type": "checkbox",
      "id": "show_view_toggle",
      "label": "Show View Toggle",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "view_toggle_icon",
      "label": "View Toggle Icon"
    },
    {
      "type": "header",
      "content": "Sort"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "header",
      "content": "Filter"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show Filter",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 16,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collection Toolbar"
    }
  ]
}
{% endschema %}
