{%- liquid
  assign about_brand_history_image = section.settings.brand_history_image
  assign about_brand_history_heading = section.settings.brand_history_heading
  assign about_brand_history_body = section.settings.brand_history_body
  assign about_brand_history_body_mobile = section.settings.brand_history_body_mob | default: about_brand_history_body
  assign about_brand_history_img_side = section.settings.brand_history_img_side
  assign about_brand_history_bg = section.settings.brand_history_bg
  assign about_brand_history_head_color = section.settings.brand_history_head_color
  assign about_brand_history_body_color = section.settings.brand_history_body_color
  assign about_brand_history_head_desk = section.settings.brand_history_head_desk | default: about_brand_history_head_color
  assign about_brand_history_body_desk = section.settings.brand_history_body_desk | default: about_brand_history_body_color

  assign about_brand_history_side_class = ''
  if about_brand_history_img_side == 'right'
    assign about_brand_history_side_class = ' md:flex-row-reverse'
  endif

  if section.settings.brand_history_mob_size == '14'
    assign about_brand_history_mob_body_class = 'text-about-brand-history-body-mobile-14 [&_p+p]:mt-about-brand-history-para-gap-mobile-14'
  else
    assign about_brand_history_mob_body_class = 'text-about-brand-history-body-mobile [&_p+p]:mt-about-para-gap-mobile'
  endif

  capture about_brand_history_style
    if about_brand_history_bg != blank
      echo '--about-brand-history-bg: ' | append: about_brand_history_bg | append: ';'
    endif
    if about_brand_history_head_color != blank
      echo '--about-brand-history-head-mob: ' | append: about_brand_history_head_color | append: ';'
    endif
    if about_brand_history_head_desk != blank
      echo '--about-brand-history-head-desk: ' | append: about_brand_history_head_desk | append: ';'
    endif
    if about_brand_history_body_color != blank
      echo '--about-brand-history-body-mob: ' | append: about_brand_history_body_color | append: ';'
    endif
    if about_brand_history_body_desk != blank
      echo '--about-brand-history-body-desk: ' | append: about_brand_history_body_desk | append: ';'
    endif
  endcapture
-%}

{%- if about_brand_history_image != blank or about_brand_history_heading != blank or about_brand_history_body_mobile != blank -%}
  <div
    class="about-brand-history flex flex-col bg-about-brand-history-bg md:flex-row{{ about_brand_history_side_class }}{% if about_brand_history_image != blank %} md:min-h-about-section-min-height-desktop{% endif %}"
    {%- if about_brand_history_style != blank %} style="{{ about_brand_history_style }}"{%- endif -%}
  >
    {%- if about_brand_history_image != blank -%}
      <div class="about-brand-history__media relative w-full h-about-media-height-mobile overflow-hidden md:h-auto md:basis-1/2 md:shrink-0">
        {%- render 'image',
          image: about_brand_history_image,
          alt: section.settings.brand_history_img_alt,
          class_name: 'block h-full w-full object-cover md:absolute md:inset-0',
          responsive_widths: '0:780,768:1080'
        -%}
      </div>
    {%- endif -%}

    <div class="about-brand-history__content flex flex-col gap-about-brand-history-gap py-about-section-pad-y px-page-gutter-mobile md:grow md:basis-1/2 md:min-w-0 md:justify-between md:p-about-brand-history-pad-desktop">
      {%- if about_brand_history_heading != blank -%}
        <h2 class="about-brand-history__heading font-primary text-about-brand-history-heading-mobile font-bold text-about-brand-history-head-ink-mobile break-words md:text-about-brand-history-heading-desktop md:text-about-brand-history-head-ink-desktop">
          {{ about_brand_history_heading | escape }}
        </h2>
      {%- endif -%}

      {%- if about_brand_history_body_mobile != blank -%}
        <div class="about-brand-history__body about-brand-history__body--mobile font-primary {{ about_brand_history_mob_body_class }} font-normal text-about-brand-history-body-ink-mobile [&_a]:underline [&_strong]:font-medium md:hidden">
          {{ about_brand_history_body_mobile }}
        </div>
      {%- endif -%}

      {%- if about_brand_history_body != blank -%}
        <div class="about-brand-history__body about-brand-history__body--desktop hidden font-primary text-about-brand-history-body-desktop font-normal tracking-normal text-about-brand-history-body-ink-desktop [&_p+p]:mt-about-para-gap-desktop [&_a]:underline [&_strong]:font-medium md:block">
          {{ about_brand_history_body }}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About Brand History",
  "class": "about-history-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "brand_history_image",
      "label": "Brand History Image"
    },
    {
      "type": "text",
      "id": "brand_history_img_alt",
      "label": "Brand History Img Alt",
      "info": "Leave blank to use the image's own alt text"
    },
    {
      "type": "text",
      "id": "brand_history_heading",
      "label": "Brand History Heading",
      "default": "We Changed the Way America Dressed"
    },
    {
      "type": "richtext",
      "id": "brand_history_body",
      "label": "Brand History Body",
      "info": "Shown from 768px up",
      "default": "<p>In 1986, Dockers® introduced a new way to think about getting dressed.</p><p>We took the classic khaki and gave it a more relaxed, modern attitude—creating a bridge between the formality of traditional workwear and the ease of everyday clothing.</p><p>Then came Casual Fridays.</p><p>Dockers® helped bring a more casual approach to the workplace, encouraging people to leave the suit behind without leaving style behind.</p><p>Because we've always believed you shouldn't have to choose between looking good and feeling good.</p>"
    },
    {
      "type": "richtext",
      "id": "brand_history_body_mob",
      "label": "Brand History Mob Body",
      "info": "Shown below 768px. Leave blank to use Brand History Body.",
      "default": "<p>In 1986, Dockers® introduced a new way to think about getting dressed.</p><p>We took the classic khaki and gave it a more relaxed, modern attitude—creating a bridge between the formality of traditional workwear and the ease of everyday clothing.</p><p>Then came Casual Fridays. Dockers® helped bring a more casual approach to the workplace, encouraging people to leave the suit behind without leaving style behind.</p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "brand_history_img_side",
      "label": "Brand History Img Side",
      "info": "Image side from 768px up",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "brand_history_mob_size",
      "label": "Brand History Mob Size",
      "info": "Mobile body text size",
      "options": [
        { "value": "13", "label": "13px / 22px" },
        { "value": "14", "label": "14px / 20px" }
      ],
      "default": "13"
    },
    {
      "type": "color",
      "id": "brand_history_bg",
      "label": "Brand History Bg",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "brand_history_head_color",
      "label": "Brand History Head Color",
      "default": "#0F0F0F"
    },
    {
      "type": "color",
      "id": "brand_history_body_color",
      "label": "Brand History Body Color",
      "default": "#1E1F24"
    },
    {
      "type": "color",
      "id": "brand_history_head_desk",
      "label": "Brand History Head Desk",
      "info": "Heading color from 768px up. Leave blank to use Brand History Head Color."
    },
    {
      "type": "color",
      "id": "brand_history_body_desk",
      "label": "Brand History Body Desk",
      "info": "Body color from 768px up. Leave blank to use Brand History Body Color."
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "About Brand History"
    }
  ]
}
{% endschema %}
