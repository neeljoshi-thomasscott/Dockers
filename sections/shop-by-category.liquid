{%- liquid
  assign shop_category_background = section.settings.background
  assign shop_category_wrapper_bg = 'bg-surface'
  assign shop_category_heading_color = 'text-ink'
  if shop_category_background == 'dark'
    assign shop_category_wrapper_bg = 'bg-ink'
    assign shop_category_heading_color = 'text-surface'
  endif
-%}

<div
  class="shop-by-category block {{ shop_category_wrapper_bg }} pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  {%- if section.settings.heading != blank -%}
    <div class="shop-by-category__heading pt-shop-category-heading-pad-top-mobile px-shop-category-heading-pad-x-mobile pb-0 lg:pt-shop-category-heading-pad-top-desktop lg:px-shop-category-heading-pad-x-desktop">
      <h2 class="shop-by-category__heading-text font-primary font-bold uppercase text-left lg:text-center text-display-mobile {{ shop_category_heading_color }}">
        {%- assign shop_category_heading_break = ' <br class="lg:hidden">' -%}
        {{ section.settings.heading | escape | newline_to_br | replace: '<br />', shop_category_heading_break }}
      </h2>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="shop-by-category__row grid grid-cols-[repeat(4,minmax(0,76px))] justify-center gap-x-3 gap-y-4 py-shop-category-row-pad-y px-0 lg:grid-cols-shop-category-desktop lg:justify-center lg:gap-x-shop-category-tile-gap-x lg:gap-y-shop-category-tile-gap-y-desktop lg:px-shop-category-row-pad-x-desktop">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'tile' -%}
            {%- render 'shop-by-category-tile', block: block, variant: shop_category_background -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.view_all_link != blank -%}
    {%- render 'view-all-button',
      label: section.settings.view_all_label,
      url: section.settings.view_all_link,
      variant: shop_category_background
    -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Shop By Category",
  "class": "shop-by-category-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "dark"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "A line break applies on mobile only",
      "default": "Shop By Category"
    },
    {
      "type": "header",
      "content": "View All"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category"
    }
  ]
}
{% endschema %}
