{%- liquid
  assign article_hero_alt = article.image.alt | default: article.title
  assign article_products = article.metafields.custom.article_products.value
  assign article_collections = article.metafields.custom.article_collections.value

  assign article_products_pending = false
  if section.settings.article_show_products and article_products != blank
    assign article_products_pending = true
  endif

  assign article_collections_pending = false
  if section.settings.article_show_collections and article_collections != blank
    assign article_collections_pending = true
  endif

  assign article_products_at = article.metafields.custom.products_after.value | default: section.settings.article_products_after
  assign article_collections_at = article.metafields.custom.collections_after.value | default: section.settings.article_collections_after

  assign article_parts = article.content | split: '</p>'
  assign article_content_tail = article.content | strip | slice: -4, 4
  assign article_ends_with_paragraph = false
  if article_content_tail == '</p>'
    assign article_ends_with_paragraph = true
  endif
  assign article_container_tags = 'blockquote,ul,ol,table,div,figure' | split: ','

  assign article_wrapper_open = ''
  assign article_lead = article.content | split: '<p' | first | append: '|'
  assign article_lead_divs_opened = article_lead | split: '<div' | size | minus: 1
  assign article_lead_divs_closed = article_lead | split: '</div>' | size | minus: 1
  assign article_content_end = article.content | strip | slice: -6, 6
  if article_lead_divs_opened == 1 and article_lead_divs_closed == 0 and article_content_end == '</div>'
    assign article_wrapper_attributes = article_lead | split: '<div' | last | split: '>' | first
    assign article_wrapper_open = '<div' | append: article_wrapper_attributes | append: '>'
    assign article_div_depth = 0
    for article_part in article_parts
      if forloop.last
        break
      endif
      assign article_part_checked = article_part | append: '|'
      assign article_part_opened = article_part_checked | split: '<div' | size | minus: 1
      assign article_part_closed = article_part_checked | split: '</div>' | size | minus: 1
      assign article_div_depth = article_div_depth | plus: article_part_opened | minus: article_part_closed
      if article_div_depth < 1
        assign article_wrapper_open = ''
        break
      endif
    endfor
  endif

  assign article_text_class = 'article__content font-primary text-blog-body-mobile text-navy-80 lg:text-blog-body-desktop [&_p]:mb-4 lg:[&_p]:mb-5 [&_a]:font-semibold [&_a]:text-navy [&_a]:underline [&_a]:underline-offset-2 [&_strong]:font-semibold [&_strong]:text-navy [&_img]:my-6 [&_img]:h-auto [&_img]:max-w-full [&_hr]:my-8 [&_hr]:border-border'
  assign article_heading_class = '[&_h2]:mb-4 [&_h2]:mt-10 [&_h2]:font-bold [&_h2]:text-navy [&_h2]:text-article-h2-mobile lg:[&_h2]:mt-12 lg:[&_h2]:text-article-h2 [&_h3]:mb-2.5 [&_h3]:mt-7 [&_h3]:font-semibold [&_h3]:text-navy [&_h3]:text-article-h3-mobile lg:[&_h3]:text-article-h3 [&_h4]:mb-2 [&_h4]:mt-6 [&_h4]:font-semibold [&_h4]:text-navy'
  assign article_list_class = '[&_ul]:mb-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:mb-5 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:mb-2.5 [&_li]:pl-1 [&_li::marker]:font-bold [&_li::marker]:text-navy [&_blockquote]:my-6 [&_blockquote]:border-l-4 [&_blockquote]:border-navy [&_blockquote]:bg-surface-alt [&_blockquote]:px-5 [&_blockquote]:py-4'
  assign article_table_class = '[&_table]:my-6 [&_table]:w-full [&_table]:border-collapse max-lg:[&_table]:block max-lg:[&_table]:overflow-x-auto [&_th]:border [&_th]:border-border [&_th]:px-4 [&_th]:py-3 [&_th]:text-left [&_th]:align-top [&_th]:font-semibold [&_thead_th]:border-navy [&_thead_th]:bg-navy [&_thead_th]:text-surface [&_tbody_th]:bg-surface-alt [&_td]:border [&_td]:border-border [&_td]:px-4 [&_td]:py-3 [&_td]:text-left [&_td]:align-top'
  assign article_box_class = '[&_.dk-answer]:mb-6 [&_.dk-answer]:rounded [&_.dk-answer]:border-l-4 [&_.dk-answer]:border-navy [&_.dk-answer]:bg-surface-alt [&_.dk-answer]:p-5 [&_.dk-answer_p]:mb-0 [&_.dk-cta]:rounded-md [&_.dk-cta]:bg-surface-alt [&_.dk-cta]:p-6 [&_.dk-cta_p:last-child]:mb-0 [&_.dk-faq-item]:border-t [&_.dk-faq-item]:border-border [&_.dk-table-wrap]:my-6 [&_.dk-table-wrap]:overflow-x-auto [&_.dk-table-wrap_table]:my-0'
  assign article_body_class = article_text_class | append: ' ' | append: article_heading_class | append: ' ' | append: article_list_class | append: ' ' | append: article_table_class | append: ' ' | append: article_box_class
-%}

{%- capture article_products_html -%}
  {%- if article_products_pending -%}
    <ul class="article__products -mx-5 flex snap-x snap-mandatory overflow-x-auto scrollbar-hide lg:mx-0 lg:justify-center lg:gap-4" role="list">
      {%- for product in article_products limit: 4 -%}
        <li class="w-1/2 shrink-0 snap-start lg:w-auto lg:min-w-0 lg:flex-1 lg:max-w-blog-card-width-desktop">
          {%- render 'product-card',
            card_product: product,
            view: 'column',
            image_width: 320,
            lazy_load: true,
            show_discount_label: true
          -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
{%- endcapture -%}

{%- capture article_collections_html -%}
  {%- if article_collections_pending -%}
    <div class="article__collections flex flex-col gap-3 lg:gap-4">
      {%- if section.settings.article_collections_heading != blank -%}
        <h2 class="font-primary text-blog-body-mobile font-bold uppercase text-navy lg:text-center lg:text-blog-body-desktop">{{ section.settings.article_collections_heading | escape }}</h2>
      {%- endif -%}
      <ul class="-mx-5 flex gap-3 overflow-x-auto scrollbar-hide px-5 lg:mx-0 lg:flex-wrap lg:justify-center lg:gap-4 lg:px-0" role="list">
        {%- for article_collection in article_collections limit: 6 -%}
          <li class="w-36 shrink-0 lg:w-44">
            <a href="{{ article_collection.url }}" class="group flex flex-col gap-2 text-navy">
              <span class="block aspect-[3/4] w-full overflow-hidden bg-navy/5">
                {%- if article_collection.featured_image != blank -%}
                  {%- render 'image',
                    image: article_collection.featured_image,
                    alt: article_collection.title,
                    class_name: 'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105',
                    lazy: true,
                    base_width: 360,
                    mobile_width: 300
                  -%}
                {%- endif -%}
              </span>
              <span class="font-primary text-card-title font-bold uppercase underline-offset-4 group-hover:underline">{{ article_collection.title | escape }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
{%- endcapture -%}

<article
  class="article bg-surface pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  {%- if article.image != blank -%}
    <div class="article__hero h-article-hero-mobile w-full overflow-hidden lg:h-blog-banner">
      {%- render 'image',
        image: article.image,
        alt: article_hero_alt,
        class_name: 'h-full w-full object-cover',
        lazy: false,
        srcset_widths: '1440,2160,2880',
        mobile_srcset_widths: '750,1100,1500'
      -%}
    </div>
  {%- endif -%}

  <div class="article__body mx-auto flex max-w-article-body-width flex-col gap-3 p-5 lg:gap-8 lg:px-0 lg:py-10">
    <h1 class="text-center font-primary text-blog-heading-mobile font-bold text-navy lg:text-blog-display">{{ article.title | escape }}</h1>

    {%- liquid
      assign article_seen = ''
      assign article_buffer = ''

      for article_part in article_parts
        assign article_part_text = article_part | strip
        if article_part_text == blank
          continue
        endif
        if forloop.last and article_ends_with_paragraph == false
          assign article_buffer = article_buffer | append: article_part
          break
        endif

        assign article_chunk = article_part | append: '</p>'
        assign article_seen = article_seen | append: article_chunk
        assign article_buffer = article_buffer | append: article_chunk

        assign article_products_due = false
        if article_products_pending and forloop.index >= article_products_at
          assign article_products_due = true
        endif
        assign article_collections_due = false
        if article_collections_pending and forloop.index >= article_collections_at
          assign article_collections_due = true
        endif

        unless article_products_due or article_collections_due
          continue
        endunless

        assign article_open_containers = 0
        for container_tag in article_container_tags
          assign container_open_token = '<' | append: container_tag
          assign container_close_token = '</' | append: container_tag | append: '>'
          assign container_opened = article_seen | split: container_open_token | size | minus: 1
          assign container_closed = article_seen | split: container_close_token | size | minus: 1
          if container_tag == 'div' and article_wrapper_open != blank
            assign container_closed = container_closed | plus: 1
          endif
          if container_opened > container_closed
            assign article_open_containers = article_open_containers | plus: 1
          endif
        endfor
        if article_open_containers > 0
          continue
        endif

        if article_buffer != blank
          if article_wrapper_open != blank
            assign article_buffer = article_buffer | append: '</div>'
          endif
          echo '<div class="' | append: article_body_class | append: '">' | append: article_buffer | append: '</div>'
          assign article_buffer = article_wrapper_open
        endif
        if article_products_due
          echo article_products_html
          assign article_products_pending = false
        endif
        if article_collections_due
          echo article_collections_html
          assign article_collections_pending = false
        endif
      endfor

      if article_buffer != blank
        echo '<div class="' | append: article_body_class | append: '">' | append: article_buffer | append: '</div>'
      endif
      if article_products_pending
        echo article_products_html
      endif
      if article_collections_pending
        echo article_collections_html
      endif
    -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "class": "article-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "article_show_products",
      "label": "Article Show Products",
      "default": true,
      "info": "Products come from the article's Article Products metafield (up to 4)"
    },
    {
      "type": "range",
      "id": "article_products_after",
      "label": "Products After Paragraph",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 6,
      "info": "Used when the article's Products After Paragraph field is empty"
    },
    {
      "type": "checkbox",
      "id": "article_show_collections",
      "label": "Show Collections",
      "default": true,
      "info": "Collections come from the article's Article Collections metafield"
    },
    {
      "type": "text",
      "id": "article_collections_heading",
      "label": "Collections Heading"
    },
    {
      "type": "range",
      "id": "article_collections_after",
      "label": "Collections After Paragraph",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 12,
      "info": "Used when the article's Collections After Paragraph field is empty"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Article"
    }
  ]
}
{% endschema %}
