<section
  class="flex min-h-screen items-center justify-center bg-muted/5 px-4 pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  <div class="w-full max-w-md rounded-lg bg-background p-8 text-center shadow-lg">
    {%- if settings.logo -%}
      <img
        src="{{ settings.logo | image_url: width: 200 }}"
        alt="{{ shop.name }}"
        class="mx-auto mb-6"
        width="{{ settings.logo_width | default: 120 }}"
        height="{{ settings.logo_width | default: 120 | divided_by: settings.logo.aspect_ratio | round }}"
        loading="eager"
      >
    {%- else -%}
      <h1 class="mb-6 text-2xl font-bold">{{ shop.name }}</h1>
    {%- endif -%}

    <p class="mb-8 text-muted">{{ 'password.title' | t }}</p>

    {%- form 'storefront_password' -%}
      <div class="space-y-4">
        <input
          type="password"
          name="password"
          placeholder="{{ 'password.password' | t }}"
          class="w-full rounded border border-border px-4 py-3 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
          autocomplete="current-password"
        >
        <button
          type="submit"
          class="w-full rounded bg-primary px-6 py-3 text-sm font-medium text-primary-foreground transition-all duration-200 hover:shadow-md"
        >
          {{ 'password.enter' | t }}
        </button>
      </div>

      {%- if form.errors -%}
        <p class="mt-4 text-sm text-error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 16,
      "unit": "px"
    }
  ]
}
{% endschema %}
