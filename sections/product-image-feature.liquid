{%- comment -%} 1. CSS — Tailwind utilities only, no dedicated stylesheet {%- endcomment -%}

{%- comment -%} 2. HTML {%- endcomment -%}
{%- liquid
  assign feat_images = product.metafields.custom.image_feature.value
  assign feat_img_desk_count = section.settings.feat_img_desk_count | default: 2
  assign feat_img_mob_count = section.settings.feat_img_mob_count | default: 2
-%}

{%- if feat_images != blank -%}
  <div
    class="product-image-feature"
    style="
      --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    "
  >
    {%- comment -%} Desktop: images side by side {%- endcomment -%}
    {%- if feat_img_desk_count > 0 -%}
      <div class="product-image-feature__desktop hidden justify-center pt-[var(--section-padding-top-desktop)] pb-[var(--section-padding-bottom-desktop)] md:flex">
        {%- for feat_file in feat_images limit: feat_img_desk_count -%}
          {%- if feat_file.preview_image != blank -%}
            {%- assign feat_desk_alt = feat_file.preview_image.alt | default: product.title -%}
            {%- render 'image',
              image: feat_file.preview_image,
              alt: feat_desk_alt,
              width: 720,
              height: 720,
              class_name: 'w-full max-w-[720px] aspect-square object-cover shadow-[0_4px_16px_rgba(0,0,0,0.25)]',
              lazy: true
            -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Mobile: images stacked {%- endcomment -%}
    {%- if feat_img_mob_count > 0 -%}
      <div class="product-image-feature__mobile flex w-full flex-col pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] md:hidden">
        {%- for feat_file in feat_images limit: feat_img_mob_count -%}
          {%- if feat_file.preview_image != blank -%}
            {%- assign feat_mob_alt = feat_file.preview_image.alt | default: product.title -%}
            <div class="flex w-full justify-center bg-surface-soft">
              {%- render 'image',
                image: feat_file.preview_image,
                alt: feat_mob_alt,
                width: 390,
                height: 585,
                class_name: 'w-full aspect-[390/585] object-cover',
                lazy: true
              -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{%- comment -%} 3. JS — none, static image band {%- endcomment -%}

{%- comment -%} 4. Schema {%- endcomment -%}
{% schema %}
{
  "name": "Featured Image",
  "class": "featured-image-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads product.metafields.custom.image_feature (list.file_reference, provisional namespace/key pending store confirmation). Renders the first images side by side on desktop and stacked on mobile, up to the counts below. Renders nothing until the merchant populates this metafield."
    },
    {
      "type": "range",
      "id": "feat_img_desk_count",
      "label": "Feat Img Desk Count",
      "min": 0,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "feat_img_mob_count",
      "label": "Feat Img Mob Count",
      "min": 0,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Featured Image"
    }
  ]
}
{% endschema %}
