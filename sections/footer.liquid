<footer
  class="footer pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
  data-section-id="{{ section.id }}"
  data-footer
>
  {%- if section.blocks.size > 0 -%}
    <div class="footer__row flex flex-col md:flex-row md:justify-between">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'logo' -%}
            <div
              class="footer__logo hidden w-full px-5 pt-4 md:block md:flex-1 md:border-b md:border-r md:border-t md:border-ink"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                {% render 'image', image: block.settings.image, class_name: 'w-full h-auto', lazy: true %}
              {%- endif -%}
            </div>

          {%- when 'link_column' -%}
            {%- liquid
              assign menu = linklists[block.settings.menu]
              assign heading = block.settings.heading | default: menu.title

              assign extra_link = ''
              if heading == 'Client Services'
                assign extra_link = '<li><a href="/pages/rewards">Loyalty program</a></li>'
              endif

              capture content
                if menu != blank
                  echo '<ul class="flex flex-col gap-3 text-xs leading-4 tracking-[0.24px] text-ink">'
                  for link in menu.links
                    echo '<li><a href="'
                    echo link.url | escape
                    echo '">'
                    echo link.title | escape
                    echo '</a></li>'
                  endfor
                  echo extra_link      
                  echo '</ul>'
                elsif block.settings.links != blank
                  echo '<div class="footer__links text-xs leading-4 tracking-[0.24px] text-ink [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-3">'
                  if extra_link != blank
    assign extra_link_close = extra_link | append: '</ul>'
    echo block.settings.links | replace: '</ul>', extra_link_close
  else
                  echo block.settings.links
                  endif
                  echo '</div>'
                endif
              endcapture
            -%}
            <div
              class="w-full pt-0 md:flex-1 md:border-b md:border-r md:border-t md:border-ink md:pt-4"
              {{ block.shopify_attributes }}
            >
              {% render 'accordion',
                title: heading,
                content: content,
                unique_id: block.id,
                icon_type: 'chevron',
                static_from: '(min-width: 768px)',
                class_name: 'footer__column w-full pt-0 md:px-5 md:pt-0 md:[&_[data-accordion-content]]:!max-h-none md:[&_[data-accordion-icon]]:hidden md:[&_[data-accordion-trigger]]:cursor-default md:[&_[data-accordion-trigger]]:pointer-events-none',
                title_class: 'text-sm leading-5 tracking-[0.28px] border-t border-ink px-page-gutter-mobile py-4 text-ink md:border-t-0 md:px-0',
                content_class: 'px-page-gutter-mobile pb-4 md:px-0'
              %}
            </div>

          {%- when 'contact' -%}
            {%- liquid
              capture content
                echo '<div class="text-xs leading-4 tracking-[0.24px] text-ink [&_a]:underline [&>p:nth-child(n+3)]:mt-4">'
                if block.settings.body != blank
                  echo block.settings.body
                endif
                echo '</div>'
              endcapture
            -%}
            <div
              class="w-full pt-0 md:flex-1 md:border-b md:border-r md:border-t md:border-ink md:pt-4"
              {{ block.shopify_attributes }}
            >
              {% render 'accordion',
                title: block.settings.heading,
                content: content,
                unique_id: block.id,
                icon_type: 'chevron',
                static_from: '(min-width: 768px)',
                class_name: 'footer__column w-full pt-0 md:px-5 md:pt-0 md:[&_[data-accordion-content]]:!max-h-none md:[&_[data-accordion-icon]]:hidden md:[&_[data-accordion-trigger]]:cursor-default md:[&_[data-accordion-trigger]]:pointer-events-none',
                title_class: 'text-sm leading-5 tracking-[0.28px] border-t border-ink px-page-gutter-mobile py-4 text-ink md:border-t-0 md:px-0',
                content_class: 'px-page-gutter-mobile pb-4 md:px-0'
              %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="footer__bottom flex flex-col items-start justify-center border-t border-ink bg-ink/[0.12] px-page-gutter-mobile py-3.5 text-xs text-ink md:h-12 md:flex-row md:items-center md:border-t-0 md:px-page-gutter-desktop md:text-sm md:leading-5">
    {%- if section.settings.copyright_text != blank -%}
      {{ section.settings.copyright_text }}
    {%- endif -%}
  </div>
</footer>

<script src="{{ 'accordion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    {
      "type": "richtext",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "<p>&copy; 2026 Dockers</p>"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        }
      ]
    },
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading"
        },
        {
          "type": "richtext",
          "id": "links",
          "label": "Links",
          "info": "Bulleted list of links, e.g. a list with linked items. Used only when Menu below is blank."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Contact heading",
          "default": "Contact Us"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Contact body"
        }
      ]
    }
  ]
}
{% endschema %}
