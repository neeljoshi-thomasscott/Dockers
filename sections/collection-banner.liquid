{%- liquid
  assign banner_alt = section.settings.image_alt | default: section.settings.cta_label
  assign banner_eager = section.settings.eager_load
  assign banner_lazy = true
  if banner_eager
    assign banner_lazy = false
  endif
-%}
<section
  class="collection-banner relative block aspect-[2/3] pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] md:aspect-[9/5] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  style="
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  {%- case section.blocks.size -%}
    {%- when 0 -%}
      {%- liquid
        assign slide_image = section.settings.image
        assign slide_mobile_image = section.settings.mobile_image
        assign slide_alt = banner_alt
        assign slide_cta_position = section.settings.cta_position
        assign slide_cta_label = section.settings.cta_label
        assign slide_cta_link = section.settings.cta_link
        assign slide_cta_icon = section.settings.cta_icon
      -%}
      {%- render 'collection-banner-slide',
        image: slide_image,
        mobile_image: slide_mobile_image,
        alt: slide_alt,
        cta_position: slide_cta_position,
        cta_label: slide_cta_label,
        cta_link: slide_cta_link,
        cta_icon: slide_cta_icon,
        lazy: banner_lazy
      -%}
    {%- when 1 -%}
      {%- liquid
        assign slide_image = section.blocks.first.settings.slide_desk_image
        assign slide_mobile_image = section.blocks.first.settings.slide_mob_image
        assign slide_alt = section.blocks.first.settings.slide_alt | default: section.blocks.first.settings.slide_cta_label
        assign slide_cta_position = section.blocks.first.settings.slide_cta_pos
        assign slide_cta_label = section.blocks.first.settings.slide_cta_label
        assign slide_cta_link = section.blocks.first.settings.slide_cta_url
        assign slide_cta_icon = blank
      -%}
      {%- render 'collection-banner-slide',
        image: slide_image,
        mobile_image: slide_mobile_image,
        alt: slide_alt,
        cta_position: slide_cta_position,
        cta_label: slide_cta_label,
        cta_link: slide_cta_link,
        cta_icon: slide_cta_icon,
        lazy: banner_lazy
      -%}
    {%- else -%}
      <hero-banner-carousel
        class="collection-banner__carousel absolute inset-0 block h-full w-full"
        data-autoplay="{{ section.settings.banner_autoplay }}"
        data-autoplay-interval="{{ section.settings.banner_autoplay_interval }}"
      >
        <div class="collection-banner__carousel-viewport h-full w-full overflow-hidden" data-hero-carousel-viewport>
          <div class="collection-banner__carousel-track flex h-full" data-hero-carousel-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign slide_image = block.settings.slide_desk_image
                assign slide_mobile_image = block.settings.slide_mob_image
                assign slide_alt = block.settings.slide_alt | default: block.settings.slide_cta_label
                assign slide_cta_position = block.settings.slide_cta_pos
                assign slide_cta_label = block.settings.slide_cta_label
                assign slide_cta_link = block.settings.slide_cta_url
                assign slide_cta_icon = blank
                assign slide_lazy = true
                if forloop.first and section.settings.eager_load
                  assign slide_lazy = false
                endif
              -%}
              <div class="collection-banner__slide relative h-full w-full shrink-0 basis-full" {{ block.shopify_attributes }}>
                {%- render 'collection-banner-slide',
                  image: slide_image,
                  mobile_image: slide_mobile_image,
                  alt: slide_alt,
                  cta_position: slide_cta_position,
                  cta_label: slide_cta_label,
                  cta_link: slide_cta_link,
                  cta_icon: slide_cta_icon,
                  lazy: slide_lazy
                -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- if section.settings.banner_autoplay -%}
          <button
            type="button"
            class="collection-banner__toggle absolute bottom-banner-chrome-inset right-banner-chrome-inset flex h-banner-chrome-size w-banner-chrome-size items-center justify-center p-2.5 text-surface"
            data-hero-carousel-toggle
            aria-label="Pause autoplay"
            aria-pressed="false"
          >
            <span data-hero-carousel-icon-pause>{%- render 'icon-pause', class: 'size-banner-chrome-icon' -%}</span>
            <span data-hero-carousel-icon-play class="hidden">{%- render 'icon-play', class: 'size-banner-chrome-icon' -%}</span>
          </button>
        {%- endif -%}

        <div class="collection-banner__indicator absolute bottom-banner-dots-inset left-1/2 flex -translate-x-1/2 items-center gap-3" data-hero-carousel-indicator>
          {%- for block in section.blocks -%}
            <span class="collection-banner__dot relative h-1 w-1 bg-white/40" data-hero-carousel-dot>
              <span class="collection-banner__thumb pointer-events-none absolute inset-y-0 left-0 hidden h-full w-0 bg-white" data-hero-carousel-thumb></span>
            </span>
          {%- endfor -%}
        </div>
      </hero-banner-carousel>

      <script src="{{ 'hero-banner-carousel.js' | asset_url }}" type="module" defer></script>
  {%- endcase -%}
</section>

{% schema %}
{
  "name": "Collection Banner",
  "class": "collection-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Required. Falls back to the CTA label if left blank."
    },
    {
      "type": "select",
      "id": "cta_position",
      "label": "CTA position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-right", "label": "Top right" },
        { "value": "middle-left", "label": "Middle left" },
        { "value": "middle-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "middle-left"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "image_picker",
      "id": "cta_icon",
      "label": "CTA icon",
      "info": "Optional. Defaults to an arrow icon when left blank."
    },
    {
      "type": "checkbox",
      "id": "eager_load",
      "label": "Load eagerly",
      "info": "Use only for the first banner on the page.",
      "default": false
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "banner_autoplay",
      "label": "Enable Banner Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "banner_autoplay_interval",
      "label": "Banner Autoplay (Sec)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s",
      "visible_if": "{{ section.settings.banner_autoplay }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_desk_image",
          "label": "Slide Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "slide_mob_image",
          "label": "Slide Mobile Image"
        },
        {
          "type": "text",
          "id": "slide_alt",
          "label": "Slide Alt Text",
          "info": "Falls back to the CTA label if left blank."
        },
        {
          "type": "select",
          "id": "slide_cta_pos",
          "label": "Slide CTA Position",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-right", "label": "Bottom right" }
          ],
          "default": "middle-left"
        },
        {
          "type": "text",
          "id": "slide_cta_label",
          "label": "Slide CTA Label"
        },
        {
          "type": "url",
          "id": "slide_cta_url",
          "label": "Slide CTA URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
