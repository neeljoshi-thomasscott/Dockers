{%- liquid
  assign content_html = collection.description
  assign content_word_count = content_html | strip_html | split: ' ' | size
  assign content_is_long = false
  if content_word_count > section.settings.collapse_after_words
    assign content_is_long = true
  endif
  assign content_toggle_id = 'collection-content-toggle-' | append: section.id
-%}

{%- if content_html != blank -%}
  <section
    class="collection-content"
    style="
      --content-max-width: {{ section.settings.content_max_width }}px;
      --collapsed-height: {{ section.settings.collapsed_height }}px;
      --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
      --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --section-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
      --section-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    "
  >
    <div class="mx-auto max-w-[var(--content-max-width)] px-4 pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]">
      {%- if section.settings.heading != blank -%}
        <h2 class="mb-4 font-primary text-page-title-mobile font-bold text-ink md:text-page-title-desktop">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if content_is_long -%}
        <input type="checkbox" id="{{ content_toggle_id }}" class="peer sr-only">
      {%- endif -%}

      <div class="collection-content__body font-primary text-doc-body text-ink [&>*+*]:mt-4 [&_h2]:pt-4 [&_h2]:text-pdp-title-desktop [&_h2]:font-bold [&_h3]:pt-2 [&_h3]:text-pdp-title-mobile [&_h3]:font-bold [&_h4]:font-bold [&_strong]:font-bold [&_ul]:list-disc [&_ul]:pl-[1.5em] [&_ol]:list-decimal [&_ol]:pl-[1.5em] [&_li+li]:mt-2 [&_a]:underline [&_img]:h-auto [&_img]:max-w-full [&_table]:block [&_table]:w-full [&_table]:overflow-x-auto [&_table]:border-collapse [&_th]:border [&_th]:border-border [&_th]:bg-navy/5 [&_th]:px-3 [&_th]:py-2 [&_th]:text-left [&_th]:font-bold [&_td]:border [&_td]:border-border [&_td]:px-3 [&_td]:py-2 [&_td]:align-top{% if content_is_long %} max-h-[var(--collapsed-height)] overflow-hidden [mask-image:linear-gradient(to_bottom,#000_60%,transparent)] peer-checked:max-h-none peer-checked:[mask-image:none]{% endif %}">
        {{ content_html }}
      </div>

      {%- if content_is_long -%}
        <label
          for="{{ content_toggle_id }}"
          class="mt-4 inline-block cursor-pointer font-primary text-control font-bold text-ink underline peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-ink [&>span:last-child]:hidden peer-checked:[&>span:first-child]:hidden peer-checked:[&>span:last-child]:inline"
        >
          <span>{{ 'collections.read_more' | t }}</span>
          <span>{{ 'collections.read_less' | t }}</span>
        </label>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection Content",
  "class": "collection-content-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the collection's Description. Edit it in Products › Collections."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Max Width",
      "min": 640,
      "max": 1280,
      "step": 40,
      "default": 960,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Read More"
    },
    {
      "type": "range",
      "id": "collapse_after_words",
      "label": "Collapse After Words",
      "min": 50,
      "max": 500,
      "step": 25,
      "default": 150
    },
    {
      "type": "range",
      "id": "collapsed_height",
      "label": "Collapsed Height",
      "min": 120,
      "max": 600,
      "step": 20,
      "default": 240,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Collection Content"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
