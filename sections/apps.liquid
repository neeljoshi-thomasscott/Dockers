<div
  class="apps"
  style="
    --section-padding-top-mobile: {{ section.settings.apps_pad_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.apps_pad_bottom_mobile }}px;
    --section-padding-top-desktop: {{ section.settings.apps_pad_top_desktop }}px;
    --section-padding-bottom-desktop: {{ section.settings.apps_pad_bottom_desktop }}px;
  "
>
  <div
    class="{% if section.settings.apps_page_width %}page-width {% endif %}pt-[var(--section-padding-top-mobile)] pb-[var(--section-padding-bottom-mobile)] lg:pt-[var(--section-padding-top-desktop)] lg:pb-[var(--section-padding-bottom-desktop)]"
  >
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Apps",
  "class": "apps-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "apps_page_width",
      "label": "Apps Page Width",
      "default": false
    },
    {
      "type": "range",
      "id": "apps_pad_top_mobile",
      "label": "Apps Pad Top Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "apps_pad_bottom_mobile",
      "label": "Apps Pad Bottom Mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "apps_pad_top_desktop",
      "label": "Apps Pad Top Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "apps_pad_bottom_desktop",
      "label": "Apps Pad Bottom Desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Apps"
    }
  ]
}
{% endschema %}
