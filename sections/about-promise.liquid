{%- liquid
  assign about_promise_image = section.settings.promise_image
  assign about_promise_eyebrow = section.settings.promise_eyebrow
  assign about_promise_heading = section.settings.promise_heading
  assign about_promise_body = section.settings.promise_body
  assign about_promise_closing = section.settings.promise_closing
  assign about_promise_mob_pos = section.settings.promise_mob_pos

  assign about_promise_has_text = false
  if about_promise_eyebrow != blank or about_promise_heading != blank or about_promise_body != blank or about_promise_closing != blank
    assign about_promise_has_text = true
  endif

  capture about_promise_position_class
    render 'object-position-class', position: about_promise_mob_pos
  endcapture
  assign about_promise_media_class = 'block h-full w-full object-cover ' | append: about_promise_position_class | append: ' md:absolute md:inset-0 md:object-center'

  assign about_promise_layout_class = ''
  if about_promise_image != blank and about_promise_has_text
    assign about_promise_layout_class = ' md:grid-cols-2 md:min-h-about-section-min-height-desktop'
  elsif about_promise_image != blank
    assign about_promise_layout_class = ' md:min-h-about-section-min-height-desktop'
  endif
-%}

{%- if about_promise_image != blank or about_promise_has_text -%}
  <div class="about-promise flex flex-col bg-ink text-surface md:grid md:items-center md:gap-about-promise-gap-desktop md:p-about-promise-pad-desktop{{ about_promise_layout_class }}">
    {%- if about_promise_has_text -%}
      <div class="about-promise__content flex min-w-0 flex-col gap-about-promise-stack-gap-mobile px-page-gutter-mobile py-about-promise-pad-y-mobile md:gap-about-promise-stack-gap-desktop md:p-0">
        {%- if about_promise_eyebrow != blank -%}
          <p class="about-promise__eyebrow break-words font-plex-mono text-about-promise-eyebrow-mobile font-normal uppercase text-about-promise-eyebrow-ink md:text-about-promise-eyebrow-desktop">
            {{ about_promise_eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if about_promise_heading != blank -%}
          <h2 class="about-promise__heading break-words font-primary text-about-promise-heading-mobile font-bold text-surface md:text-about-promise-heading-desktop">
            {{ about_promise_heading | escape }}
          </h2>
        {%- endif -%}

        {%- if about_promise_body != blank -%}
          <div class="about-promise__body break-words font-primary text-about-promise-body-mobile font-normal text-about-promise-body-ink [&_p+p]:mt-about-para-gap-mobile [&_a]:underline [&_strong]:font-semibold md:text-about-promise-body-desktop md:[&_p+p]:mt-about-promise-para-gap-desktop">
            {{ about_promise_body }}
          </div>
        {%- endif -%}

        {%- if about_promise_closing != blank -%}
          <p class="about-promise__closing break-words font-primary text-about-promise-closing-mobile font-semibold text-surface md:text-about-promise-closing-desktop">
            {{ about_promise_closing | escape }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if about_promise_image != blank -%}
      <div class="about-promise__media relative order-first h-about-promise-media-height-mobile w-full overflow-hidden md:order-last md:h-auto md:self-stretch">
        {%- render 'image',
          image: about_promise_image,
          alt: section.settings.promise_img_alt,
          class_name: about_promise_media_class,
          responsive_widths: '0:780,768:1280'
        -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About Promise",
  "class": "about-promise-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "promise_image",
      "label": "Promise Image"
    },
    {
      "type": "text",
      "id": "promise_img_alt",
      "label": "Promise Img Alt",
      "info": "Leave blank to use the image's own alt text"
    },
    {
      "type": "select",
      "id": "promise_mob_pos",
      "label": "Promise Mob Pos",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center",
      "info": "Mobile image crop, below 768px"
    },
    {
      "type": "text",
      "id": "promise_eyebrow",
      "label": "Promise Eyebrow",
      "default": "The Dockers Promise"
    },
    {
      "type": "text",
      "id": "promise_heading",
      "label": "Promise Heading",
      "default": "There's really one idea behind everything Dockers has made for almost forty years: comfort and style were never supposed to compete."
    },
    {
      "type": "richtext",
      "id": "promise_body",
      "label": "Promise Body",
      "default": "<p>The brand didn't just join the business casual movement, it helped build it, and it's still redefining what everyday standards look like today. Not fast fashion. Decades of style, still evolving, still comfort-first. From the original khaki pant that helped invent business casual to the wardrobe essentials being made today, Dockers is still built around one goal: helping a man dress like he has somewhere to be, without spending his morning thinking about it.</p>"
    },
    {
      "type": "text",
      "id": "promise_closing",
      "label": "Promise Closing",
      "default": "This is Dockers. The art of dressing easy, one comfortable, versatile, unmistakably Dockers piece at a time."
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "About Promise"
    }
  ]
}
{% endschema %}
