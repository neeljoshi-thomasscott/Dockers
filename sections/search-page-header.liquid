{%- liquid
  assign search_page_header_empty = false
  capture search_relevant
    render 'search-relevant'
  endcapture
  if search.performed and search.results_count == 0 or search_relevant contains 'false'
    assign search_page_header_empty = true
  endif

  assign search_page_home_fallback = 'general.home' | t

  # min-height floor; content padding may grow it. The no-results band sits
  # below the breadcrumb, so its taller floor goes on the content, not the section.
  assign search_page_header_height = 'min-h-search-page-header-height-mobile md:min-h-search-page-header-height-desktop'
  assign search_page_content_classes = 'pb-search-page-header-pad-bottom'
  if search_page_header_empty
    assign search_page_header_height = ''
    assign search_page_content_classes = 'min-h-search-page-header-height-mobile-empty justify-center gap-search-page-header-message-gap-mobile pb-search-page-header-pad-bottom-empty-mobile md:min-h-search-page-header-height-desktop-empty md:gap-search-page-header-message-gap-desktop md:pb-search-page-header-pad-bottom-empty-desktop'
  endif
-%}

<section
  class="search-page-header flex flex-col {{ search_page_header_height }}"
  data-search-page-header
  {%- if search.performed and search.terms != blank %}
  data-search-terms="{{ search.terms | escape }}"
  {%- endif %}
>
  <nav
    aria-label="{{ 'accessibility.breadcrumb' | t }}"
    class="search-page-header__crumb-band flex h-crumb-band-height-mobile items-center gap-crumb-band-gap px-crumb-band-pad-x-mobile font-secondary text-crumb uppercase md:h-crumb-band-height-desktop md:px-crumb-band-pad-x-desktop"
  >
    <a href="{{ routes.root_url }}">{{ section.settings.breadcrumb_home_label | default: search_page_home_fallback }}</a>
    <span>/</span>
    <span aria-current="page">{{ 'search.title' | t }}</span>
  </nav>

  {%- if search.performed -%}
    <div class="search-page-header__content flex flex-col items-start px-search-section-pad-mobile pt-search-page-header-pad-top {{ search_page_content_classes }} text-left md:items-center md:px-search-section-pad-desktop md:text-center">
      <div class="flex max-w-full flex-col items-start md:items-center">
        {%- if section.settings.eyebrow_label != blank -%}
          <p class="font-secondary text-eyebrow-page-mobile uppercase md:text-eyebrow-page-desktop">{{ section.settings.eyebrow_label }}</p>
        {%- endif -%}

        <h1 class="max-w-full break-words font-primary text-page-title-mobile font-bold md:text-page-title-desktop">{{ search.terms | escape }}</h1>
      </div>

      {%- if search_page_header_empty and section.settings.no_results_message != blank -%}
        <div class="search-page-header__message font-primary text-message">{{ section.settings.no_results_message }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

<script src="{{ 'search-page-header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Search Page Header",
  "class": "search-page-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "text",
      "id": "breadcrumb_home_label",
      "label": "\"Home\" Label",
      "default": "Home"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow_label",
      "label": "Eyebrow Label",
      "default": "Search Result"
    },
    {
      "type": "richtext",
      "id": "no_results_message",
      "label": "No Results Message",
      "default": "<p>We couldn’t find any results. Try again using another word.</p>"
    }
  ],
  "presets": [
    {
      "name": "Search Page Header"
    }
  ]
}
{% endschema %}
