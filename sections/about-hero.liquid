{%- liquid
  assign about_hero_image = section.settings.hero_image
  assign about_hero_heading = section.settings.hero_heading
  assign about_hero_body = section.settings.hero_body

  if about_hero_image != blank
    assign about_hero_layout_class = ' md:min-h-about-section-min-height-desktop'
    assign about_hero_heading_class = 'absolute left-1/2 top-about-hero-heading-anchor-mobile -translate-x-1/2 -translate-y-full md:relative md:left-auto md:top-auto md:translate-x-0 md:translate-y-0'
  else
    assign about_hero_layout_class = ''
    assign about_hero_heading_class = 'relative self-center mt-about-hero-panel-pad md:mt-0 md:self-auto'
  endif
-%}

{%- if about_hero_image != blank or about_hero_heading != blank or about_hero_body != blank -%}
  <div class="about-hero relative flex flex-col bg-ink md:flex-row md:items-start md:gap-about-hero-gap-desktop md:pt-about-hero-pad-top-desktop md:px-about-hero-pad-x-desktop md:pb-about-hero-pad-bottom-desktop{{ about_hero_layout_class }}">
    {%- if about_hero_image != blank -%}
      <div class="about-hero__media relative w-full h-about-media-height-mobile overflow-hidden bg-ink md:absolute md:inset-0 md:h-auto">
        {%- render 'image',
          image: about_hero_image,
          mobile_image: section.settings.hero_mob_image,
          alt: section.settings.hero_img_alt,
          class_name: 'h-full w-full object-cover',
          lazy: false,
          responsive_widths: '0:780,768:1800,1440:2880'
        -%}
      </div>
    {%- endif -%}

    {%- if about_hero_heading != blank -%}
      <h1 class="about-hero__heading {{ about_hero_heading_class }} z-10 w-max max-w-about-hero-heading-max-mobile font-primary text-about-hero-heading-mobile font-bold text-center text-ink bg-surface break-words md:shrink md:basis-auto md:w-auto md:max-w-none md:min-w-0 md:text-about-hero-heading-desktop md:text-left">
        {{ about_hero_heading | escape }}
      </h1>
    {%- endif -%}

    {%- if about_hero_body != blank -%}
      <div class="about-hero__panel-col relative z-10 flex flex-col md:self-stretch md:justify-end md:grow md:shrink md:basis-about-hero-panel-basis-desktop md:min-w-0">
        <div class="about-hero__panel py-about-hero-panel-pad px-page-gutter-mobile font-primary text-about-hero-body-mobile tracking-normal text-surface-90 bg-ink [&_p+p]:mt-about-para-gap-mobile [&_a]:underline [&_strong]:font-bold md:p-about-hero-panel-pad md:text-about-hero-body-desktop md:text-surface md:bg-black md:[&_p+p]:mt-about-para-gap-desktop">
          {{ about_hero_body }}
        </div>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "About Hero",
  "class": "about-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "hero_mob_image",
      "label": "Hero Mobile Image",
      "info": "Optional. 1560 x 2340px (2:3)"
    },
    {
      "type": "text",
      "id": "hero_img_alt",
      "label": "Hero Img Alt",
      "info": "Leave blank to use the image's own alt text"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero Heading",
      "default": "Made for Real Life"
    },
    {
      "type": "richtext",
      "id": "hero_body",
      "label": "Hero Body",
      "default": "<p>Since 1986, Dockers® has been making clothes that make getting dressed easier.</p><p>Born in California and built around the iconic khaki, we believe great style doesn't need to be complicated. Our clothes are designed to move with you, keep you comfortable, and look good wherever the day takes you.</p><p>From workdays to weekends, first meetings to last-minute plans, Dockers® makes everyday style feel effortless.</p>"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "About Hero"
    }
  ]
}
{% endschema %}
