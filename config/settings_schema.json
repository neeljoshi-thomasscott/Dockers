[
  {
    "name": "theme_info",
    "theme_name": "themex",
    "theme_version": "1.0.0",
    "theme_author": "devx commerce",
    "theme_documentation_url": "https://devxcommerce.com",
    "theme_support_url": "https://devxcommerce.com/support"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "ibm_plex_sans_n4",
        "label": "Primary"
      },
      {
        "type": "font_picker",
        "id": "type_secondary_font",
        "default": "ibm_plex_mono_n4",
        "label": "Secondary"
      }
    ]
  },
  {
