      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Background alt",
        "default": "#F7F8F9",
        "info": "Sidebar backgrounds, card fills, alternating table rows"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#FFFFFF",
        "info": "Page background, card backgrounds, input backgrounds"
      },
      {
        "type": "color",
        "id": "color_primary_foreground",
        "label": "Primary button text",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Status Colors"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Error",
        "default": "#DC2626"
      },
      {
        "type": "color",
        "id": "color_error_wash",
        "label": "Error wash",
        "default": "#FEF2F2",
