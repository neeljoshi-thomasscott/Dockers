      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#16A34A"
      },
      {
        "type": "color",
        "id": "color_warning",
        "label": "Warning",
        "default": "#F97316",
        "info": "Warning states, pending badges, attention-required indicators"
