  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo_white",
        "label": "Logo (White)",
        "info": "Used on the PDP header while it overlays the hero image."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 120,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social Share Image",
        "info": "Shown when a page is shared on social media and has no image of its own (e.g. the homepage). 1200 × 628px recommended."
      }
    ]
  },
  {
    "name": "Product card",
    "settings": [
      {
        "type": "header",
        "content": "Pricing"
      },
      {
        "type": "checkbox",
        "id": "show_compare_price",
        "label": "Show MRP (slashed price)",
        "info": "Applies to product cards, product page and cart drawer.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_discount_percent",
        "label": "Show discount %",
        "info": "Applies to product cards, product page and cart drawer.",
        "default": true
      },
      {
        "type": "header",
        "content": "Discount Badge"
      },
      {
        "type": "checkbox",
        "id": "show_discount_badge",
        "label": "Show Discount Badge",
        "default": true
      },
      {
        "type": "color",
        "id": "discount_badge_bg_color",
        "label": "Discount Badge Background",
        "default": "#000"
      },
      {
        "type": "color",
        "id": "discount_badge_text_color",
        "label": "Discount Badge Text",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Sold Out Badge"
      },
      {
        "type": "checkbox",
        "id": "show_sold_out_badge",
        "label": "Show Sold Out Badge",
        "default": true
      },
      {
        "type": "text",
        "id": "sold_out_badge_text",
        "label": "Sold Out Badge Text",
        "default": "Sold out"
      },
      {
        "type": "color",
        "id": "sold_out_badge_bg_color",
        "label": "Sold Out Badge Background",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "sold_out_badge_text_color",
        "label": "Sold Out Badge Text Color",
        "default": "#FFFFFF"
      },
      {
        "type": "header",
        "content": "Quick Add"
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Low stock threshold",
        "info": "Show the \"Low in stock\" flag when a tracked variant has this many units left or fewer. Set to 0 to never show it.",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 30
      },
      {
        "type": "page",
        "id": "size_guide_page",
        "label": "Size guide page",
        "info": "Destination for the \"Size Guide\" link in the quick add size sheet. Falls back to the product page when empty."
      },
      {
        "type": "image_picker",
        "id": "size_guide_image_desktop",
        "label": "Size guide image (desktop)",
        "info": "Shown in the Size Guide modal body on desktop. Placeholder until the final size chart asset is provided."
      },
      {
        "type": "image_picker",
        "id": "size_guide_image_mobile",
        "label": "Size guide image (mobile)",
        "info": "Shown in the Size Guide modal body on mobile. Falls back to the desktop image when empty. Placeholder until the final size chart asset is provided."
      },
      {
        "type": "header",
        "content": "Color display"
      },
      {
        "type": "select",
        "id": "product_color_display",
        "label": "Color display mode",
        "options": [
          { "value": "hide", "label": "Hide" },
          { "value": "count", "label": "Count" },
          { "value": "swatch", "label": "Swatch" },
          { "value": "variant", "label": "Variant image" }
        ],
        "default": "swatch"
      }
    ]
  },
