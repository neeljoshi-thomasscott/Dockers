  {
    "name": "Urgency sale timer",
    "settings": [
      {
        "type": "paragraph",
        "content": "One schedule shared by the Urgency Sale Timer section, the announcement bar and the cart drawer."
      },
      {
        "type": "checkbox",
        "id": "sale_timer_enable",
        "label": "Enable sale timer",
        "default": true,
        "info": "Turns the timer on or off everywhere at once."
      },
      {
        "type": "text",
        "id": "sale_timer_start_date",
        "label": "Show from date (YYYY-MM-DD, e.g. 2026-10-14)",
        "placeholder": "YYYY-MM-DD",
        "info": "Optional. The timer stays hidden until then. Leave empty to show straight away."
      },
      {
        "type": "text",
        "id": "sale_timer_start_time",
        "label": "Show from time (HH:MM 24-hour, e.g. 00:00)",
        "placeholder": "HH:MM"
      },
      {
        "type": "text",
        "id": "sale_timer_end_date",
        "label": "Sale end date (YYYY-MM-DD, e.g. 2026-10-31)",
        "placeholder": "YYYY-MM-DD",
        "info": "When the whole sale ends; the timer hides after this. Leave empty to hide the timer everywhere. Dates and times use the store's time zone."
      },
      {
        "type": "text",
        "id": "sale_timer_end_time",
        "label": "Sale end time (HH:MM 24-hour, e.g. 23:59)",
        "placeholder": "HH:MM",
        "default": "23:59"
      },
      {
        "type": "select",
        "id": "sale_timer_on_expire",
        "label": "When the timer reaches zero",
        "options": [
          {
            "value": "hide",
            "label": "Hide the timer"
          },
          {
            "value": "message",
            "label": "Show an expired message"
          },
          {
            "value": "restart",
            "label": "Repeat countdown until the sale end date"
          }
        ],
        "default": "hide"
      },
      {
        "type": "text",
        "id": "sale_timer_expired_message",
        "label": "Expired message",
        "default": "This sale has ended. Check back soon!"
      },
      {
        "type": "range",
        "id": "sale_timer_restart_value",
        "label": "Countdown length (restart every)",
        "info": "With Repeat countdown, the timer counts down this long, then starts again, until the sale end date. Cycles start at the Show from time.",
        "min": 1,
        "max": 30,
        "step": 1,
        "default": 1
      },
      {
        "type": "select",
        "id": "sale_timer_restart_unit",
        "label": "Restart interval unit",
        "options": [
          {
            "value": "hours",
            "label": "Hours"
          },
          {
            "value": "days",
            "label": "Days"
          },
          {
            "value": "weeks",
            "label": "Weeks"
          }
        ],
        "default": "days"
      },
      {
        "type": "text",
        "id": "sale_timer_hours_label",
        "label": "Hours label",
        "default": "Hours"
      },
      {
        "type": "text",
        "id": "sale_timer_minutes_label",
        "label": "Minutes label",
        "default": "Minutes"
      },
      {
        "type": "text",
        "id": "sale_timer_seconds_label",
        "label": "Seconds label",
        "default": "Seconds"
      }
    ]
  },
  {
    "name": "Gokwik",
    "settings": [
      {
        "type": "text",
        "id": "mid",
        "label": "Merchant Id"
      },
      {
        "type": "header",
        "content": "Select environment"
      },
      {
        "type": "select",
        "id": "envType",
        "default": "production",
        "options": [
          {
            "value": "qa",
            "label": "QA"
          },
          {
            "value": "sandbox",
            "label": "Sandbox"
          },
          {
            "value": "production",
            "label": "Production"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "hideFlow",
        "label": "Button hide without disable",
        "info": "To hide only button without disable Gokwik flow",
        "default": false
      },
      {
        "type": "header",
        "content": "Data Tracking"
      },
      {
        "type": "text",
        "id": "ga4Gokwik",
        "label": "Enter Google Analytics ID (GA4)",
        "placeholder": "Starts with GA- ...."
      },
      {
        "type": "text",
        "id": "fbpixel",
        "label": "FB Pixel"
      },
      {
        "type": "text",
        "id": "snapPixel",
        "label": "Snapchat Pixel"
      },
      {
        "type": "text",
        "id": "gadsGokwik",
        "label": "Google Ads Conversion ID (AW-…)"
      },
      {
        "type": "header",
        "content": "Checkout Button"
      },
      {
        "type": "checkbox",
        "id": "goEnable",
        "label": "Enable Checkout Interception",
        "info": "GoKwik will intercept native checkout buttons automatically",
        "default": true
      },
      {
        "type": "text",
        "id": "checkoutSubText",
        "label": "Checkout Button Sub Text",
        "placeholder": "e.g. ₹100 Off on prepaid orders",
        "info": "Leave blank to hide sub text on checkout button"
      },
      {
        "type": "checkbox",
        "id": "checkoutEnableLogo",
        "label": "Show Payment Icons on Checkout Button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "checkoutEnableBanner",
        "label": "Show Checkout Sub Text as Banner (above button)",
        "default": false
      },
      {
        "type": "header",
        "content": "Buy Now Button"
      },
      {
        "type": "checkbox",
        "id": "goBuynowEnable",
        "label": "Enable Buy Now Interception",
        "info": "GoKwik will intercept native buy now buttons automatically",
        "default": true
      },
      {
        "type": "text",
        "id": "buyNowText",
        "label": "Buy Now Button Text",
        "default": "Buy It Now"
      },
      {
        "type": "text",
        "id": "buyNowSubText",
        "label": "Buy Now Button Sub Text",
        "placeholder": "e.g. ₹100 Off on prepaid orders",
        "info": "Leave blank to hide sub text on buy now button"
      },
      {
        "type": "checkbox",
        "id": "buyNowEnableLogo",
        "label": "Show Payment Icons on Buy Now Button",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "buyNowEnableBanner",
        "label": "Show Buy Now Sub Text as Banner (above button)",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "buyNowKeepThemeLabel",
        "label": "Keep theme Buy Now label",
        "info": "Shows the theme's own BUY NOW text instead of GoKwik's \"Buy Now with\" label and logo",
        "default": true
      },
      {
        "type": "header",
        "content": "Other Settings"
      },
      {
        "type": "checkbox",
        "id": "enableIntlFlow",
        "label": "Enable International Flow"
      }
    ]
  }
]
